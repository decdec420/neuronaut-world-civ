# Multi-LLM API Keys Configuration
# Copy this file to .env and add your actual API keys

# GROQ (https://console.groq.com) - 30/min, 14,400/day FREE
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (https://makersuite.google.com/app/apikey) - 15/min, 1,500/day FREE
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (https://huggingface.co/settings/tokens) - 30,000/month FREE
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Together AI (https://api.together.xyz) - $25 free credits
TOGETHER_API_KEY=your_together_key_here

# Ollama Settings (local, unlimited)
# Start Ollama with: ollama serve
# Download model: ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM Settings
# Use LLM for agent decisions? (true/false)
# Set to false to use rule-based psychology only
USE_LLM_DECISIONS=true

# How often should agents think long-term? (in ticks)
# Example: 100 = agents plan their goals every 100 ticks
LONG_TERM_PLANNING_INTERVAL=100

# How often should agents reflect on their life? (in ticks)
REFLECTION_INTERVAL=500

# ============================================================================
# SWARM INTELLIGENCE (v2.0) - Multi-Agent Coordination
# ============================================================================

# Enable swarm intelligence? (true/false)
# When enabled, agents coordinate decisions, form alliances, and make collective choices
ENABLE_SWARM_INTELLIGENCE=true

# Maximum number of agents that can coordinate in a swarm
# Higher = more emergent behavior but slower (recommended: 5-15)
MAX_SWARM_SIZE=10

# Consensus threshold for collective decisions (0.0 to 1.0)
# Example: 0.6 = 60% of agents must agree for consensus
CONSENSUS_THRESHOLD=0.6

# How close agents must be to coordinate (in tiles)
# Agents within this radius can see each other's intentions
COORDINATION_RADIUS=5.0

# Enable parallel LLM calls for faster swarm decisions? (true/false)
# true = faster but uses more API quota
# false = slower but more reliable
ENABLE_PARALLEL_LLM=true

# ============================================================================
# SEMANTIC LONG-TERM MEMORY (v2.0) - AI Agents That Truly Learn
# ============================================================================

# Enable semantic memory with vector embeddings? (true/false)
# When enabled, agents remember experiences and can search memories by meaning
ENABLE_SEMANTIC_MEMORY=true

# Embedding model for semantic search (HuggingFace model name)
# Default: all-MiniLM-L6-v2 (lightweight, 384 dimensions, runs locally)
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2 (better but slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Maximum memories to store per agent (default: 1000)
# Older, less important memories are automatically forgotten
MAX_MEMORIES_PER_AGENT=1000

# Where to persist memory database (default: ./data/memories)
# Set to empty string for in-memory only (memories lost on restart)
MEMORY_PERSIST_DIR=./data/memories

# Enable memory consolidation? (true/false)
# Frequently recalled memories become stronger and less likely to be forgotten
MEMORY_CONSOLIDATION_ENABLED=true

# Enable temporal decay? (true/false)
# Old memories naturally fade unless they're important or frequently recalled
MEMORY_TEMPORAL_DECAY=true
