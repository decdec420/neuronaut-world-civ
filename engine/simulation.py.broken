class InteractionHandler:
    """Handles interactions between agents"""

    def __init__(
        self,
        world: World,
        relationship_manager: RelationshipManager,
        economy: EconomicEngine,
        event_logger: EventLogger,
        knowledge_system=None,
        story_generator=None,
        story_feed=None,
        pathfinder=None,
        resource_memory=None
    ):
        self.world = world
        self.relationship_manager = relationship_manager
        self.economy = economy
        self.event_logger = event_logger
        self.knowledge_system = knowledge_system
        self.story_generator = story_generator
        self.story_feed = story_feed
        self.pathfinder = pathfinder
        self.resource_memory = resource_memory

    def handle_trade(
        self,
        agent: Agent,
        target_agent: Agent,
        current_tick: int
    ) -> Dict:
        """Handle trade between agents - with VALUE LEARNING and REPUTATION!"""
        # Check reputation first - agents won't trade with untrusted partners!
        if not agent.is_willing_to_trade_with(target_agent):
            return {
                'success': False,
                'reason': f'{agent.name} doesn\'t trust {target_agent.name} (poor reputation)',
                'emotional_impact': -0.05
            }

        if not target_agent.is_willing_to_trade_with(agent):
            return {
                'success': False,
                'reason': f'{target_agent.name} doesn\'t trust {agent.name} (poor reputation)',
                'emotional_impact': -0.05
            }

        # Simple trade: agent wants to buy something target has
        target_items = list(target_agent.inventory.items.keys())

        if not target_items:
            return {'success': False, 'reason': 'No items to trade'}

        # Pick random item
        item = random.choice(target_items)
        quantity = 1
        market_price = self.economy.market.get_market_price(item)

        # ===== VALUE LEARNING: PRICE NEGOTIATION =====
        # Buyer (agent) and seller (target_agent) negotiate based on learned values!

        # Get buyer's estimate and acceptable price
        buyer_estimate = agent.get_estimated_value(item, market_price)
        buyer_max_price = buyer_estimate * 1.3  # Willing to pay 30% over estimate

        # Get seller's estimate and acceptable price
        seller_estimate = target_agent.get_estimated_value(item, market_price)
        seller_min_price = seller_estimate * 0.7  # Willing to sell at 70% of estimate

        # Negotiate: meet in the middle if possible
        if buyer_max_price >= seller_min_price:
            # Trade possible! Use average of buyer max and seller min
            negotiated_price = (buyer_max_price + seller_min_price) / 2
        else:
            # No deal - price expectations don't overlap
            return {
                'success': False,
                'reason': f'Price disagreement: buyer offers {buyer_max_price:.1f}, seller wants {seller_min_price:.1f}',
                'emotional_impact': -0.05
            }

        # Attempt trade at negotiated price
        success, message = self.economy.execute_trade(
            agent, target_agent, item, quantity, negotiated_price
        )

        if success:
            # ===== LEARNING: Both agents learn from this trade! =====
            agent.learn_from_trade(item, negotiated_price, was_buyer=True)
            target_agent.learn_from_trade(item, negotiated_price, was_buyer=False)

            # ===== REPUTATION: Track trade fairness =====
            agent.update_reputation_after_trade(
                target_agent.id, negotiated_price, market_price, was_successful=True
            )
            target_agent.update_reputation_after_trade(
                agent.id, negotiated_price, market_price, was_successful=True
            )

            # Update relationship (positive interaction)
            self.relationship_manager.update_relationship(
                agent.id, target_agent.id, 'trade', positive=True
            )

            # Log event
            title, desc = EventGenerator.trade_completed(
                agent.name, target_agent.name, item, quantity, negotiated_price
            )
            self.event_logger.log_event(
                EventCategory.ECONOMIC,
                EventImportance.MINOR,
                title, desc,
                current_tick,
                [agent.id, target_agent.id]
            )

            # Satisfy needs
            agent.needs.satisfy_need(NeedType.RESOURCES, 0.2)

            return {
                'success': True,
                'emotional_impact': 0.3,
                'message': message
            }
        else:
            # ===== REPUTATION: Failed trade penalties =====
            agent.update_reputation_after_trade(
                target_agent.id, 0, market_price, was_successful=False
            )
            target_agent.update_reputation_after_trade(
                agent.id, 0, market_price, was_successful=False
            )

            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': message
            }

    def handle_socialize(
        self,
        agent: Agent,
        target_agent: Agent,
        current_tick: int
    ) -> Dict:
        """Handle social interaction"""
        # Check compatibility
        compatibility = agent.personality.compatibility_with(target_agent.personality)

        # Positive interaction if compatible
        if compatibility > 0.5:
            # Form or strengthen relationship
            self.relationship_manager.update_relationship(
                agent.id, target_agent.id, 'socialize', positive=True
            )

            # Check if new friendship forms
            existing_rel = self.relationship_manager.get_relationship(
                agent.id, target_agent.id
            )

            if existing_rel and existing_rel.relationship_type == RelationshipType.FRIENDSHIP:
                if existing_rel.strength > 0.6 and len(existing_rel.history) == 1:
                    # New friendship!
                    title, desc = EventGenerator.relationship_formed(
                        agent.name, target_agent.name, 'friendship'
                    )
                    self.event_logger.log_event(
                        EventCategory.SOCIAL,
                        EventImportance.MODERATE,
                        title, desc,
                        current_tick,
                        [agent.id, target_agent.id]
                    )

            # Satisfy social needs
            agent.needs.satisfy_need(NeedType.FRIENDSHIP, 0.3)
            agent.needs.satisfy_need(NeedType.BELONGING, 0.2)

            # Positive emotions
            agent.emotions.trigger_emotion(EmotionType.JOY, 0.2)

            # CULTURAL STORY CREATION - Agents tell stories during socialization!
            if self.story_generator and self.story_feed:
                # Creative agents are more likely to tell stories
                creativity = agent.personality.get_trait('openness')
                story_chance = creativity * 0.15  # Up to 15% chance for very creative agents

                if random.random() < story_chance:
                    current_day = current_tick // 144

                    # Choose story type based on agent state and personality
                    story_type = self._choose_story_type(agent)

                    # Create the story!
                    story = StoryGenerator.agent_creates_story(
                        agent.name,
                        {
                            'creativity': creativity,
                            'openness': agent.personality.get_trait('openness')
                        },
                        story_type,
                        current_day,
                        {'agent_id': agent.id}
                    )

                    self.story_feed.add_story(story)

            return {
                'success': True,
                'emotional_impact': 0.4,
                'message': 'Pleasant conversation'
            }
        else:
            # Negative interaction
            self.relationship_manager.update_relationship(
                agent.id, target_agent.id, 'socialize', positive=False
            )

            agent.emotions.trigger_emotion(EmotionType.SADNESS, 0.1)

            return {
                'success': False,
                'emotional_impact': -0.2,
                'message': 'Awkward interaction'
            }

    def handle_romance(
        self,
        agent: Agent,
        target_agent: Agent,
        current_tick: int
    ) -> Dict:
        """Handle romantic interaction"""
        # Check attraction
        from engine.psychology import PsychologyEngine

        attraction, rel_type = PsychologyEngine.relationship_attraction(
            agent.personality,
            target_agent.personality,
            agent.needs,
            target_agent.needs
        )

        if attraction > 0.6 and rel_type == 'romance':
            # Mutual attraction
            self.relationship_manager.update_relationship(
                agent.id, target_agent.id, 'romance', positive=True
            )

            # Check if romance forms
            existing_rel = self.relationship_manager.get_relationship(
                agent.id, target_agent.id
            )

            if existing_rel and existing_rel.relationship_type == RelationshipType.ROMANCE:
                if existing_rel.strength > 0.7:
                    # Romance blossoms!
                    title, desc = EventGenerator.relationship_formed(
                        agent.name, target_agent.name, 'romance'
                    )
                    self.event_logger.log_event(
                        EventCategory.SOCIAL,
                        EventImportance.MAJOR,
                        title, desc,
                        current_tick,
                        [agent.id, target_agent.id]
                    )

            # Satisfy needs
            agent.needs.satisfy_need(NeedType.SEX, 0.5)
            agent.needs.satisfy_need(NeedType.ROMANCE, 0.6)

            # Positive emotions
            agent.emotions.trigger_emotion(EmotionType.LOVE, 0.4)
            agent.emotions.trigger_emotion(EmotionType.LUST, 0.3)
            agent.emotions.trigger_emotion(EmotionType.JOY, 0.3)

            # ===== PREGNANCY CHANCE =====
            # Check if one is female and not already pregnant
            female_agent = agent if agent.gender.value == 'female' else target_agent if target_agent.gender.value == 'female' else None
            male_agent = agent if agent.gender.value == 'male' else target_agent if target_agent.gender.value == 'male' else None

            if female_agent and male_agent and not female_agent.is_pregnant:
                # Pregnancy chance based on attraction and age
                base_chance = 0.15  # 15% base chance
                age_factor = 1.0 if 18 <= female_agent.age <= 40 else 0.3  # Reduced fertility outside prime years
                pregnancy_chance = base_chance * age_factor * attraction

                if random.random() < pregnancy_chance:
                    # PREGNANCY!
                    female_agent.is_pregnant = True
                    female_agent.pregnancy_partner_id = male_agent.id
                    female_agent.pregnancy_start_tick = current_tick
                    logger.info(f"👶 {female_agent.name} is PREGNANT! Father: {male_agent.name}")

            return {
                'success': True,
                'emotional_impact': 0.8,
                'message': 'Romance flourishes',
                'reproduction_attempted': True  # Signal for reproduction attempt
            }
        else:
            # Rejection
            agent.emotions.trigger_emotion(EmotionType.SADNESS, 0.3)
            agent.emotions.trigger_emotion(EmotionType.SHAME, 0.2)

            return {
                'success': False,
                'emotional_impact': -0.5,
                'message': 'Romantic advance rejected'
            }

    def handle_gather_food(
        self,
        agent: Agent,
        target_position: Position,
        current_tick: int
    ) -> Dict:
        """Handle food gathering with intelligent pathfinding"""
        # Check if agent remembers a food location
        memory = self.resource_memory.recall_resource(
            agent.id,
            'food',
            current_tick,
            max_age=500  # Remember for 500 ticks
        )

        # Find food resource (use memory if available, otherwise search)
        if memory:
            # Try to navigate to remembered location
            target_x, target_y = memory['x'], memory['y']
            distance = agent.location.distance_to(Position(target_x, target_y))

            # If close enough, try to harvest
            if distance < 2.0:
                resource = self.world.find_nearest_resource(
                    agent.location,
                    ResourceType.FOOD
                )
            else:
                # Navigate toward remembered location
                next_step = self.pathfinder.get_next_step(
                    agent.location.x, agent.location.y,
                    target_x, target_y
                )
                if next_step:
                    agent.location = Position(next_step[0], next_step[1])

                return {
                    'success': True,
                    'emotional_impact': 0.05,
                    'message': f'Navigating to food source (distance: {distance:.1f})'
                }
        else:
            # Search for food
            resource = self.world.find_nearest_resource(
                agent.location,
                ResourceType.FOOD
            )

        if not resource or resource.quantity <= 0:
            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': 'No food found'
            }

        # Check distance to resource
        distance = agent.location.distance_to(resource.location)

        # If too far, navigate closer
        if distance > 3.0:
            next_step = self.pathfinder.get_next_step(
                agent.location.x, agent.location.y,
                resource.location.x, resource.location.y
            )

            if next_step:
                agent.location = Position(next_step[0], next_step[1])
                # Remember this resource location
                self.resource_memory.remember_resource(
                    agent.id,
                    'food',
                    resource.location.x,
                    resource.location.y,
                    resource.quantity,
                    current_tick
                )

                return {
                    'success': True,
                    'emotional_impact': 0.05,
                    'message': f'Moving toward food (distance: {distance:.1f})'
                }

        # Close enough to harvest!
        # Harvest food - INCREASED YIELD for survival!
        amount = self.world.harvest_resource(resource.id, 12.0)  # Was 5.0, now 12.0

        if amount > 0:
            # Add to inventory
            agent.inventory.add_item('food', int(amount))

            # Immediately eat to survive - satisfy hunger MORE
            agent.needs.satisfy_need(NeedType.HUNGER, amount / 8.0)  # Was /10, now /8 - more satisfying
            # Restore energy from eating
            agent.energy = min(100.0, agent.energy + 8.0)  # Was +5, now +8

            # Remember this successful location
            self.resource_memory.remember_resource(
                agent.id,
                'food',
                resource.location.x,
                resource.location.y,
                resource.quantity,
                current_tick
            )

            return {
                'success': True,
                'emotional_impact': 0.2,
                'message': f'Gathered {amount:.1f} food'
            }
        else:
            # Resource depleted, forget this location
            self.resource_memory.forget_resource(
                agent.id,
                resource.location.x,
                resource.location.y
            )

            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': 'Failed to gather food'
            }

    def handle_gather_materials(
        self,
        agent: Agent,
        current_tick: int
    ) -> Dict:
        """
        Handle gathering building materials (stone, wood, clay, metal_ore, etc.)

        This is CRITICAL for civilization building!
        Agents need materials to:
        - Build structures
        - Experiment with new materials
        - Trade with others
        """
        # Determine what material to gather based on availability and need
        # Priority: stone > wood > clay > metal_ore (if unlocked)
        material_priority = ['stone', 'wood', 'clay', 'plant_fiber', 'metal_ore', 'iron_ore']

        gathered_material = None
        gathered_amount = 0

        for material_name in material_priority:
            # TOOL REQUIREMENT CHECKS
            # Advanced materials require proper tools!
            if material_name in ['metal_ore', 'iron_ore']:
                # Mining requires at least stone tools
                if not agent.inventory.has_item('stone'):
                    continue  # Skip this material, need tools!

            # Check if material is available in world resource pools
            available = self.world.resource_pools.get(material_name, 0)

            if available > 10:  # Only gather if there's enough
                # Base gathering amount - INCREASED for faster progress!
                base_amount = random.uniform(8.0, 15.0)  # Was 3.0-8.0, now 8.0-15.0

                # TOOL EFFICIENCY BONUSES
                efficiency_multiplier = 1.0
                if material_name == 'wood' and agent.inventory.has_item('stone'):
                    efficiency_multiplier = 1.5  # Stone axe helps
                elif material_name == 'stone' and agent.inventory.has_item('wood'):
                    efficiency_multiplier = 1.3  # Wooden handle helps
                elif material_name in ['metal_ore', 'iron_ore'] and agent.inventory.has_item('stone'):
                    efficiency_multiplier = 1.4  # Stone pickaxe

                amount_to_gather = base_amount * efficiency_multiplier
                actual_amount = self.world.harvest_from_pool(material_name, amount_to_gather)

                if actual_amount > 0:
                    # Add to inventory
                    agent.inventory.add_item(material_name, int(actual_amount))
                    gathered_material = material_name
                    gathered_amount = int(actual_amount)

                    # Learn gathering skill
                    agent.skills.learn_skill('gathering', 0.05)

                    # CREATE KNOWLEDGE from gathering (every 10th time to avoid spam)
                    if self.knowledge_system and random.random() < 0.1:
                        # Determine tool used
                        tool_used = None
                        if material_name == 'wood' and agent.inventory.has_item('stone'):
                            tool_used = "stone axe"
                        elif material_name == 'stone' and agent.inventory.has_item('wood'):
                            tool_used = "wooden lever/handle"
                        elif material_name in ['metal_ore', 'iron_ore'] and agent.inventory.has_item('stone'):
                            tool_used = "stone pickaxe"

                        gathering_skill = agent.skills.get_skill('gathering')

                        knowledge_content = {
                            "material": material_name,
                            "amount_gathered": gathered_amount,
                            "tool_used": tool_used if tool_used else "bare hands",
                            "efficiency_bonus": round(efficiency_multiplier, 2),
                            "gatherer_skill": round(gathering_skill, 2),
                            "location_type": "wilderness",
                            "technique": "manual gathering" if not tool_used else f"tool-assisted gathering ({tool_used})",
                            "purpose": "acquiring raw materials for construction and survival",
                            "lessons": f"{agent.name} discovered {material_name} in the wilderness and gathered {gathered_amount} units using {tool_used if tool_used else 'bare hands'}. {'Using tools increased efficiency by ' + str(int((efficiency_multiplier - 1) * 100)) + '%.' if tool_used else 'Tools would improve gathering speed.'} This resource is essential for civilization development.",
                            "process": f"1. Located {material_name} deposit in wilderness\n2. Used {tool_used if tool_used else 'manual labor'} to extract material\n3. Gathered {gathered_amount} units\n4. Stored in personal inventory\n5. Resource can be used for building or crafting",
                            "outcome": f"Successfully acquired {gathered_amount} {material_name} for community use"
                        }
                        self.knowledge_system.create_knowledge(
                            agent.id,
                            "technique",
                            f"Gathering {material_name}",
                            knowledge_content
                        )

                    # Satisfy resource need slightly
                    agent.needs.satisfy_need(NeedType.RESOURCES, 0.1)

                    break

        if gathered_material:
            return {
                'success': True,
                'emotional_impact': 0.15,
                'message': f'Gathered {gathered_amount} {gathered_material}'
            }
        else:
            return {
                'success': False,
                'emotional_impact': -0.05,
                'message': 'No materials available to gather'
            }

    def handle_rest(self, agent: Agent) -> Dict:
        """Handle rest/sleep"""
        # Restore energy
        agent.energy = min(100.0, agent.energy + 20.0)

        # Satisfy sleep need
        agent.needs.satisfy_need(NeedType.SLEEP, 0.5)

        # Reduce stress
        agent.emotions.stress = max(0.0, agent.emotions.stress - 0.2)

        # CULTURAL STORY CREATION - Agents reflect and create stories while resting!
        if self.story_generator and self.story_feed:
            # Thoughtful, open-minded agents create stories while reflecting
            openness = agent.personality.get_trait('openness')
            story_chance = openness * 0.08  # Lower chance during rest (up to 8%)

            if random.random() < story_chance:
                # Rest encourages reflective stories: teachings, warnings, prophecies
                story_types = [StoryType.TEACHING, StoryType.WARNING]

                # Very creative agents might imagine myths or songs
                if openness > 0.7:
                    story_types.extend([StoryType.MYTH, StoryType.SONG])

                story_type = random.choice(story_types)

                story = StoryGenerator.agent_creates_story(
                    agent.name,
                    {
                        'creativity': openness,
                        'openness': openness
                    },
                    story_type,
                    0,  # Will be set by simulation
                    {'agent_id': agent.id}
                )

                self.story_feed.add_story(story)

        return {
            'success': True,
            'emotional_impact': 0.1,
            'message': 'Rested and recovered'
        }

    def _choose_story_type(self, agent: Agent) -> StoryType:
        """Choose which type of cultural story an agent tells based on their state"""
        # Happy agents tell songs and legends
        joy_level = agent.emotions.emotion_levels.get(EmotionType.JOY, 0.0)

        # Fearful agents tell warnings
        fear_level = agent.emotions.emotion_levels.get(EmotionType.FEAR, 0.0)

        # Check agent achievements and experiences
        has_achievements = hasattr(agent, 'achievements') and len(agent.achievements) > 0

        # Build weighted story type list
        story_options = []

        # Myths - explaining the unknown (base chance)
        story_options.extend([StoryType.MYTH] * 2)

        # Legends - heroic tales (higher if agent has achievements)
        legend_weight = 3 if has_achievements else 1
        story_options.extend([StoryType.LEGEND] * legend_weight)

        # Teachings - wisdom (higher if agent is older/experienced)
        teaching_weight = 3 if agent.age > 30 else 1
        story_options.extend([StoryType.TEACHING] * teaching_weight)

        # Warnings - cautionary tales (higher if fearful or stressed)
        warning_weight = 4 if fear_level > 0.5 or agent.emotions.stress > 0.6 else 1
        story_options.extend([StoryType.WARNING] * warning_weight)

        # Songs - joyful tales (higher if happy)
        song_weight = 4 if joy_level > 0.6 else 1
        story_options.extend([StoryType.SONG] * song_weight)

        return random.choice(story_options)

    def handle_chop_wood(self, agent: Agent) -> Dict:
        """Handle chopping wood from trees - specialized wood gathering"""
        # Check if wood is available in resource pools
        available = self.world.resource_pools.get('wood', 0)

        if available < 5:
            return {
                'success': False,
                'emotional_impact': -0.05,
                'message': 'No trees available to chop'
            }

        # Base gathering amount
        base_amount = random.uniform(4.0, 10.0)

        # Tool efficiency - stone tools help chop wood faster
        efficiency_multiplier = 1.0
        if agent.inventory.has_item('stone'):
            efficiency_multiplier = 1.8  # Stone axe is very effective!

        # Skill bonus - gathering/crafting skill improves efficiency
        gathering_skill = agent.skills.get_skill('gathering')
        skill_bonus = 1.0 + (gathering_skill * 0.5)

        amount_to_gather = base_amount * efficiency_multiplier * skill_bonus
        actual_amount = self.world.harvest_from_pool('wood', amount_to_gather)

        if actual_amount > 0:
            # Add to inventory
            agent.inventory.add_item('wood', int(actual_amount))

            # Learn gathering skill
            agent.skills.learn_skill('gathering', 0.08)

            # Satisfy resource need
            agent.needs.satisfy_need(NeedType.RESOURCES, 0.15)

            # Restore a bit of energy from productive work
            agent.energy = min(100.0, agent.energy + 2.0)

            return {
                'success': True,
                'emotional_impact': 0.2,
                'message': f'Chopped {int(actual_amount)} wood from trees'
            }
        else:
            return {
                'success': False,
                'emotional_impact': -0.05,
                'message': 'Failed to chop wood'
            }

    def handle_mine(self, agent: Agent) -> Dict:
        """Handle mining stone and minerals - specialized mining"""
        # Priority: stone > metal_ore > iron_ore > clay
        materials_to_mine = ['stone', 'metal_ore', 'iron_ore', 'clay']

        for material_name in materials_to_mine:
            # Tool requirement for advanced materials
            if material_name in ['metal_ore', 'iron_ore']:
                # Mining ores requires stone tools
                if not agent.inventory.has_item('stone'):
                    continue

            # Check availability
            available = self.world.resource_pools.get(material_name, 0)

            if available > 5:
                # Base mining amount
                base_amount = random.uniform(3.0, 8.0)

                # Tool efficiency
                efficiency_multiplier = 1.0
                if agent.inventory.has_item('wood'):
                    efficiency_multiplier = 1.3  # Wooden handle helps
                if agent.inventory.has_item('stone') and material_name in ['metal_ore', 'iron_ore']:
                    efficiency_multiplier = 1.6  # Stone pickaxe for ore mining

                # Skill bonus
                gathering_skill = agent.skills.get_skill('gathering')
                skill_bonus = 1.0 + (gathering_skill * 0.5)

                amount_to_gather = base_amount * efficiency_multiplier * skill_bonus
                actual_amount = self.world.harvest_from_pool(material_name, amount_to_gather)

                if actual_amount > 0:
                    # Add to inventory
                    agent.inventory.add_item(material_name, int(actual_amount))

                    # Learn gathering skill
                    agent.skills.learn_skill('gathering', 0.08)

                    # Satisfy resource need
                    agent.needs.satisfy_need(NeedType.RESOURCES, 0.15)

                    # Restore a bit of energy
                    agent.energy = min(100.0, agent.energy + 2.0)

                    return {
                        'success': True,
                        'emotional_impact': 0.2,
                        'message': f'Mined {int(actual_amount)} {material_name}'
                    }

        return {
            'success': False,
            'emotional_impact': -0.05,
            'message': 'No minerals available to mine'
        }

    def handle_hunt(self, agent: Agent) -> Dict:
        """Handle hunting animals for food - specialized hunting"""
        # Hunting is more effective than foraging but requires skill/luck
        hunting_skill = agent.skills.get_skill('hunting')

        # Base success chance
        success_chance = 0.4 + (hunting_skill * 0.5)  # 40-90% depending on skill

        # Tool bonus - having weapons helps
        tool_bonus = 0.0
        if agent.inventory.has_item('stone'):
            tool_bonus = 0.15  # Stone spear/knife
        if agent.inventory.has_item('wood'):
            tool_bonus += 0.1  # Wooden spear

        success_chance = min(0.95, success_chance + tool_bonus)

        if random.random() < success_chance:
            # Successful hunt!
            amount = random.randint(8, 15)  # Hunting gives more food than gathering

            # Add to inventory
            agent.inventory.add_item('food', amount)

            # Learn hunting skill
            agent.skills.learn_skill('hunting', 0.1)

            # Satisfy hunger immediately (eating fresh meat)
            agent.needs.satisfy_need(NeedType.HUNGER, 0.4)

            # Restore energy from eating
            agent.energy = min(100.0, agent.energy + 8.0)

            # Gain achievement satisfaction
            agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.1)

            return {
                'success': True,
                'emotional_impact': 0.3,
                'message': f'Successfully hunted and gained {amount} food!'
            }
        else:
            # Failed hunt
            agent.skills.learn_skill('hunting', 0.02)  # Learn from failure

            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': 'Hunt unsuccessful - prey escaped'
            }

    def handle_gather_water(self, agent: Agent, current_tick: int) -> Dict:
        """Handle gathering water with intelligent pathfinding"""
        # Check if agent remembers a water location
        memory = self.resource_memory.recall_resource(
            agent.id,
            'water',
            current_tick,
            max_age=500
        )

        # Find water resource (use memory if available, otherwise search)
        if memory:
            # Try to navigate to remembered location
            target_x, target_y = memory['x'], memory['y']
            distance = agent.location.distance_to(Position(target_x, target_y))

            # If close enough, try to harvest
            if distance < 2.0:
                resource = self.world.find_nearest_resource(
                    agent.location,
                    ResourceType.WATER
                )
            else:
                # Navigate toward remembered location
                next_step = self.pathfinder.get_next_step(
                    agent.location.x, agent.location.y,
                    target_x, target_y
                )
                if next_step:
                    agent.location = Position(next_step[0], next_step[1])

                return {
                    'success': True,
                    'emotional_impact': 0.05,
                    'message': f'Navigating to water source (distance: {distance:.1f})'
                }
        else:
            # Search for water
            resource = self.world.find_nearest_resource(
                agent.location,
                ResourceType.WATER
            )

        if not resource or resource.quantity <= 0:
            # No nearby water source - try resource pools
            available = self.world.resource_pools.get('water', 0)

            if available > 5:
                # Gather from pool - INCREASED for survival!
                amount = random.randint(10, 18)  # Was 3-8, now 10-18
                actual_amount = self.world.harvest_from_pool('water', amount)

                if actual_amount > 0:
                    agent.inventory.add_item('water', int(actual_amount))

                    # Immediately drink to satisfy thirst MORE
                    agent.needs.satisfy_need(NeedType.THIRST, 0.6)  # Was 0.4, now 0.6

                    # Restore energy
                    agent.energy = min(100.0, agent.energy + 8.0)  # Was +5, now +8

                    return {
                        'success': True,
                        'emotional_impact': 0.2,
                        'message': f'Gathered {int(actual_amount)} water'
                    }

            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': 'No water source found'
            }

        # Check distance to resource
        distance = agent.location.distance_to(resource.location)

        # If too far, navigate closer
        if distance > 3.0:
            next_step = self.pathfinder.get_next_step(
                agent.location.x, agent.location.y,
                resource.location.x, resource.location.y
            )

            if next_step:
                agent.location = Position(next_step[0], next_step[1])
                # Remember this resource location
                self.resource_memory.remember_resource(
                    agent.id,
                    'water',
                    resource.location.x,
                    resource.location.y,
                    resource.quantity,
                    current_tick
                )

                return {
                    'success': True,
                    'emotional_impact': 0.05,
                    'message': f'Moving toward water (distance: {distance:.1f})'
                }

        # Close enough to harvest!
        # Harvest water from resource - INCREASED for survival!
        amount = self.world.harvest_resource(resource.id, 12.0)  # Was 5.0, now 12.0

        if amount > 0:
            # Add to inventory
            agent.inventory.add_item('water', int(amount))

            # Immediately drink to satisfy thirst MORE
            agent.needs.satisfy_need(NeedType.THIRST, 0.6)  # Was 0.4, now 0.6

            # Restore energy
            agent.energy = min(100.0, agent.energy + 8.0)  # Was +5, now +8

            # Remember this successful location
            self.resource_memory.remember_resource(
                agent.id,
                'water',
                resource.location.x,
                resource.location.y,
                resource.quantity,
                current_tick
            )

            return {
                'success': True,
                'emotional_impact': 0.2,
                'message': f'Gathered {amount:.1f} water'
            }
        else:
            # Resource depleted, forget this location
            self.resource_memory.forget_resource(
                agent.id,
                resource.location.x,
                resource.location.y
            )

            return {
                'success': False,
                'emotional_impact': -0.1,
                'message': 'Failed to gather water'
            }


class SimulationEngine:
    """Main simulation engine"""

    def __init__(self, world_width: int = 100, world_height: int = 100):
        # Core systems
        self.world = World(world_width, world_height)
        self.relationship_manager = RelationshipManager()
        self.group_manager = GroupManager()
        self.economy = EconomicEngine()
        self.event_logger = EventLogger()

        # OLD SYSTEMS - Full Civilization functionality (kept for compatibility)
        self.building_manager = BuildingManager()
        self.innovation_manager = InnovationManager()
        self.warfare_manager = WarfareManager()
        self.governance_manager = GovernanceManager()
        self.production_manager = ProductionManager()
        self.strategy_manager = StrategyManager()

        # NEW AUTONOMOUS SYSTEMS - TRUE Freedom!
        self.experimentation_engine = ExperimentationEngine()
        self.dynamic_building_system = DynamicBuildingSystem()
        self.knowledge_system = KnowledgeSystem()
        self.consequence_engine = ConsequenceEngine()
        self.role_emergence = RoleEmergence()
        self.tech_progression = TechProgressionTracker()  # OLD - kept for compatibility
        self.persistence = PersistenceEngine()
        self.persistence.simulation = self  # Set reference for save/load

        # PURPOSEFUL ACTION SYSTEM - Creates Rockefellers, Fords, empire builders!
        # Every decision has MEANING, PURPOSE, and measurable impact
        self.purposeful_evaluator = PurposefulActionEvaluator()

        # CIVILIZATION PROGRESSION - Stone Age → Space Age!
        # Milestones, pioneers, resource scarcity, logical progression
        self.civilization = CivilizationProgressionEngine()
        print("🏛️  Civilization starting in Stone Age...")
        print(f"   Available resources: {', '.join(self.civilization.available_resources)}")
        print(f"   Next milestone: {self.civilization.get_next_milestone().name}")

        # LIFE SYSTEM - Birth, romance, reproduction, family dynamics!
        # Agents can reproduce, have children, build families, create dynasties
        self.life_system = LifeSystem()
        print("💕 Life System enabled - Agents can reproduce and build families!")

        # FUN SYSTEM - Games, celebrations, art, entertainment!
        # Agents need fun to be happy - parties, gambling, sports, creativity
        self.fun_system = FunSystem()
        print("🎉 Fun System enabled - Agents can play games, throw parties, and create art!")

        # AGRICULTURE SYSTEM - From hunter-gatherer to farmer!
        # Crop farming, animal domestication, seasonal cycles, food surplus
        from world.agriculture import AgricultureManager
        self.agriculture = AgricultureManager()
        print("🌾 Agriculture System enabled - Farming revolution begins!")
        print("   Plant crops, tend fields, harvest food")
        print("   Domesticate animals for food and materials")
        print("   Seasonal cycles affect growth")

        # HEALTH & DISEASE SYSTEM - Medical challenges drive innovation!
        # Diseases spread, medicines discovered, healers emerge
        from world.health import HealthManager
        self.health = HealthManager()
        print("💊 Health & Disease System enabled - Medical challenges!")
        print("   Diseases spread through proximity")
        print("   Discover medicinal treatments")
        print("   Healers specialize in medical knowledge")

        # RELIGION & SPIRITUALITY SYSTEM - Beliefs shape civilization!
        # Religious leaders, temples, rituals, divine explanations
        from world.religion import ReligionManager
        self.religion = ReligionManager()
        print("🙏 Religion & Spirituality System enabled - Faith emerges!")
        print("   Beliefs form from unexplained events")
        print("   Charismatic leaders found religions")
        print("   Temples, rituals, and sacred traditions")

        # TERRITORY & LAND OWNERSHIP SYSTEM - Mine vs Yours!
        # Land claiming, borders, trespassing, territorial warfare
        from world.territory import TerritoryManager
        self.territory = TerritoryManager()
        print("🗺️  Territory & Ownership System enabled - Land disputes!")
        print("   Agents claim and defend territory")
        print("   Borders and trespassing create conflict")
        print("   Resource ownership drives expansion")

        # REAL CHEMISTRY SYSTEM - Actual science, not fake recipes!
        # Periodic table, real chemical reactions, element discovery
        from world.chemistry import ChemistryEngine
        self.chemistry = ChemistryEngine()
        print("⚗️  Real Chemistry System enabled - Science begins!")
        print("   Discover elements from the periodic table")
        print("   Perform real chemical reactions (Fe2O3 + 3C → 2Fe + 3CO)")
        print("   Synthesize compounds through experimentation")

        # ENERGY PROGRESSION SYSTEM - Fire to nuclear power!
        # Energy sources, power plants, electricity grids
        from world.energy import EnergyManager
        self.energy = EnergyManager()
        print("⚡ Energy Progression System enabled - Power civilization!")
        print("   Progress from wood → coal → oil → electricity → nuclear")
        print("   Build power plants and energy grids")
        print("   Manage fuel consumption and power distribution")

        # ADVANCED MATERIALS SYSTEM - Material science evolution!
        # Metal alloys, ceramics, polymers, composites, semiconductors
        from world.materials import MaterialsManager
        self.materials_science = MaterialsManager()
        print("🔬 Advanced Materials System enabled - Material ages!")
        print("   Progress from Stone → Bronze → Iron → Steel → Silicon Age")
        print("   Discover alloys, ceramics, polymers, and composites")
        print("   Material properties determine what can be built")

        # STORY ENGINE - Transform events into EPIC narratives!
        # Every birth, death, achievement becomes a legendary tale
        self.story_feed = StoryFeed(max_stories=100)
        self.story_generator = StoryGenerator()
        print("📜 Story Engine enabled - Every moment becomes a legend!")

        # ACHIEVEMENT SYSTEM - Track epic milestones!
        # Personal achievements (first builder, dynasty founder) + civilization milestones
        self.achievement_tracker = AchievementTracker()
        print("🏆 Achievement System enabled - Legends will be made!")

        # META-PROGRESSION SYSTEM - AI Self-Improvement!
        # Agents discover new capabilities, unlock systems, potentially modify rules
        # Phase 1: Use what we give → Phase 2: Discover capabilities → Phase 3: Unlock systems → Phase 4: MODIFY RULES
        from world.meta_progression import MetaProgressionEngine
        self.meta_progression = MetaProgressionEngine()
        print("🧬 META-PROGRESSION enabled - Agents can expand their own capabilities!")
        print("   Phase 1: Using provided actions")
        print("   Phase 2-4: Discovery, system unlocking, and RULE MODIFICATION await...")

        # PATHFINDING & NAVIGATION - Intelligent movement to resources!
        # Agents navigate intelligently using A* pathfinding
        # Remember resource locations for efficient gathering
        from agents.pathfinding import Pathfinder, ResourceMemory
        self.pathfinder = Pathfinder(world_width, world_height)
        self.resource_memory = ResourceMemory(memory_capacity=30)
        print("🗺️  Pathfinding enabled - Agents navigate intelligently!")
        print("   A* algorithm for optimal routes")
        print("   Resource location memory for efficiency")

        # WEATHER SYSTEM - Dynamic environmental effects!
        # Weather changes affect resources, agents, and gameplay
        from world.weather import WeatherSystem
        self.weather = WeatherSystem()
        print("🌦️  Weather System enabled - Dynamic environment!")
        print("   Rain, snow, storms, drought affect gameplay")
        print("   Seasonal weather patterns")
        print("   Weather affects resources and agent survival")

        # NATURAL DISASTERS - Dramatic catastrophic events!
        # Earthquakes, floods, fires, tornadoes, meteors, plagues
        from world.disasters import NaturalDisasterSystem
        self.disasters = NaturalDisasterSystem(world_width, world_height)
        print("⚠️  Natural Disasters enabled - Dramatic challenges!")
        print("   Earthquakes, floods, fires, tornadoes, and more")
        print("   Warning systems for predictable disasters")
        print("   Buildings and agents affected by catastrophes")

        # Profile builder
        self.profile_builder = ProfileBuilder(self)

        # ===== AI AUTONOMY SYSTEM - FULL AI-POWERED AGENTS! =====
        # Load configuration
        self.config = load_config()

        # Initialize LLM brain (shared across all agents)
        if self.config.use_llm_decisions:
            self.llm_brain = MultiLLMBrain(api_keys=self.config.get_api_keys())
            print("🧠 AI Autonomy ENABLED - Agents will make AI-powered decisions!")
            print(f"   LLM Providers: {'Groq' if self.config.get_api_keys().get('groq') else ''} "
                  f"{'Gemini' if self.config.get_api_keys().get('gemini') else ''} "
                  f"{'Ollama' if True else ''}")
            print(f"   Long-term planning: Every {self.config.long_term_planning_interval} ticks")
            print(f"   Self-reflection: Every {self.config.reflection_interval} ticks")
        else:
            self.llm_brain = None
            print("🤖 AI Autonomy DISABLED - Using rule-based psychology only")
            print("   (Set USE_LLM_DECISIONS=true in .env to enable AI)")

        # Initialize Swarm Intelligence (v2.0 - Multi-Agent Coordination)
        if self.config.enable_swarm_intelligence and self.llm_brain:
            self.swarm_intelligence = SwarmIntelligence(
                llm_brain=self.llm_brain,
                config=self.config.get_swarm_config()
            )
            print("🐝 SWARM INTELLIGENCE ENABLED - Agents will coordinate and form alliances!")
            print(f"   Max Swarm Size: {self.config.max_swarm_size} agents")
            print(f"   Consensus Threshold: {self.config.consensus_threshold * 100:.0f}%")
            print(f"   Coordination Radius: {self.config.coordination_radius} tiles")
            print(f"   Parallel LLM: {'✅' if self.config.enable_parallel_llm else '❌'}")
        else:
            self.swarm_intelligence = None
            if self.config.enable_swarm_intelligence and not self.llm_brain:
                print("⚠️  Swarm Intelligence requires LLM decisions to be enabled")
            else:
                print("🤖 Swarm Intelligence DISABLED - Agents act independently")

        # Interaction handler
        self.interaction_handler = InteractionHandler(
            self.world,
            self.relationship_manager,
            self.economy,
            self.event_logger,
            self.knowledge_system,
            self.story_generator,
            self.story_feed,
            self.pathfinder,
            self.resource_memory
        )

        # ===== ACTION HANDLER SYSTEM - Modular, Testable Action Execution! =====
        # Replaces monolithic execute_action() with SOLID-compliant handler pattern
        from engine.action_handlers import ActionContext, ActionHandlerRegistry
        from engine.handlers import (
            MovementActionHandler,
            SurvivalActionHandler,
            SocialInteractionHandler,
            ResourceGatheringHandler
        )

        self._action_context = ActionContext(self)
        self._handler_registry = ActionHandlerRegistry()

        # Register all action handlers
        self._register_action_handlers()
        print("⚙️  Action Handler System enabled - Modular action execution!")

        # Agent lookup cache for O(1) performance
        self._agent_cache: Dict[str, Agent] = {}
        print("🚀 Agent lookup cache enabled - O(1) agent queries!")

        # Simulation state
        self.running = False
        self.tick_rate = 1.0  # Seconds per tick
        self.paused = False

        # Statistics
        self.total_agents_created = 0
        self.total_reactions_performed = 0  # Chemistry reactions

        # Civilization milestone tracking
        self.achieved_milestones = set()
        self.milestone_history = []  # List of {milestone, tick, details}

        # Death wipe tracking
        self.death_wipe_detected = False
        self.last_auto_save_tick = 0
        self.civilization_history_exported = False

        # POPULATION HISTORY TRACKING - Track births/deaths over time!
        # Track population stats per day for graphing
        self.population_history = []  # List of {day, tick, alive, births, deaths, total_created}
        self.births_this_day = 0
        self.deaths_this_day = 0
        self.death_causes = {}  # {cause: count} for current day
        self.last_tracked_day = 0
        print("📊 Population tracking enabled - track births/deaths over time!")

    def _register_action_handlers(self) -> None:
        """
        Register all action handlers with the registry.

        This method is called during __init__ to set up the modular action
        execution system. All 17 handlers are registered for 100% coverage.
        """
        from engine.handlers import (
            MovementActionHandler,
            SurvivalActionHandler,
            SocialInteractionHandler,
            ResourceGatheringHandler,
            KnowledgeActionHandler,
            AgricultureHandler,
            ConstructionHandler,
            EntertainmentHandler,
            GovernanceHandler,
            CombatActionHandler,
            HealthHandler,
            ReligionHandler,
            TerritoryHandler,
            ChemistryHandler,
            EnergyHandler,
            MaterialsHandler,
            AdvancedEconomyHandler,
        )

        # Register ALL action handlers (17 total)
        handlers = [
            # Basic Actions
            MovementActionHandler(self._action_context),
            SurvivalActionHandler(self._action_context),
            SocialInteractionHandler(self._action_context),
            ResourceGatheringHandler(self._action_context),

            # Knowledge & Learning
            KnowledgeActionHandler(self._action_context),

            # Production & Building
            AgricultureHandler(self._action_context),
            ConstructionHandler(self._action_context),

            # Culture & Entertainment
            EntertainmentHandler(self._action_context),

            # Society & Politics
            GovernanceHandler(self._action_context),
            CombatActionHandler(self._action_context),

            # Health & Religion
            HealthHandler(self._action_context),
            ReligionHandler(self._action_context),

            # Territory & Resources
            TerritoryHandler(self._action_context),

            # Advanced Science
            ChemistryHandler(self._action_context),
            EnergyHandler(self._action_context),
            MaterialsHandler(self._action_context),

            # Advanced Economy
            AdvancedEconomyHandler(self._action_context),
        ]

        self._handler_registry.register_multiple(handlers)

        # Log coverage statistics
        stats = self._handler_registry.get_coverage_stats()
        print(f"   Registered {len(handlers)} action handlers")
        print(f"   Coverage: {stats['covered_count']}/{stats['total_action_types']} action types ({stats['coverage_percentage']:.1f}%)")

        if stats['coverage_percentage'] >= 100:
            print(f"   ✅ 100% ACTION COVERAGE ACHIEVED!")
        elif stats['uncovered_count'] > 0:
            print(f"   ⚠️  {stats['uncovered_count']} action types not yet covered:")
            for action_type in stats['uncovered'][:10]:  # Show first 10
                print(f"      - {action_type}")

    def _rebuild_agent_cache(self) -> None:
        """
        Rebuild the agent lookup cache for O(1) access by ID.

        This should be called after:
        - New agents are created
        - Agents are removed
        - Loading from save
        """
        self._agent_cache = {agent.id: agent for agent in self.world.agents if agent.alive}

    def initialize_world(self, num_agents: int = 50):
        """Initialize world with starting population"""
        print(f"Initializing Neuronaut World with {num_agents} agents...")

        # Create initial agents with balanced genders
        num_male = num_agents // 2
        num_female = num_agents - num_male

        for i in range(num_agents):
            # First half male, second half female
            gender = Gender.MALE if i < num_male else Gender.FEMALE
            agent = self.create_agent(
                name=None,  # Random name
                age=random.randint(18, 40),
                gender=gender
            )

            # Random starting position
            agent.location = Position(
                random.uniform(20, 80),
                random.uniform(20, 80)
            )

            # Give starting resources
            # NO FREE WEALTH - This is a survival world! Must discover economy from scratch.
            # Agents must earn wealth through: trading, gambling, or discovering coin minting!
            agent.wealth = 0.0
            print(f"🆕 Created {agent.name} with wealth: {agent.wealth} (ZERO WEALTH MODE)")
            agent.inventory.add_item('food', random.randint(3, 8))
            agent.inventory.add_item('water', random.randint(3, 8))

            # Give basic materials for experimentation!
            agent.inventory.add_item('wood', random.randint(5, 15))
            agent.inventory.add_item('stone', random.randint(3, 10))
            agent.inventory.add_item('plant_fiber', random.randint(2, 8))
            # Give some metal ore so they can discover smelting → minting → coin creation!
            agent.inventory.add_item('metal_ore', random.randint(2, 5))

            self.world.agents.append(agent)

            # Create life profile for the agent - enables reproduction!
            personality_dict = {
                'openness': agent.personality.openness,
                'conscientiousness': agent.personality.conscientiousness,
                'extraversion': agent.personality.extraversion,
                'agreeableness': agent.personality.agreeableness,
                'neuroticism': agent.personality.neuroticism,
            }
            self.life_system.create_life_profile(
                agent.id,
                personality_dict,
                parents=None,  # First generation has no parents
                inherited_wealth=0.0
            )

            # Log birth
            title, desc = EventGenerator.agent_born(
                agent.name,
                {'x': agent.location.x, 'y': agent.location.y}
            )
            self.event_logger.log_event(
                EventCategory.LIFE,
                EventImportance.MINOR,
                title, desc,
                0,
                [agent.id],
                {'x': agent.location.x, 'y': agent.location.y}
            )

        print(f"✓ Created {num_agents} agents")
        print(f"✓ World initialized")

        # Rebuild agent cache for O(1) lookups
        self._rebuild_agent_cache()
        print(f"✓ Agent cache built ({len(self._agent_cache)} agents indexed)")

        print(f"✓ Neuronaut World is ready!")

    def create_agent(
        self,
        name: Optional[str] = None,
        age: int = 20,
        is_player: bool = False,
        gender: Optional[Gender] = None
    ) -> Agent:
        """Create a new agent"""
        agent = Agent(
            name=name,
            age=age,
            is_player=is_player,
            gender=gender
        )

        # Initialize value learning system with current market prices
        # Agents start with vague, personality-influenced estimates
        agent.initialize_value_estimates(self.economy.market.item_prices)

        # ===== ADD AUTONOMOUS AI CAPABILITIES =====
        # Dynamically add autonomous methods to agent if LLM is enabled
        if self.config.use_llm_decisions:
            import types
            from agents.autonomous_agent import AutonomousAgentMixin

            # Bind all mixin methods from the class (not instance) to the agent
            for method_name in dir(AutonomousAgentMixin):
                # Skip magic methods (__ __) but include all others including _private methods
                if not method_name.startswith('__'):
                    method = getattr(AutonomousAgentMixin, method_name, None)
                    if callable(method):
                        # Bind method to agent instance
                        setattr(agent, method_name, types.MethodType(method, agent))

            # Initialize autonomous systems (overwrites agent.memory with enhanced version)
            agent.init_autonomous_systems(llm_brain=self.llm_brain)
            # Now agent.memory is the autonomous MemorySystem with add_memory() compatibility

            # Track last planning/reflection tick (used in simulation loop)
            agent.last_planning_tick = 0
            agent.last_reflection_tick = 0

        self.total_agents_created += 1
        return agent

    async def run(self):
        """Main simulation loop"""
        self.running = True
        print("🚀 Neuronaut World simulation started!")

        while self.running:
            if not self.paused:
                try:
                    await self.tick()
                except Exception as e:
                    print(f"❌ ERROR in tick(): {e}")
                    import traceback
                    traceback.print_exc()

            # Sleep until next tick
            await asyncio.sleep(self.tick_rate)

    async def tick(self):
        """Single simulation tick"""
        current_tick = self.world.time.current_tick
        current_season = self.world.time.season

        # Update weather system
        self.weather.update(current_season, current_tick)
        weather_effects = self.weather.get_current_effects()

        # Update disaster system
        alive_count = sum(1 for a in self.world.agents if a.alive)
        self.disasters.update(
            current_tick,
            current_season,
            self.weather.current_weather.value,
            alive_count
        )

        # Apply disaster effects to buildings and agents
        for disaster in self.disasters.active_disasters:
            # Only apply effects to disasters we haven't processed yet
            if disaster.tick == current_tick:
                self._apply_disaster_to_world(disaster)

        # Advance world time (with weather effects affecting resources!)
        self.world.tick(weather_effects=weather_effects)

        # Update all managers
        self.building_manager.update_buildings()
        self.governance_manager.update_governments()

        # Update fun system (celebrations, games, etc.)
        completed_celebrations = self.fun_system.update_celebrations(delta_time=1.0)

        # Update agriculture system (crops, animals, seasons)
        season_changed = self.agriculture.update_season(current_tick)
        if season_changed:
            logger.info(f"🌍 Season changed to {self.agriculture.current_season.value}!")

        self.agriculture.update_crops(current_tick)
        self.agriculture.update_animals(current_tick)

        # Update health system (disease progression and spreading)
        deaths_from_disease = self.health.update_diseases(current_tick, self.world.agents)

        # Handle disease deaths
        for agent_id in deaths_from_disease:
            agent = next((a for a in self.world.agents if a.id == agent_id), None)
            if agent and agent.alive:
                agent.alive = False
                agent.health = 0
                logger.warning(f"💀 {agent.name} died from disease!")

                self.event_logger.log_event(
                    EventCategory.DEATH,
                    EventImportance.MAJOR,
                    f"{agent.name} succumbed to disease",
                    f"{agent.name} died from an untreated illness at age {agent.age}.",
                    current_tick,
                    [agent_id]
                )

        # Spread contagious diseases between nearby agents
        self.health.spread_diseases(self.world.agents, current_tick)

        # Update religion system (rituals)
        completed_rituals = self.religion.update_rituals(current_tick)

        # Apply spiritual benefits from completed rituals
        for ritual in completed_rituals:
            for participant_id in ritual.participants:
                participant = next((a for a in self.world.agents if a.id == participant_id), None)
                if participant:
                    # Rituals satisfy spiritual needs
                    participant.needs.satisfy_need(NeedType.MEANING, ritual.spiritual_benefit)
                    participant.needs.satisfy_need(NeedType.BELONGING, ritual.social_cohesion)

            logger.info(f"🙏 Religious {ritual.ritual_type.value} completed with {len(ritual.participants)} participants")

        # Apply mood boost to celebration participants
        current_tick = self.world.time.current_tick
        for celebration in completed_celebrations:
            for participant_id in celebration.participants:
                agent = next((a for a in self.world.agents if a.id == participant_id), None)
                if agent:
                    # Boost mood through satisfaction of social needs
                    agent.needs.satisfy_need(NeedType.BELONGING, celebration.mood_boost)
                    agent.needs.satisfy_need(NeedType.MEANING, celebration.mood_boost * 0.5)

                    # Trigger joy emotion from celebration
                    agent.emotions.trigger_emotion(EmotionType.JOY, celebration.mood_boost)

            # Log when celebration ends
            self.event_logger.log_event(
                EventCategory.CULTURAL,
                EventImportance.MINOR,
                f"✨ {celebration.celebration_name} concluded",
                f"The celebration attended by {len(celebration.participants)} agents has concluded. Memories were made!",
                current_tick,
                list(celebration.participants)
            )

        # Update all agents
        for agent in self.world.agents:
            if not agent.alive:
                continue

            # Update agent state
            agent.update()

            # ===== APPLY RESOURCE SINKS (prevent inflation) =====
            self._apply_resource_sinks(agent)

            # ===== REPUTATION DECAY (people forget!) =====
            agent.decay_reputation(decay_rate=0.001)  # 0.1% per tick

            # ===== APPLY WEATHER EFFECTS TO AGENT =====
            # Check if agent has shelter (in a building)
            has_shelter = agent.active_construction_id is not None
            weather_impact = self.weather.apply_weather_to_agent(
                agent.health,
                agent.energy,
                has_shelter
            )

            # Apply weather damage (storms, blizzards, heat waves)
            if weather_impact['damage'] > 0:
                agent.health -= weather_impact['damage']
                if agent.health < 30 and not has_shelter:
                    logger.warning(f"⚠️  {agent.name} taking weather damage! Health: {agent.health:.1f}")

            # Apply weather energy drain (cold, heat, storms)
            if weather_impact['energy_drain'] > 0:
                agent.energy = max(0, agent.energy - weather_impact['energy_drain'])

            # ===== APPLY DISEASE EFFECTS =====
            agent_diseases = self.health.get_agent_diseases(agent.id)
            for disease in agent_diseases:
                # Apply disease damage and energy drain
                agent.health = max(0, agent.health - disease.health_damage_per_tick)
                agent.energy = max(0, agent.energy - disease.energy_drain_per_tick)

                # Log if health is critically low
                if agent.health < 20 and disease.severity.value in ['severe', 'critical']:
                    logger.warning(f"⚠️  {agent.name} critically ill from {disease.disease_type.value}! Health: {agent.health:.1f}")

            # ===== CHECK FOR TRESPASSING =====
            trespassing_territory = self.territory.check_trespassing(
                agent.id,
                (agent.location.x, agent.location.y),
                current_tick
            )

            if trespassing_territory:
                # Agent is trespassing!
                if trespassing_territory.defended:
                    # Defended territory - owner might be alerted
                    agent.needs.satisfy_need(NeedType.SECURITY, -0.1)  # Feel unsafe

                    # Chance of conflict with owner/guards
                    if random.random() < 0.05 and trespassing_territory.guards:
                        logger.warning(f"⚔️  {agent.name} caught trespassing in {trespassing_territory.name}!")

            # Random disease infections (environmental)
            if random.random() < 0.0005:  # 0.05% chance per tick
                from world.health import DiseaseType, Severity

                # Environmental diseases based on conditions
                if hasattr(agent, \'needs\') and agent.needs.needs.get(NeedType.HUNGER) and agent.needs.needs[NeedType.HUNGER].level < 0.3:
                    # Malnutrition from starvation
                    self.health.infect_agent(agent.id, DiseaseType.MALNUTRITION, Severity.MODERATE, current_tick)
                elif hasattr(agent, \'needs\') and agent.needs.needs.get(NeedType.THIRST) and agent.needs.needs[NeedType.THIRST].level < 0.3:
                    # Dehydration
                    self.health.infect_agent(agent.id, DiseaseType.DEHYDRATION, Severity.MODERATE, current_tick)
                elif agent.energy < 20:
                    # Exhaustion
                    self.health.infect_agent(agent.id, DiseaseType.EXHAUSTION, Severity.MILD, current_tick)
                elif self.weather.current_weather.value in ['heat_wave']:
                    # Heat stroke
                    self.health.infect_agent(agent.id, DiseaseType.HEAT_STROKE, Severity.MODERATE, current_tick)
                else:
                    # Random flu
                    self.health.infect_agent(agent.id, DiseaseType.FLU, Severity.MILD, current_tick)

            # ===== CHECK FOR BIRTHS =====
            if agent.is_pregnant:
                baby = agent.check_pregnancy(current_tick)
                if baby:
                    # Get father for genetic inheritance
                    father = next((a for a in self.world.agents if a.id == agent.pregnancy_partner_id), None)
                    if father:
                        # Re-create baby with father's traits included
                        baby = agent.give_birth(current_tick)
                        baby._create_inherited_personality(father.personality)
                        father.children_ids.append(baby.id)

                    # Add baby to world
                    self.world.agents.append(baby)

                    # Log birth event
                    father_name = father.name if father else "unknown"
                    self.event_logger.log_event(
                        EventCategory.LIFE,
                        EventImportance.MAJOR,
                        f"👶 Birth: {baby.name} was born!",
                        f"{agent.name} gave birth to {baby.name}! Father: {father_name}",
                        current_tick,
                        [agent.id, father.id] if father else [agent.id]
                    )

                    # ===== STORY GENERATION - Make this birth LEGENDARY! =====
                    current_day = current_tick // 144  # Convert ticks to days
                    population = sum(1 for a in self.world.agents if a.alive)
                    family_context = {
                        'mother_id': agent.id,
                        'father_id': father.id if father else None,
                        'population': population,
                        'generation': 2  # TODO: Track generation properly
                    }
                    birth_story = self.story_generator.generate_birth_story(
                        baby.name, agent.name, father_name, current_day, family_context
                    )
                    self.story_feed.add_story(birth_story)
                    logger.info(f"📜 STORY: {birth_story.title}")

                    # ===== ACHIEVEMENT TRACKING =====
                    # Track all family members for achievements
                    self.achievement_tracker.track_agent(baby.id, baby.name)
                    self.achievement_tracker.track_agent(agent.id, agent.name)
                    if father:
                        self.achievement_tracker.track_agent(father.id, father.name)
                        # Update father's children count
                        self.achievement_tracker.update_agent_stat(father.id, 'children_count', len(father.children_ids))

                    # Update mother's children count
                    self.achievement_tracker.update_agent_stat(agent.id, 'children_count', len(agent.children_ids))

                    # Check for PARENT achievement
                    mother_achievements = self.achievement_tracker.check_agent_achievements(agent.id, current_day)
                    if father:
                        father_achievements = self.achievement_tracker.check_agent_achievements(father.id, current_day)
                        for ach in father_achievements:
                            logger.info(f"🏆 {father.name} unlocked: {ach.name}")
                    for ach in mother_achievements:
                        logger.info(f"🏆 {agent.name} unlocked: {ach.name}")

                    # Civilization achievement - FIRST BIRTH
                    first_birth_ach = self.achievement_tracker.unlock_civilization_achievement(
                        AchievementType.FIRST_BIRTH, current_day
                    )
                    if first_birth_ach:
                        logger.info(f"🎆 CIVILIZATION ACHIEVEMENT: {first_birth_ach.name}")

            # Strategic planning - agent chooses/updates goals
            if self.strategy_manager.should_pursue_new_goal(agent.id, agent):
                world_context = {
                    'has_rivals': len(self.warfare_manager.get_agent_conflicts(agent.id)) > 0,
                    'nearby_agents': len([a for a in self.world.agents
                                        if a.alive and a.location.distance_to(agent.location) < 20]),
                }
                new_goal = StrategicPlanner.choose_goal(agent, world_context)
                if new_goal:
                    self.strategy_manager.add_goal(agent.id, new_goal)

            # Agent perceives world
            world_state = self.world.get_state()
            perceptions = agent.perceive(world_state)

            # ===== ENHANCE PERCEPTIONS WITH COMBAT INFORMATION =====
            # Add information about potential combat targets
            nearby_agents_with_resources = []
            for other_agent in self.world.agents:
                if other_agent.id != agent.id and other_agent.alive:
                    distance = agent.location.distance_to(other_agent.location)
                    if distance < 30:  # Within combat range
                        # Check if they have resources worth fighting for
                        has_food = other_agent.inventory.has_item('food')
                        has_water = other_agent.inventory.has_item('water')
                        has_valuable_resources = other_agent.wealth > 50 or has_food or has_water

                        # Check if they're weak (low health)
                        is_weak = other_agent.health < 50

                        # Check for grudges
                        grudge_level = self.warfare_manager.get_grudge(agent.id, other_agent.id)

                        if has_valuable_resources or is_weak or grudge_level > 0.3:
                            nearby_agents_with_resources.append({
                                'id': other_agent.id,
                                'name': other_agent.name,
                                'distance': distance,
                                'health': other_agent.health,
                                'has_food': has_food,
                                'has_water': has_water,
                                'wealth': other_agent.wealth,
                                'is_weak': is_weak,
                                'grudge_level': grudge_level
                            })

            # Add to perceptions
            perceptions['potential_combat_targets'] = nearby_agents_with_resources

            # Add agent's own resource desperation
            perceptions['resource_desperation'] = {
                'hunger': agent.needs.needs[NeedType.HUNGER].level if hasattr(agent.needs.needs.get(NeedType.HUNGER), 'level') else 0.0,
                'thirst': agent.needs.needs[NeedType.THIRST].level if hasattr(agent.needs.needs.get(NeedType.THIRST), 'level') else 0.0,
                'has_food': agent.inventory.has_item('food'),
                'has_water': agent.inventory.has_item('water')
            }

            # ===== ADD GOVERNANCE INFORMATION =====
            governance_info = {}

            # Check if agent is in a government
            agent_government = None
            for gov_id, gov in self.governance_manager.governments.items():
                if agent.id in gov.citizens and gov.active:
                    agent_government = gov
                    break

            if agent_government:
                governance_info['is_citizen'] = True
                governance_info['government_name'] = agent_government.name
                governance_info['government_type'] = agent_government.government_type.value
                governance_info['is_leader'] = (agent.id == agent_government.leader_id)
                governance_info['approval_rating'] = agent_government.approval_rating

                # Check if agent can make laws
                governance_info['can_make_laws'] = self.governance_manager._can_make_law(agent.id, agent_government)

                # Get active laws
                governance_info['active_laws'] = [
                    self.governance_manager.laws[law_id].name
                    for law_id in agent_government.laws
                    if law_id in self.governance_manager.laws and self.governance_manager.laws[law_id].active
                ]

                # Check for pending votes
                pending_votes = []
                for law_id, law in self.governance_manager.laws.items():
                    if law_id in agent_government.laws and law.active:
                        if agent.id not in law.supporters and agent.id not in law.opposers:
                            pending_votes.append(law_id)
                governance_info['pending_votes'] = pending_votes

            else:
                # Not in government - check if could form one
                governance_info['is_citizen'] = False
                governance_info['is_leader'] = False

                # Count nearby agents (potential followers)
                nearby_count = sum(1 for other in self.world.agents
                                 if other.id != agent.id and other.alive
                                 and agent.location.distance_to(other.location) < 50)
                governance_info['nearby_agents_count'] = nearby_count

            # Add political power
            governance_info['political_power'] = self.governance_manager.political_power.get(agent.id, 0.0)

            perceptions['governance_info'] = governance_info

            # ===== ADD RESOURCE SCARCITY INFORMATION =====
            scarcity_info = {}

            # Get global resource pool status
            resource_status = self.world.get_resource_pool_status()
            pools = resource_status['pools']

            # Calculate scarcity levels for key resources
            scarcity_thresholds = {
                'critical': 0.2,  # < 20% remaining
                'low': 0.4,       # < 40% remaining
                'moderate': 0.7,  # < 70% remaining
            }

            # Initial resource amounts (from world/simulation.py)
            initial_amounts = {
                'stone': 3000.0,
                'wood': 2500.0,
                'food': 2000.0,
                'water': 3500.0,
                'clay': 1200.0,
                'sand': 1000.0,
                'hide': 600.0,
                'plant_fiber': 1500.0,
            }

            scarce_resources = []
            abundant_resources = []

            for resource_name, current_amount in pools.items():
                if resource_name in initial_amounts:
                    initial = initial_amounts[resource_name]
                    ratio = current_amount / initial if initial > 0 else 0.0

                    if ratio < scarcity_thresholds['critical']:
                        scarce_resources.append({
                            'name': resource_name,
                            'amount': current_amount,
                            'ratio': ratio,
                            'level': 'CRITICAL'
                        })
                    elif ratio < scarcity_thresholds['low']:
                        scarce_resources.append({
                            'name': resource_name,
                            'amount': current_amount,
                            'ratio': ratio,
                            'level': 'LOW'
                        })
                    elif ratio > 0.9:  # > 90% = abundant
                        abundant_resources.append({
                            'name': resource_name,
                            'amount': current_amount,
                            'ratio': ratio
                        })

            scarcity_info['scarce_resources'] = scarce_resources
            scarcity_info['abundant_resources'] = abundant_resources
            scarcity_info['total_resources'] = resource_status['total_resources']

            # Check what resources agent needs
            agent_needs_resources = []
            if hasattr(agent, \'needs\') and agent.needs.needs.get(NeedType.HUNGER) and agent.needs.needs[NeedType.HUNGER].level > 0.5:
                agent_needs_resources.append('food')
            if hasattr(agent, \'needs\') and agent.needs.needs.get(NeedType.THIRST) and agent.needs.needs[NeedType.THIRST].level > 0.5:
                agent_needs_resources.append('water')

            # Check if needed resources are scarce (creates urgency!)
            critical_scarcity = []
            for needed in agent_needs_resources:
                for scarce in scarce_resources:
                    if scarce['name'] == needed:
                        critical_scarcity.append(scarce)

            scarcity_info['critical_scarcity'] = critical_scarcity
            scarcity_info['needs_resources'] = agent_needs_resources

            perceptions['scarcity_info'] = scarcity_info

            # ===== ADD TECH PROGRESSION INFORMATION =====
            tech_info = {}

            # Get current civilization era
            current_era = self.civilization.current_era
            tech_info['current_era'] = current_era.value

            # Get achieved milestones
            achieved_milestones = [
                {'name': m.name, 'achieved_by': m.achieved_by_name, 'impact': m.impact}
                for m in self.civilization.milestones.values()
                if m.is_achieved
            ]
            tech_info['achieved_milestones'] = achieved_milestones

            # Get next milestone to pursue
            unachieved_milestones = [
                {'id': m_id, 'name': m.name, 'description': m.description,
                 'unlocks_era': m.unlocks_era.value if m.unlocks_era else None,
                 'production_multiplier': m.production_multiplier}
                for m_id, m in self.civilization.milestones.items()
                if not m.is_achieved
            ]
            tech_info['next_milestones'] = unachieved_milestones[:3]  # Show top 3

            # Check if agent knows about specific technologies
            agent_knowledge = []
            for discovery in self.civilization.discoveries_made:
                agent_knowledge.append(discovery)
            tech_info['known_discoveries'] = agent_knowledge

            # Get available resources for current era
            from world.civilization_progression import RESOURCE_TIERS
            current_tier = RESOURCE_TIERS.get(current_era)
            if current_tier:
                tech_info['available_resources'] = current_tier.base_resources
                tech_info['discoverable'] = current_tier.discoverable_resources
                tech_info['prerequisite'] = current_tier.required_prerequisite

            perceptions['tech_info'] = tech_info

            # ===== ADD WEATHER INFORMATION =====
            weather_info = {}
            current_weather = self.weather.current_weather
            current_effects = self.weather.get_current_effects()

            weather_info['current_weather'] = current_weather.value
            weather_info['emoji'] = current_effects.emoji
            weather_info['description'] = current_effects.description

            # Effects that agents should know about
            weather_info['effects'] = {
                'water_regeneration': current_effects.water_regeneration,
                'food_regeneration': current_effects.food_regeneration,
                'energy_drain': current_effects.energy_drain,
                'movement_speed': current_effects.movement_speed,
                'gathering_efficiency': current_effects.gathering_efficiency,
                'danger_level': current_effects.danger_level,
                'shelter_required': current_effects.shelter_required,
                'visibility_range': current_effects.visibility_range
            }

            # Check if agent is in shelter (has building nearby)
            has_shelter = False
            for building in self.dynamic_building_system.buildings.values():
                if building.is_complete and not building.collapsed:
                    dist = ((agent.location.x - building.location[0])**2 +
                            (agent.location.y - building.location[1])**2)**0.5
                    if dist < 5:  # Within 5 units = sheltered
                        has_shelter = True
                        break

            weather_info['has_shelter'] = has_shelter
            weather_info['needs_shelter'] = current_effects.shelter_required and not has_shelter

            perceptions['weather_info'] = weather_info

            # ===== ADD BUILDING INFORMATION =====
            buildings_info = {}

            # Find nearby buildings
            nearby_buildings = []
            for building in self.dynamic_building_system.buildings.values():
                dist = ((agent.location.x - building.location[0])**2 +
                        (agent.location.y - building.location[1])**2)**0.5

                if dist < 50:  # Within 50 units
                    building_data = {
                        'id': building.id,
                        'name': building.name,
                        'distance': round(dist, 1),
                        'is_complete': building.is_complete,
                        'construction_progress': round(building.construction_progress * 100, 1) if not building.is_complete else 100,
                        'collapsed': building.collapsed
                    }

                    # Add benefits if building is complete and not collapsed
                    if building.is_complete and not building.collapsed:
                        benefits = {}
                        if building.shelter_value and building.shelter_value > 0:
                            benefits['shelter'] = building.shelter_value
                        if building.storage_capacity and building.storage_capacity > 0:
                            benefits['storage'] = building.storage_capacity
                        if building.production_bonus and building.production_bonus > 0:
                            benefits['production_bonus'] = building.production_bonus
                        if building.comfort_value and building.comfort_value > 0:
                            benefits['comfort'] = building.comfort_value
                        if building.defense_value and building.defense_value > 0:
                            benefits['defense'] = building.defense_value

                        if benefits:
                            building_data['benefits'] = benefits

                        # Add occupancy info
                        building_data['occupants_count'] = len(building.occupants)
                        building_data['workers_count'] = len(building.workers)

                    nearby_buildings.append(building_data)

            # Sort by distance
            nearby_buildings.sort(key=lambda b: b['distance'])
            buildings_info['nearby_buildings'] = nearby_buildings[:10]  # Top 10 closest

            # Check if agent can build (has resources)
            agent_resources = {}
            if hasattr(agent.inventory, 'items'):
                for item in agent.inventory.items:
                    resource_name = item.name if hasattr(item, 'name') else str(item)
                    if resource_name in agent_resources:
                        agent_resources[resource_name] += 1
                    else:
                        agent_resources[resource_name] = 1

            buildings_info['can_build'] = len(agent_resources) > 0
            buildings_info['available_materials'] = agent_resources

            # Suggest buildable structures based on materials and era
            buildable = []
            if 'wood' in agent_resources or 'stone' in agent_resources:
                # Basic shelter
                if agent_resources.get('wood', 0) >= 10 or agent_resources.get('stone', 0) >= 5:
                    buildable.append({
                        'purpose': 'shelter',
                        'name': 'Basic Shelter',
                        'materials': {'wood': 10} if 'wood' in agent_resources else {'stone': 5},
                        'benefit': 'Protection from weather'
                    })

            if 'wood' in agent_resources and agent_resources.get('wood', 0) >= 20:
                buildable.append({
                    'purpose': 'crafting',
                    'name': 'Workshop',
                    'materials': {'wood': 20, 'stone': 10},
                    'benefit': 'Crafting bonus +20%'
                })

            buildings_info['buildable_structures'] = buildable

            perceptions['buildings_info'] = buildings_info

            # NOTE: Knowledge, disaster, experimentation, role emergence, and innovation perception
            # sections have been moved to PerceptionBuilder class (engine/agent_updates/perception_builder.py)
            # This reduced simulation.py by ~400 lines!

            # ===== ADD FUN/ENTERTAINMENT INFORMATION =====
            fun_info = {}

            # Active celebrations nearby
            nearby_celebrations = []
            for celebration in self.fun_system.active_celebrations.values():
                cel_loc = celebration.location
                dist = ((agent.location.x - cel_loc[0])**2 +
                        (agent.location.y - cel_loc[1])**2)**0.5

                if dist < 60:  # Can see celebrations within 60m
                    nearby_celebrations.append({
                        'id': celebration.id,
                        'type': celebration.celebration_type.value,
                        'name': celebration.celebration_name,
                        'distance': round(dist, 1),
                        'participants_count': len(celebration.participants),
                        'time_remaining': max(0, int(celebration.duration_ticks)),
                        'mood_boost': celebration.mood_boost,
                        'is_participant': agent.id in celebration.participants,
                        'can_join': dist < 20 and agent.id not in celebration.participants
                    })

            nearby_celebrations.sort(key=lambda c: c['distance'])
            fun_info['nearby_celebrations'] = nearby_celebrations

            # Active games nearby
            nearby_games = []
            for game in self.fun_system.active_games.values():
                # Games don't have locations, assume they're at organizer's location
                # For simplicity, show all active games
                if not game.completed:
                    nearby_games.append({
                        'id': game.id,
                        'type': game.game_type.value,
                        'players_count': len(game.players),
                        'spectators_count': len(game.spectators),
                        'is_player': agent.id in game.players,
                        'is_spectator': agent.id in game.spectators,
                        'can_spectate': agent.id not in game.players
                    })

            fun_info['nearby_games'] = nearby_games[:5]

            # Nearby art to view
            nearby_art = []
            for art_piece in self.fun_system.art_pieces.values():
                # Show art that hasn't been viewed yet
                if agent.id not in art_piece.viewers:
                    nearby_art.append({
                        'id': art_piece.id,
                        'type': art_piece.art_type,
                        'title': art_piece.title,
                        'quality': round(art_piece.quality * 100, 1),
                        'viewers_count': len(art_piece.viewers),
                        'cultural_value': round(art_piece.cultural_value, 2)
                    })

            # Sort by quality
            nearby_art.sort(key=lambda a: a['quality'], reverse=True)
            fun_info['art_to_view'] = nearby_art[:5]

            # Can agent create art?
            can_create_art = False
            if hasattr(agent, 'personality'):
                creativity = getattr(agent.personality, 'creativity', 0.5)
                can_create_art = creativity > 0.3

            fun_info['can_create_art'] = can_create_art

            # Agent's fun statistics
            fun_stats = self.fun_system.get_agent_fun_stats(agent.id)
            fun_info['your_fun_stats'] = {
                'celebrations_attended': fun_stats.get('celebrations_attended', 0),
                'games_played': fun_stats.get('games_played', 0),
                'games_won': fun_stats.get('games_won', 0),
                'art_created': fun_stats.get('art_created', 0),
                'fun_score': fun_stats.get('fun_score', 0)
            }

            # Should agent seek fun? (based on mood/happiness)
            should_seek_fun = False
            if hasattr(agent, 'happiness'):
                should_seek_fun = agent.happiness < 0.6
            elif hasattr(agent, \'needs\') and hasattr(agent.needs, \'needs\'):

                # Check if they need social interaction or fun (using NeedType from top-level import)
                social_need = agent.needs.needs.get(NeedType.BELONGING, 1.0)
                friendship_need = agent.needs.needs.get(NeedType.FRIENDSHIP, 1.0)
                should_seek_fun = (social_need < 0.5 or friendship_need < 0.5)

            fun_info['should_seek_fun'] = should_seek_fun

            # Traditions in community
            popular_traditions = []
            for tradition_name, count in sorted(
                self.fun_system.traditions.items(),
                key=lambda x: x[1],
                reverse=True
            )[:3]:
                popular_traditions.append({
                    'tradition': tradition_name.replace('_', ' ').title(),
                    'times_celebrated': count
                })

            fun_info['community_traditions'] = popular_traditions

            perceptions['fun_info'] = fun_info

            # ===== ADD CONSEQUENCES INFORMATION =====
            consequences_info = {}

            # Recent consequences in community (warnings!)
            recent_consequences = []
            for consequence in list(self.consequence_engine.consequences.values())[-20:]:  # Last 20
                # Calculate time since consequence
                time_since = (datetime.now() - consequence.timestamp).total_seconds()

                if time_since < 3600:  # Last hour
                    recent_consequences.append({
                        'type': consequence.consequence_type,
                        'action': consequence.caused_by_action,
                        'severity': round(consequence.severity * 100, 1),
                        'description': consequence.description,
                        'affected_count': len(consequence.affected_agents),
                        'was_affected': agent.id in consequence.affected_agents,
                        'secondary_effects': consequence.secondary_consequences
                    })

            consequences_info['recent_consequences'] = recent_consequences[:5]

            # Agent's past consequences (learn from mistakes!)
            agent_consequences = []
            for consequence in self.consequence_engine.consequences.values():
                if agent.id in consequence.affected_agents:
                    agent_consequences.append({
                        'type': consequence.consequence_type,
                        'action': consequence.caused_by_action,
                        'severity': round(consequence.severity * 100, 1),
                        'description': consequence.description
                    })

            # Show worst consequences experienced
            agent_consequences.sort(key=lambda c: c['severity'], reverse=True)
            consequences_info['your_past_consequences'] = agent_consequences[:3]

            # Risk warnings for common actions
            risk_warnings = {}

            # Evaluate risk of fighting if there are nearby enemies
            combat_risks = scarcity_context_data.get('combat_info', {})
            nearby_enemies = combat_risks.get('nearby_agents', [])

            if nearby_enemies:
                # Get strongest enemy
                strongest = max(nearby_enemies, key=lambda e: e.get('health', 50))
                opponent_strength = strongest.get('health', 50) / 100.0

                fight_risk = self.consequence_engine.evaluate_action_risk(
                    'fight',
                    0.5,  # Default skill
                    {'opponent_strength': opponent_strength}
                )

                if fight_risk['total_risk'] > 0.2:
                    risk_warnings['fight'] = {
                        'total_risk': round(fight_risk['total_risk'] * 100, 1),
                        'main_risks': [
                            {
                                'type': r['type'],
                                'probability': round(r['probability'] * 100, 1),
                                'severity': round(r['severity'] * 100, 1)
                            }
                            for r in fight_risk['risks'][:2]
                        ]
                    }

            # Experimentation risks
            if experimentation_info.get('can_experiment'):
                exp_risk = self.consequence_engine.evaluate_action_risk(
                    'experiment',
                    0.5,
                    {'materials': ['unknown']}
                )

                if exp_risk['total_risk'] > 0.1:
                    risk_warnings['experiment'] = {
                        'total_risk': round(exp_risk['total_risk'] * 100, 1),
                        'warning': 'Experimentation can be dangerous!'
                    }

            consequences_info['current_risk_warnings'] = risk_warnings

            # Learned dangers (from agent memory)
            learned_dangers = []
            if hasattr(agent, 'memory') and hasattr(agent.memory, 'procedural_memory'):
                for risk_key, risk_value in agent.memory.procedural_memory.items():
                    if risk_key.startswith('risk_') and risk_value > 0.6:
                        action_name = risk_key.replace('risk_', '')
                        learned_dangers.append({
                            'action': action_name,
                            'perceived_risk': round(risk_value * 100, 1)
                        })

            learned_dangers.sort(key=lambda d: d['perceived_risk'], reverse=True)
            consequences_info['learned_dangers'] = learned_dangers[:5]

            # Community danger statistics
            danger_stats = self.consequence_engine.get_statistics()

            consequences_info['community_stats'] = {
                'total_deaths': danger_stats.get('deaths', 0),
                'total_bankruptcies': danger_stats.get('bankruptcies', 0),
                'total_consequences': danger_stats.get('total_consequences', 0),
                'most_dangerous_action': danger_stats.get('most_dangerous_action', 'None')
            }

            perceptions['consequences_info'] = consequences_info

            # ===== ADD AGRICULTURE INFORMATION =====
            agriculture_info = {}
            from world.agriculture import Season, CropType, AnimalType

            # Current season and its effects
            current_season = self.agriculture.current_season
            season_effects = self.agriculture.season_effects.get(current_season, {})

            agriculture_info['current_season'] = current_season.value
            agriculture_info['growth_multiplier'] = season_effects.get('growth_multiplier', 1.0)
            agriculture_info['best_for_planting'] = season_effects.get('best_for_planting', False)
            agriculture_info['harvest_season'] = season_effects.get('harvest_season', False)

            # Agent's crops and animals
            agent_fields = [f for f in self.agriculture.crop_fields.values() if f.owner_id == agent.id]
            agent_livestock = [a for a in self.agriculture.domesticated_animals.values() if a.owner_id == agent.id]

            agriculture_info['my_crop_fields'] = len(agent_fields)
            agriculture_info['my_animals'] = len(agent_livestock)

            # Crop maturity
            mature_crops = [f for f in agent_fields if f.growth_progress >= 1.0 and not f.harvested]
            agriculture_info['crops_ready_to_harvest'] = len(mature_crops)

            # Animal products ready
            animals_ready = [a for a in agent_livestock if a.can_harvest_product]
            agriculture_info['animals_ready_for_harvest'] = len(animals_ready)

            # Can plant crops?
            has_seeds = agent.inventory.has_item('seeds')
            agriculture_info['can_plant_crops'] = has_seeds
            agriculture_info['has_seeds'] = has_seeds

            perceptions['agriculture_info'] = agriculture_info

            # ===== ADD HEALTH & DISEASE INFORMATION =====
            health_info = {}
            from world.health import DiseaseType, Severity

            # Agent's diseases
            agent_diseases = self.health.get_agent_diseases(agent.id)
            health_info['is_sick'] = len(agent_diseases) > 0
            health_info['disease_count'] = len(agent_diseases)

            if agent_diseases:
                worst_disease = max(agent_diseases, key=lambda d: d.severity.value if hasattr(d.severity, 'value') else 0)
                health_info['worst_disease'] = worst_disease.disease_type.value
                health_info['worst_severity'] = worst_disease.severity.value

            # Known medicines
            known_medicines = self.health.get_known_medicines()
            health_info['known_medicines_count'] = len(known_medicines)

            # Can heal others?
            agent_is_healer = agent.id in [m.discoverer_id for m in known_medicines if m.discoverer_id]
            health_info['is_healer'] = agent_is_healer

            # Nearby sick agents
            sick_agents_nearby = []
            for other_agent in self.world.agents:
                if other_agent.id == agent.id or not other_agent.alive:
                    continue
                dist = agent.location.distance_to(other_agent.location)
                if dist < 30:
                    other_diseases = self.health.get_agent_diseases(other_agent.id)
                    if other_diseases:
                        sick_agents_nearby.append({
                            'agent_id': other_agent.id,
                            'agent_name': other_agent.name,
                            'disease_count': len(other_diseases),
                            'distance': round(dist, 1)
                        })

            health_info['sick_agents_nearby'] = sick_agents_nearby
            health_info['can_heal_others'] = agent_is_healer and len(sick_agents_nearby) > 0

            perceptions['health_info'] = health_info

            # ===== ADD RELIGION INFORMATION =====
            religion_info = {}

            # Agent's religion
            agent_religion = self.religion.get_agent_religion(agent.id)
            if agent_religion:
                religion_info['my_religion'] = agent_religion.name
                religion_info['my_religion_type'] = agent_religion.religion_type.value
                religion_info['is_priest'] = agent.id in agent_religion.priests
                religion_info['fellow_believers'] = len(agent_religion.followers)
            else:
                religion_info['my_religion'] = None
                religion_info['is_priest'] = False

            # Total religions
            religion_info['total_religions'] = len(self.religion.religions)

            # Can found religion?
            has_no_religion = agent_religion is None
            religion_info['can_found_religion'] = has_no_religion

            # Nearby temples
            nearby_temples = self.religion.get_nearby_temples(
                (agent.location.x, agent.location.y),
                radius=50.0
            )
            religion_info['nearby_temples'] = len(nearby_temples)

            # Active rituals
            religion_info['active_rituals'] = len(self.religion.active_rituals)

            perceptions['religion_info'] = religion_info

            # ===== ADD TERRITORY INFORMATION =====
            territory_info = {}

            # Agent's territories
            agent_territories = self.territory.get_agent_territories(agent.id)
            territory_info['my_territories'] = len(agent_territories)

            # Current location territory
            current_territory = self.territory.get_territory_at_location(
                (agent.location.x, agent.location.y)
            )

            if current_territory:
                territory_info['in_territory'] = True
                territory_info['territory_name'] = current_territory.name
                territory_info['is_my_territory'] = current_territory.owner_id == agent.id
                territory_info['is_trespassing'] = current_territory.owner_id != agent.id and agent.id not in current_territory.allowed_agents
                territory_info['territory_defended'] = current_territory.defended
            else:
                territory_info['in_territory'] = False
                territory_info['is_trespassing'] = False

            # Can claim territory?
            unclaimed_location = current_territory is None
            territory_info['can_claim_here'] = unclaimed_location

            # Nearby territories
            nearby_territories = self.territory.get_nearby_territories(
                (agent.location.x, agent.location.y),
                radius=50.0
            )
            territory_info['nearby_territories'] = len(nearby_territories)

            perceptions['territory_info'] = territory_info

            # ===== ADD CHEMISTRY INFORMATION =====
            chemistry_info = {}

            # Discovered elements
            discovered_elements = self.chemistry.get_discovered_elements()
            chemistry_info['discovered_elements'] = len(discovered_elements)
            chemistry_info['total_elements'] = len(self.chemistry.elements)

            # Element discovery progress
            chemistry_info['element_discovery_percent'] = round(
                (len(discovered_elements) / max(1, len(self.chemistry.elements))) * 100, 1
            )

            # Known compounds
            discovered_compounds = self.chemistry.get_discovered_compounds()
            chemistry_info['discovered_compounds'] = len(discovered_compounds)

            # Can perform chemistry?
            has_materials_for_chemistry = agent.inventory.has_item('wood') or agent.inventory.has_item('iron_ore')
            chemistry_info['can_perform_chemistry'] = has_materials_for_chemistry

            # Can smelt iron?
            can_smelt = agent.inventory.has_item('iron_ore') and agent.inventory.has_item('wood')
            chemistry_info['can_smelt_iron'] = can_smelt

            # Agent's discoveries
            agent_element_discoveries = [e for e in discovered_elements if e.discoverer_id == agent.id]
            chemistry_info['my_element_discoveries'] = len(agent_element_discoveries)

            perceptions['chemistry_info'] = chemistry_info

            # ===== ADD ENERGY INFORMATION =====
            energy_info = {}
            from world.energy import EnergyType

            # Discovered energy sources
            discovered_energy = self.energy.get_discovered_energy_sources()
            energy_info['discovered_energy_sources'] = len(discovered_energy)
            energy_info['available_energy_types'] = [e.value for e in self.energy.discovered_energy_types]

            # Current era progression
            has_fire = EnergyType.FIRE in self.energy.discovered_energy_types
            has_coal = EnergyType.COAL in self.energy.discovered_energy_types
            has_oil = EnergyType.OIL in self.energy.discovered_energy_types
            has_nuclear = EnergyType.NUCLEAR in self.energy.discovered_energy_types

            energy_info['has_fire'] = has_fire
            energy_info['has_coal'] = has_coal
            energy_info['has_oil'] = has_oil
            energy_info['has_nuclear'] = has_nuclear

            # Agent's power plants
            agent_plants = self.energy.get_plants_by_owner(agent.id)
            energy_info['my_power_plants'] = len(agent_plants)

            if agent_plants:
                total_output = sum(p.current_output for p in agent_plants)
                energy_info['my_power_output'] = round(total_output, 1)
            else:
                energy_info['my_power_output'] = 0.0

            # Can build power plant?
            has_materials = agent.inventory.has_item('materials')
            energy_info['can_build_power_plant'] = has_materials

            perceptions['energy_info'] = energy_info

            # ===== ADD MATERIALS SCIENCE INFORMATION =====
            materials_info = {}

            # Current material era
            current_era = self.materials_science.get_current_era()
            materials_info['current_era'] = current_era.value
            materials_info['current_era_name'] = current_era.value.replace('_', ' ').title()

            # Discovered materials
            discovered_mats = self.materials_science.get_discovered_materials()
            materials_info['discovered_materials'] = len(discovered_mats)
            materials_info['total_materials'] = len(self.materials_science.materials)

            # Material discovery progress
            materials_info['material_discovery_percent'] = round(
                (len(discovered_mats) / max(1, len(self.materials_science.materials))) * 100, 1
            )

            # Alloys created
            materials_info['alloys_created'] = len(self.materials_science.discovered_alloys)
            materials_info['total_alloys'] = len(self.materials_science.alloys)

            # Can create alloys?
            can_make_bronze = agent.inventory.has_item('copper') and agent.inventory.has_item('tin')
            can_make_steel = agent.inventory.has_item('iron') and agent.inventory.has_item('carbon')

            materials_info['can_make_bronze'] = can_make_bronze
            materials_info['can_make_steel'] = can_make_steel

            # Can refine materials?
            can_refine = agent.inventory.has_item('iron_ore') or agent.inventory.has_item('sand')
            materials_info['can_refine_materials'] = can_refine

            # Agent's material discoveries
            agent_material_discoveries = [m for m in discovered_mats if m.discoverer_id == agent.id]
            materials_info['my_material_discoveries'] = len(agent_material_discoveries)

            perceptions['materials_info'] = materials_info

            # ===== ADD LIFE & REPRODUCTION INFORMATION =====
            life_info = {}

            # Agent's life profile
            life_profile = self.life_system.get_life_profile(agent.id)
            if life_profile:
                life_info['age'] = agent.age
                life_info['life_stage'] = life_profile.life_stage.value
                life_info['is_pregnant'] = life_profile.is_pregnant
                life_info['children_count'] = len(life_profile.children)
                life_info['partner_id'] = life_profile.partner_id
                life_info['is_in_relationship'] = life_profile.partner_id is not None

                # Pregnancy info
                if life_profile.is_pregnant:
                    life_info['pregnancy_duration'] = life_profile.pregnancy_duration
                    life_info['pregnancy_progress'] = life_profile.pregnancy_progress
                    life_info['due_in_ticks'] = life_profile.pregnancy_duration - life_profile.pregnancy_progress

                # Fertility
                life_info['is_fertile'] = self.life_system.is_fertile(agent)
            else:
                life_info['age'] = agent.age
                life_info['is_fertile'] = False

            # Nearby potential partners
            potential_partners = []
            if not life_profile or not life_profile.partner_id:
                for other_agent in self.world.agents:
                    if other_agent.id == agent.id or not other_agent.alive:
                        continue
                    dist = agent.location.distance_to(other_agent.location)
                    if dist < 20:  # Within romance range
                        other_profile = self.life_system.get_life_profile(other_agent.id)
                        if other_profile and not other_profile.partner_id:
                            if self.life_system.can_reproduce_together(agent, other_agent):
                                potential_partners.append({
                                    'agent_id': other_agent.id,
                                    'agent_name': other_agent.name,
                                    'distance': round(dist, 1),
                                    'age': other_agent.age
                                })

            life_info['potential_partners_nearby'] = len(potential_partners)
            life_info['can_seek_romance'] = len(potential_partners) > 0

            perceptions['life_info'] = life_info

            # ===== ADD ECONOMIC & FINANCIAL INFORMATION =====
            # Complete financial system: wealth, banking, taxation, trade, crises, etc.
            economic_info = self.economy.get_agent_economic_info(
                agent.id,
                agent.wealth,
                agent_income=0.0  # TODO: Track agent income
            )

            # Add accessible economic opportunities
            from economy.minting import CoinType
            from economy.trade_routes import RouteStatus

            # Minting opportunities - can agent mint coins?
            has_metal_ore = (agent.inventory.has_item('copper_ore') or
                           agent.inventory.has_item('silver_ore') or
                           agent.inventory.has_item('gold_ore'))
            economic_info['can_mint_coins'] = has_metal_ore
            economic_info['discovered_coins'] = [c.value for c in self.economy.minting.discovered_coins]

            # Banking opportunities
            economic_info['total_banks'] = len(self.economy.banking.banks)
            nearest_bank = None
            min_distance = float('inf')
            for bank in self.economy.banking.banks.values():
                dist = ((agent.location.x - bank.location[0])**2 +
                       (agent.location.y - bank.location[1])**2)**0.5
                if dist < min_distance:
                    min_distance = dist
                    nearest_bank = bank

            if nearest_bank:
                economic_info['nearest_bank_distance'] = round(min_distance, 1)
                economic_info['can_access_bank'] = min_distance < 30.0
            else:
                economic_info['nearest_bank_distance'] = None
                economic_info['can_access_bank'] = False

            # Trade route opportunities
            active_routes = [r for r in self.economy.trade_routes.trade_routes.values()
                           if r.status == RouteStatus.ACTIVE]
            economic_info['active_trade_routes'] = len(active_routes)

            # Agent's caravans
            agent_caravans = [c for c in self.economy.trade_routes.caravans.values()
                            if c.merchant_id == agent.id]
            economic_info['my_caravans'] = len(agent_caravans)

            # Tax revolts - can join?
            active_revolts = [r for r in self.economy.taxation.tax_revolts.values()
                            if not r.succeeded and agent.id not in r.participants]
            economic_info['active_tax_revolts'] = len(active_revolts)
            economic_info['can_join_revolt'] = len(active_revolts) > 0

            # Investment opportunities (bubbles)
            active_bubbles = [b for b in self.economy.crises.asset_bubbles.values()
                            if not b.burst]
            economic_info['investment_opportunities'] = len(active_bubbles)

            perceptions['economic_info'] = economic_info

            # Initialize current_goal for later use
            current_goal = None

            # ===== AI-POWERED DECISION MAKING =====
            # Use autonomous AI decisions if enabled, otherwise fall back to rule-based
            if self.config.use_llm_decisions and hasattr(agent, 'autonomous_decide'):
                # Make AI-powered decision (handles planning and reflection internally)
                try:
                    action = agent.autonomous_decide(perceptions, current_tick, self.config)
                except Exception as e:
                    logger.error(f"AI decision failed for {agent.name}: {e}")
                    logger.exception(e)
                    # Fall back to rule-based
                    action = agent.decide(perceptions)
            else:
                # Original rule-based decision making
                # Check if agent should pursue strategic goal
                current_goal = self.strategy_manager.get_current_goal(agent.id)
                if current_goal:
                    # Try to advance goal
                    goal_action = self.strategy_manager.evaluate_goal_action(agent, current_goal)
                    if goal_action:
                        # Use goal-directed action
                        action = Action(ActionType.IDLE)  # Placeholder
                        # Map string action to ActionType
                        try:
                            action_type = ActionType(goal_action)
                            action = Action(action_type)
                        except:
                            action = agent.decide(perceptions)
                    else:
                        action = agent.decide(perceptions)
                else:
                    # Agent decides action normally
                    action = agent.decide(perceptions)

            # ===== PURPOSEFUL ACTION SYSTEM =====
            # This creates TRUE PURPOSE - every action has meaning!

            # 1. Capture agent state BEFORE action
            needs_before = agent.needs
            life_sat_before = needs_before.get_overall_satisfaction()

            # 2. Evaluate WHY agent is doing this (purpose evaluation)
            action_name = action.action_type.value if hasattr(action.action_type, 'value') else str(action.action_type)

            # Get agent's skill levels as dict
            agent_skills = {
                name: skill.level
                for name, skill in agent.skills.skills.items()
            }

            # Generate purpose - the FULL reasoning
            try:
                purpose = self.purposeful_evaluator.evaluate_purpose(
                    action=action_name,
                    agent_needs=agent.needs,
                    agent_personality=agent.personality,
                    agent_skills=agent_skills,
                    context={}
                )

                # Store purpose with agent (visible in UI!)
                agent.current_action_purpose = {
                    'action': action_name,
                    'primary_need': purpose.primary_need.value,
                    'primary_urgency': purpose.primary_need_urgency,
                    'personality_fit': purpose.personality_fit,
                    'skill_level': purpose.skill_level,
                    'reasoning': purpose.reasoning_summary,
                    'expected_satisfaction': purpose.expected_life_satisfaction_change
                }
            except Exception as e:
                # Fallback if evaluation fails
                agent.current_action_purpose = None

            # 3. Execute action
            outcome = await self.execute_action(agent, action)

            # 4. Capture agent state AFTER action
            needs_after = agent.needs
            life_sat_after = needs_after.get_overall_satisfaction()

            # 5. Measure ACTUAL outcome (success/failure)
            if agent.current_action_purpose:
                try:
                    action_outcome = self.purposeful_evaluator.measure_outcome(
                        purpose=purpose,
                        action_succeeded=outcome.get('success', False),
                        agent_needs_before=needs_before,
                        agent_needs_after=needs_after,
                        context={
                            'action': action_name,
                            'what_happened': outcome.get('reason', 'Action completed'),
                            'wealth_change': outcome.get('wealth_change', 0.0),
                            'resources_gained': outcome.get('resources_gained', {}),
                            'resources_lost': outcome.get('resources_lost', {})
                        }
                    )

                    # Store outcome with agent (for learning & UI)
                    outcome_data = {
                        'action': action_name,
                        'succeeded': action_outcome.succeeded,
                        'life_satisfaction_delta': action_outcome.life_satisfaction_delta,
                        'need_changes': {nt.value: change for nt, change in action_outcome.need_changes.items()},
                        'skill_growth': action_outcome.skill_growth,
                        'lesson_learned': action_outcome.lesson_learned,
                        'success_score': self._calculate_success_score(action_outcome)
                    }

                    # Add to recent outcomes (keep last 10)
                    agent.recent_action_outcomes.append(outcome_data)
                    if len(agent.recent_action_outcomes) > 10:
                        agent.recent_action_outcomes = agent.recent_action_outcomes[-10:]

                    # Track life satisfaction over time
                    agent.life_satisfaction_history.append(life_sat_after)
                    if len(agent.life_satisfaction_history) > 50:
                        agent.life_satisfaction_history = agent.life_satisfaction_history[-50:]

                    # Track decision quality
                    agent.decision_quality_scores.append(outcome_data['success_score'])
                    if len(agent.decision_quality_scores) > 10:
                        agent.decision_quality_scores = agent.decision_quality_scores[-10:]

                except Exception as e:
                    # Fallback if outcome measurement fails
                    pass

            # 6. Agent learns from outcome (existing system)
            agent.learn_from_outcome(action, outcome)

            # TRACK ACTION FOR ROLE EMERGENCE - Pure behavioral observation!
            # Record what agent actually did (not what they're "supposed" to do)
            if outcome.get('success', False):
                action_name = action.action_type.value if hasattr(action.action_type, 'value') else str(action.action_type)
                self.role_emergence.record_action(agent.id, action_name)

            # Update goal progress if relevant
            if current_goal:
                progress_amount = 0.1 if outcome.get('success', False) else 0.0
                self.strategy_manager.update_goal_progress(
                    agent.id, current_goal.id, progress_amount, outcome
                )

        # Update economy - FULL ECONOMIC ENGINE!
        # Includes: minting, banking, taxation, trade routes, crises, wealth distribution
        economic_events = self.economy.tick_update(current_tick, self.world.agents)

        # Check for currency evolution (barter → commodity → coins)
        currency_message = self.economy.check_currency_evolution(current_tick)
        if currency_message:
            logger.info(currency_message)
            self.event_logger.log_event(
                EventCategory.ECONOMIC,
                EventImportance.MAJOR,
                "Currency Evolution",
                currency_message,
                current_tick,
                []
            )

        # Log major economic events
        if economic_events.get('defaulted_loans'):
            for loan in economic_events['defaulted_loans']:
                logger.warning(f"💸 Loan default: {loan.borrower_id} failed to repay {loan.amount_remaining:.0f}")

        if economic_events.get('crisis_events'):
            for crisis in economic_events['crisis_events']:
                logger.warning(f"📉 Economic crisis: {crisis.get('type', 'unknown')}")

        # ROLE EMERGENCE - Let agents discover their specializations!
        # Check every 50 ticks (faster role development while still meaningful)
        current_tick = self.world.time.current_tick
        if current_tick % 50 == 0:
            for agent in self.world.agents:
                if not agent.alive:
                    continue

                # Detect behavior patterns
                patterns = self.role_emergence.detect_behavior_patterns(agent.id)

                for pattern in patterns:
                    # Check if agent hasn't already discovered this role
                    existing_roles = self.role_emergence.agent_roles.get(agent.id, [])
                    pattern_exists = any(
                        r.behavior_pattern.pattern_type == pattern.pattern_type
                        for r in existing_roles
                    )

                    if not pattern_exists and pattern.pattern_strength > 0.30:
                        # AGENT DISCOVERS ROLE!
                        # Agent creates their own meaningful role name based on:
                        # - What they actually do (behavior pattern)
                        # - Their personality and experiences
                        # - Cultural context
                        agent_role_name = self.role_emergence.generate_agent_role_name(
                            pattern,
                            agent_personality={'openness': agent.personality.openness if hasattr(agent, 'personality') else 0.5},
                            agent_recent_discoveries=None,  # Could track discoveries
                            agent_culture_context=None  # Could track cultural influences
                        )

                        # Agent discovers and names their role
                        role = self.role_emergence.agent_discovers_role(
                            agent.id,
                            agent.name,
                            pattern,
                            agent_generated_name=agent_role_name
                        )

                        if role:
                            # Log role emergence event!
                            title = f"{agent.name} becomes {agent_role_name}!"
                            desc = f"{agent.name} has specialized in {', '.join(pattern.dominant_actions)} and now identifies as a {agent_role_name}."
                            self.event_logger.log_event(
                                EventCategory.CULTURAL,
                                EventImportance.MODERATE,
                                title, desc,
                                current_tick,
                                [agent.id]
                            )

        # Remove dead agents after some time
        self._handle_deaths()

        # ===== POPULATION HISTORY TRACKING =====
        self._update_population_history()

        # ===== AUTO-SAVE & DEATH WIPE DETECTION =====
        current_tick = self.world.time.current_tick
        alive_count = sum(1 for a in self.world.agents if a.alive)

        # Death wipe detection - all agents died!
        if alive_count == 0 and len(self.world.agents) > 0 and not self.death_wipe_detected:
            self.death_wipe_detected = True

            print("\n" + "="*60)
            print("💀 CIVILIZATION EXTINCTION EVENT 💀")
            print("="*60)
            print(f"All {len(self.world.agents)} agents have died!")
            print(f"Civilization lasted {self.world.time.day} days ({current_tick} ticks)")
            print(f"Era: {self.civilization.current_era.value}")
            print(f"Total discoveries: {len(self.experimentation_engine.discoveries)}")
            print(f"Total buildings: {len(self.dynamic_building_system.buildings)}")
            print(f"Total knowledge: {len(self.knowledge_system.knowledge_records)}")

            # Analyze what happened
            print("\n🔍 EXTINCTION ANALYSIS:")

            # Find last deaths
            recent_deaths = [a for a in self.world.agents
                           if not a.alive and a.ticks_lived > 0]
            if recent_deaths:
                avg_age_at_death = sum(a.age for a in recent_deaths) / max(1, len(recent_deaths))
                print(f"  Average age at death: {avg_age_at_death:.1f} years")

                # Check causes
                died_young = sum(1 for a in recent_deaths if a.age < 50)
                died_old = sum(1 for a in recent_deaths if a.age >= 100)
                died_health = len(recent_deaths) - died_young - died_old

                print(f"  Death causes:")
                print(f"    - Health issues: {died_health}")
                print(f"    - Old age (100+): {died_old}")
                print(f"    - Young deaths (<50): {died_young}")

            # Check resource situation
            if hasattr(self.world, 'resource_pools'):
                pools = self.world.resource_pools
                depleted = sum(1 for v in pools.values() if v < 10)
                print(f"\n  Resource situation:")
                print(f"    - Depleted resources: {depleted}/{len(pools)}")
                for name, amount in sorted(pools.items(), key=lambda x: x[1])[:3]:
                    print(f"    - {name}: {amount:.1f}")

            # Export civilization history
            if not self.civilization_history_exported:
                try:
                    history_path = self.persistence.export_civilization_history(
                        self,
                        output_file=f"extinction_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
                    )
                    print(f"\n📜 Civilization history exported to: {history_path}")
                    self.civilization_history_exported = True
                except Exception as e:
                    print(f"\n❌ Failed to export history: {e}")

            # Save final state
            try:
                snapshot = self.persistence.save_simulation_state(
                    self,
                    snapshot_name=f"extinction_tick_{current_tick}"
                )
                print(f"💾 Final state saved: {snapshot.snapshot_id}")
            except Exception as e:
                print(f"❌ Failed to save final state: {e}")

            print("\n" + "="*60)
            print("Simulation will continue running for observation...")
            print("="*60 + "\n")

        # Auto-save every 1000 ticks (if agents are alive)
        elif alive_count > 0 and current_tick - self.last_auto_save_tick >= 1000:
            try:
                snapshot = self.persistence.save_simulation_state(self)
                self.last_auto_save_tick = current_tick
                print(f"\n💾 Auto-save: {snapshot.snapshot_id} (Day {self.world.time.day}, {alive_count} alive)")
            except Exception as e:
                print(f"❌ Auto-save failed: {e}")

        # Warning if population is declining dangerously
        if alive_count > 0 and alive_count < 10 and not self.death_wipe_detected:
            print(f"\n⚠️  WARNING: Only {alive_count} agents remain! Civilization at risk!")

    async def execute_action(self, agent: Agent, action: Action) -> Dict:
        """
        Execute an agent's action using the modular handler system.

        This method now uses the ActionHandlerRegistry for covered action types,
        with fallback to legacy code for actions not yet migrated to handlers.
        """
        current_tick = self.world.time.current_tick

        # Try handler registry first
        handler = self._handler_registry.get_handler(action.action_type)
        if handler:
            # Validate action can be performed
            can_execute, reason = handler.validate(agent, action)
            if not can_execute:
                return {
                    'success': False,
                    'emotional_impact': -0.05,
                    'message': reason
                }

            # Execute via handler
            result = handler.execute(agent, action)

            # Special post-processing for certain actions
            if action.action_type == ActionType.SEEK_ROMANCE and result.success:
                # Handle reproduction (special case not in handler)
                result_dict = result.to_dict()
                if result_dict.get('reproduction_attempted'):
                    target = self._get_agent_by_id(action.target_agent)
                    if target:
                        child_data = self.life_system.attempt_reproduction(
                            agent.id,
                            target.id,
                            agent.age,
                            target.age,
                            agent.wealth,
                            target.wealth
                        )
                        if child_data:
                            self._handle_birth(agent, target, child_data, current_tick)
                            result_dict['child_born'] = True
                            result_dict['child_id'] = child_data['id']
                return result_dict

            return result.to_dict()

        # ===== FALLBACK TO LEGACY CODE FOR UNMIGRATED ACTIONS =====
        # TODO: Remove this section once all actions have handlers

        # Movement actions
        if action.action_type in [ActionType.MOVE, ActionType.EXPLORE]:
            if action.target_position:
                agent.location = agent.location.move_toward(
                    action.target_position,
                    distance=2.0
                )
            return {'success': True, 'emotional_impact': 0.0}

        # Resource gathering
        elif action.action_type == ActionType.GATHER_FOOD:
            return self.interaction_handler.handle_gather_food(
                agent, action.target_position, current_tick
            )

        elif action.action_type == ActionType.GATHER_MATERIALS:
            return self.interaction_handler.handle_gather_materials(
                agent, current_tick
            )

        # Specialized resource gathering - agents learn what they need!
        elif action.action_type == ActionType.CHOP_WOOD:
            return self.interaction_handler.handle_chop_wood(agent)

        elif action.action_type == ActionType.MINE:
            return self.interaction_handler.handle_mine(agent)

        elif action.action_type == ActionType.HUNT:
            return self.interaction_handler.handle_hunt(agent)

        elif action.action_type == ActionType.GATHER_WATER:
            return self.interaction_handler.handle_gather_water(agent, current_tick)

        # Rest
        elif action.action_type == ActionType.REST:
            return self.interaction_handler.handle_rest(agent)

        # Eating and drinking
        elif action.action_type == ActionType.EAT:
            if agent.inventory.has_item('food'):
                food_before = agent.inventory.items.get('food', 0)
                hunger_before = agent.needs.needs.get(NeedType.HUNGER).level if agent.needs.needs.get(NeedType.HUNGER) else 0.0
                agent.inventory.remove_item('food', 1)
                agent.needs.satisfy_need(NeedType.HUNGER, 0.5)  # Eating satisfies 50% of hunger
                hunger_after = agent.needs.needs.get(NeedType.HUNGER).level if agent.needs.needs.get(NeedType.HUNGER) else 0.0
                logger.info(f"[{agent.name}] EXECUTED EAT: food {food_before}→{food_before-1}, hunger {hunger_before:.2f}→{hunger_after:.2f}")
                return {'success': True, 'emotional_impact': 0.3, 'message': f'{agent.name} ate food'}
            else:
                logger.warning(f"[{agent.name}] FAILED TO EAT: No food in inventory!")
                return {'success': False, 'emotional_impact': -0.1, 'message': 'No food to eat'}

        elif action.action_type == ActionType.DRINK:
            if agent.inventory.has_item('water'):
                agent.inventory.remove_item('water', 1)
                agent.needs.satisfy_need(NeedType.THIRST, 0.5)  # Drinking satisfies 50% of thirst
                return {'success': True, 'emotional_impact': 0.3, 'message': f'{agent.name} drank water'}
            else:
                return {'success': False, 'emotional_impact': -0.1, 'message': 'No water to drink'}

        # Social interactions
        elif action.action_type == ActionType.SOCIALIZE:
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target:
                    return self.interaction_handler.handle_socialize(
                        agent, target, current_tick
                    )

        elif action.action_type == ActionType.SEEK_ROMANCE:
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target:
                    outcome = self.interaction_handler.handle_romance(
                        agent, target, current_tick
                    )

                    # REPRODUCTION ATTEMPT - If romance succeeds!
                    if outcome.get('success') and outcome.get('reproduction_attempted'):
                        # Try to create a child
                        child_data = self.life_system.attempt_reproduction(
                            agent.id,
                            target.id,
                            agent.age,
                            target.age,
                            agent.wealth,
                            target.wealth
                        )

                        if child_data:
                            # BABY BORN! 👶
                            self._handle_birth(agent, target, child_data, current_tick)
                            outcome['child_born'] = True
                            outcome['child_id'] = child_data['id']

                    return outcome

        # Economic
        elif action.action_type == ActionType.TRADE:
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target:
                    return self.interaction_handler.handle_trade(
                        agent, target, current_tick
                    )

        # ===== AUTONOMOUS SYSTEMS - TRUE FREEDOM! =====

        # EXPERIMENTATION - Discover new materials!
        elif action.action_type == ActionType.EXPERIMENT:
            # Agent experiments with materials they have
            available_materials = list(agent.inventory.items.keys())
            if len(available_materials) >= 2:
                # GUIDE EXPERIMENTATION toward milestone materials!
                # Agents will naturally try combinations that lead to progress

                # Pick 2-3 materials to combine
                num_materials = min(random.randint(2, 3), len(available_materials))

                # In Stone Age, HEAVILY prioritize wood/plant_fiber (needed for fire!)
                if self.civilization.current_era == Era.STONE_AGE:
                    # Build weighted list favoring wood and plant_fiber
                    weighted_materials = []
                    for mat in available_materials:
                        if mat in ['wood', 'plant_fiber']:
                            # Add 5x for fire-making materials
                            weighted_materials.extend([mat] * 5)
                        else:
                            weighted_materials.append(mat)

                    # Sample from weighted list (may have duplicates, so use set)
                    material_names = []
                    attempts = 0
                    while len(material_names) < num_materials and attempts < 20:
                        mat = random.choice(weighted_materials)
                        if mat not in material_names:
                            material_names.append(mat)
                        attempts += 1
                else:
                    # Normal random selection for other eras
                    material_names = random.sample(available_materials, num_materials)

                # Convert to dict with quantities (use 1 for each)
                materials = {name: 1 for name in material_names}

                # Choose method - WEIGHTED toward era-appropriate discoveries
                # Stone Age: favor 'heat' (leads to fire)
                # Bronze Age: favor 'refine' (leads to bronze)
                # Iron Age: favor 'refine' (leads to steel)
                if self.civilization.current_era == Era.STONE_AGE:
                    # AGGRESSIVELY favor heat (fire is the key!)
                    # 90% chance of heat, 10% other methods
                    methods = [ExperimentMethod.HEAT, ExperimentMethod.HEAT, ExperimentMethod.HEAT,
                              ExperimentMethod.HEAT, ExperimentMethod.HEAT, ExperimentMethod.HEAT,
                              ExperimentMethod.HEAT, ExperimentMethod.HEAT, ExperimentMethod.HEAT,
                              ExperimentMethod.MIX]
                elif self.civilization.current_era == Era.BRONZE_AGE:
                    # Favor refine (for metallurgy)
                    methods = [ExperimentMethod.REFINE, ExperimentMethod.REFINE, ExperimentMethod.REFINE,
                              ExperimentMethod.HEAT, ExperimentMethod.HEAT, ExperimentMethod.MIX]
                else:
                    # Balanced for later eras
                    methods = [ExperimentMethod.HEAT, ExperimentMethod.MIX, ExperimentMethod.COMPRESS,
                              ExperimentMethod.REFINE, ExperimentMethod.SHAPE]

                method = random.choice(methods)

                # Try experiment!
                skill = agent.skills.get_skill('crafting')
                result = self.experimentation_engine.attempt_experiment(
                    agent.id,
                    agent.name,
                    materials,
                    method,
                    {'skill': skill, 'location': agent.location}
                )

                if result.success:
                    # Add discovered material to inventory!
                    # Special case: If coins are created, add to wealth instead of inventory
                    if result.discovered_material.name == "coins":
                        # Minting coins! Add to agent's wealth
                        coins_value = 10  # 1 metal = 10 coins (from recipe)
                        agent.wealth += coins_value
                        print(f"💰 {agent.name} minted {coins_value} coins! New wealth: {agent.wealth:.1f}")
                    else:
                        agent.inventory.add_item(result.discovered_material.name, 1)
                    agent.skills.learn_skill('crafting', 0.05)

                    # ===== META-PROGRESSION: Discovery attempts! =====
                    # Intelligent, creative agents might unlock NEW CAPABILITIES!
                    intelligence = (agent.personality.rationality + agent.personality.openness) / 2  # Avg of rationality & openness
                    creativity = agent.personality.creativity
                    knowledge = sum(skill.level for skill in agent.skills.skills.values()) if agent.skills else 0  # Total skill levels

                    meta_discovery = self.meta_progression.attempt_discovery(
                        agent.id,
                        agent.name,
                        current_tick // 144,  # Current day
                        intelligence,
                        creativity,
                        int(knowledge * 100)  # Scale knowledge
                    )

                    if meta_discovery:
                        # 🧬 HOLY SHIT! Agent just unlocked a META-CAPABILITY!
                        print(f"\n{'='*70}")
                        print(f"🧬 META-DISCOVERY! 🧬")
                        print(f"   {meta_discovery.description}")
                        print(f"   Impact: {meta_discovery.impact}")
                        print(f"   New actions available: {', '.join(self.meta_progression.get_available_actions())}")
                        print(f"{'='*70}\n")

                        # Log as CRITICAL event
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.CRITICAL,
                            f"🧬 {agent.name} unlocked {meta_discovery.capability.value}!",
                            f"{meta_discovery.description}\n\n{meta_discovery.impact}\n\nThis changes EVERYTHING.",
                            current_tick,
                            [agent.id]
                        )

                        # Grant MASSIVE rewards - this is civilization-changing!
                        agent.status = min(1.0, agent.status + 0.5)  # +50% status (bigger than milestones!)
                        agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 1.0)
                        agent.needs.satisfy_need(NeedType.RECOGNITION, 1.0)
                        agent.needs.satisfy_need(NeedType.MEANING, 1.0)
                        agent.emotions.emotions[EmotionType.PRIDE].intensity = 1.0
                        agent.emotions.emotions[EmotionType.JOY].intensity = 1.0

                    # CHECK FOR CIVILIZATION MILESTONE!
                    milestone = self.civilization.check_discovery(
                        result.discovered_material.name,
                        agent.id,
                        agent.name
                    )

                    if milestone:
                        # ===== GAME-CHANGING MOMENT! =====
                        # This agent just changed civilization permanently!

                        # Grant massive influence (become a pioneer/legend)
                        agent.status = min(1.0, agent.status + 0.3)  # +30% status

                        # Satisfy needs (achieving milestone is deeply fulfilling)
                        agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.8)
                        agent.needs.satisfy_need(NeedType.RECOGNITION, 0.9)
                        agent.needs.satisfy_need(NeedType.MEANING, 0.7)

                        # Trigger powerful emotions
                        agent.emotions.emotions[EmotionType.PRIDE].intensity = 1.0
                        agent.emotions.emotions[EmotionType.JOY].intensity = 0.9

                        # Log EPIC achievement event
                        title = f"🏆 {agent.name} discovered {milestone.name}!"
                        desc = f"{milestone.impact}\n\nCivilization has advanced to {self.civilization.current_era.value}!\n\nNew resources unlocked: {', '.join(milestone.unlocks_resources)}"
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.CRITICAL,  # Highest importance!
                            title, desc,
                            current_tick,
                            [agent.id]
                        )

                        print(f"\n{'='*60}")
                        print(f"🏆 MILESTONE ACHIEVED! 🏆")
                        print(f"   {agent.name} discovered: {milestone.name}")
                        print(f"   Impact: {milestone.impact}")
                        print(f"   Era: {self.civilization.current_era.value}")
                        print(f"   Production: {self.civilization.get_production_multiplier():.1f}x")

                        # UNLOCK NEW RESOURCES!
                        if milestone.unlocks_resources:
                            print(f"   New resources unlocked: {', '.join(milestone.unlocks_resources)}")
                            for resource_name in milestone.unlocks_resources:
                                # Unlock resource in world with initial amount
                                initial_amounts = {
                                    'metal_ore': 1000.0,  # Fire unlocks metal ore
                                    'iron_ore': 800.0,    # Bronze unlocks iron ore
                                    'coal': 600.0,         # Iron unlocks coal
                                    'oil': 500.0,          # Mill unlocks oil
                                    'electricity': 0.0,    # Steam unlocks electricity (generated)
                                    'rubber': 400.0,
                                    'plastic': 0.0,        # Generated
                                    'advanced_alloy': 300.0,
                                    'rocket_fuel': 200.0
                                }
                                initial_amount = initial_amounts.get(resource_name, 500.0)
                                self.world.unlock_resource(resource_name, initial_amount)

                        print(f"{'='*60}\n")

                    else:
                        # Regular discovery (still good!)
                        title = f"{agent.name} discovered {result.discovered_material.name}!"
                        desc = f"Through experimentation, a new material has been discovered: {result.discovered_material.name}"
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.MAJOR,
                            title, desc,
                            current_tick,
                            [agent.id]
                        )

                    # 🎉 TRIGGER DISCOVERY CELEBRATION!
                    nearby_agents = [a.id for a in self.world.agents if
                                   abs(a.location.x - agent.location.x) < 20 and
                                   abs(a.location.y - agent.location.y) < 20 and
                                   a.id != agent.id]

                    celebration = self.fun_system.trigger_celebration(
                        CelebrationType.DISCOVERY_PARTY,
                        agent.id,
                        agent.name,
                        f"Discovery of {result.discovered_material.name}",
                        (agent.location.x, agent.location.y),
                        nearby_agents
                    )

                    # Log the celebration as an event
                    self.event_logger.log_event(
                        EventCategory.CULTURAL,
                        EventImportance.MODERATE,
                        f"🎉 {celebration.celebration_name}",
                        f"{agent.name} threw a discovery party! {len(celebration.participants)} agents celebrating the discovery of {result.discovered_material.name}.",
                        current_tick,
                        list(celebration.participants)
                    )

                    # Create knowledge record with FULL recipe details!
                    recipe_content = {
                        "inputs": materials,  # What materials are needed
                        "method": method,  # How to combine them (heat, shape, etc.)
                        "output": result.discovered_material.name,  # What you get
                        "properties": [prop.value for prop in result.discovered_properties] if result.discovered_properties else []
                    }
                    self.knowledge_system.create_knowledge(
                        agent.id,
                        'recipe',
                        f"How to make {result.discovered_material.name}",
                        recipe_content  # Include full recipe!
                    )

                    return {'success': True, 'emotional_impact': 0.3}
                else:
                    # FAILURE - Record as knowledge so others can learn!
                    # Build cautionary tale content
                    failure_content = {
                        "attempted_recipe": {
                            "inputs": materials,
                            "method": method
                        },
                        "failure_reason": result.failure_reason,
                        "lesson_learned": result.lesson_learned,
                        "consequences": {
                            "explosion": result.explosion,
                            "fire": result.fire,
                            "injury": result.injury,
                            "materials_lost": result.materials_consumed
                        },
                        "warning": f"Don't {method} {', '.join(materials.keys())} - {result.failure_reason}"
                    }

                    # Create knowledge record of the failure
                    self.knowledge_system.create_knowledge(
                        agent.id,
                        'cautionary_tale',  # Different type for failures
                        f"Failed: {method} with {', '.join(materials.keys())}",
                        failure_content
                    )

                    # Apply consequences if dangerous
                    if result.explosion or result.fire or result.injury:
                        severity = 0.7 if result.explosion else 0.4
                        # NEW: Pass agent object for memory/learning connection
                        self.consequence_engine.apply_consequence(
                            'explosion' if result.explosion else 'fire' if result.fire else 'injury',
                            {agent.id},
                            'experiment',
                            severity,
                            {
                                'had_explosion': result.explosion,
                                'had_fire': result.fire,
                                'current_tick': current_tick
                            },
                            agent_objects=[agent]  # Connect to agent memory!
                        )
                    return {'success': False, 'emotional_impact': -0.2}
            else:
                return {'success': False, 'emotional_impact': -0.1, 'reason': 'not enough materials'}

        # TEACHING - Share knowledge!
        elif action.action_type == ActionType.TEACH:
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target and len(self.knowledge_system.knowledge_records) > 0:
                    # Pick random knowledge agent knows
                    # TODO: Track what each agent knows
                    knowledge_id = random.choice(list(self.knowledge_system.knowledge_records.keys()))

                    teacher_skill = agent.skills.get_skill('teaching')
                    result = self.knowledge_system.oral_transmission(
                        agent.id, target.id, knowledge_id, teacher_skill
                    )

                    if result['success']:
                        agent.skills.learn_skill('teaching', 0.03)
                        return {'success': True, 'emotional_impact': 0.2}

            return {'success': False, 'emotional_impact': 0.0}

        # WRITING - Preserve knowledge!
        elif action.action_type == ActionType.WRITE:
            literacy_skill = agent.skills.get_skill('literacy')
            if literacy_skill > 0.3 and len(self.knowledge_system.knowledge_records) > 0:
                # Agent writes down knowledge
                knowledge_ids = random.sample(
                    list(self.knowledge_system.knowledge_records.keys()),
                    min(3, len(self.knowledge_system.knowledge_records))
                )

                doc = self.knowledge_system.agent_writes_document(
                    agent.id,
                    f"Document by {agent.name}",
                    knowledge_ids,
                    'paper',
                    literacy_skill
                )

                if doc:
                    agent.skills.learn_skill('literacy', 0.05)
                    return {'success': True, 'emotional_impact': 0.25}

            return {'success': False, 'emotional_impact': 0.0}

        # ========== FUN & ENTERTAINMENT ACTIONS ==========
        # Agents initiate fun activities autonomously!

        elif action.action_type == ActionType.GAMBLE:
            # Start a dice gambling game!
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target and target.alive:
                    # Determine stakes - allow gambling even with 0 wealth (for fun/social)!
                    # Stakes = 10% of average wealth, minimum 1 coin (or 0 if both broke)
                    avg_wealth = (agent.wealth + target.wealth) / 2
                    stakes = max(0.0, min(10.0, avg_wealth * 0.1))

                    # Start dice game
                    game = self.fun_system.start_dice_game(
                        players=[(agent.id, agent.name), (target.id, target.name)],
                        stakes=stakes
                    )

                    # Resolve immediately
                    result = self.fun_system.resolve_dice_game(game)

                    if result and 'winner' in result:
                        winner = self._get_agent_by_id(result['winner'])
                        loser = agent if result['winner'] != agent.id else target

                        # Transfer wealth (if any)
                        if stakes > 0:
                            loser.wealth = max(0, loser.wealth - stakes)  # Don't go negative
                            winner.wealth += result['pot']

                        # Emotional impact
                        if result['winner'] == agent.id:
                            agent.emotions.trigger_emotion(EmotionType.JOY, 0.3)
                            target.emotions.trigger_emotion(EmotionType.SADNESS, 0.15)
                            emotional_impact = 0.3
                        else:
                            agent.emotions.trigger_emotion(EmotionType.SADNESS, 0.15)
                            target.emotions.trigger_emotion(EmotionType.JOY, 0.3)
                            emotional_impact = -0.15

                        # Satisfy social/achievement needs
                        agent.needs.satisfy_need(NeedType.BELONGING, 0.2)
                        target.needs.satisfy_need(NeedType.BELONGING, 0.2)
                        winner.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.25)

                        # Log event
                        current_tick = self.world.time.current_tick

                        # Format rolls with agent names instead of IDs
                        rolls_str = f"{agent.name} rolled {result['rolls'].get(agent.id, 0)}, {target.name} rolled {result['rolls'].get(target.id, 0)}"

                        # Format message based on stakes
                        if stakes > 0:
                            outcome_msg = f"{winner.name} won {result['pot']:.1f} coins! {rolls_str}"
                        else:
                            outcome_msg = f"{winner.name} won! {rolls_str} (playing for fun, no wealth yet)"

                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.MINOR,
                            f"🎲 {agent.name} and {target.name} played dice",
                            outcome_msg,
                            current_tick,
                            [agent.id, target.id]
                        )

                        return {'success': True, 'emotional_impact': emotional_impact}

            return {'success': False, 'emotional_impact': 0.0}

        elif action.action_type == ActionType.PLAY_GAME:
            # Start a competitive game (race, contest, etc.)
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target and target.alive:
                    # Determine game type based on agent skills/personality
                    if random.random() < 0.5:
                        # RACE - speed competition
                        agent_speed = agent.skills.get_skill('agility') if hasattr(agent.skills, 'agility') else 0.5
                        target_speed = target.skills.get_skill('agility') if hasattr(target.skills, 'agility') else 0.5

                        game = self.fun_system.start_race(
                            racers=[
                                (agent.id, agent.name, agent_speed),
                                (target.id, target.name, target_speed)
                            ]
                        )

                        # Resolve race
                        result = self.fun_system.resolve_race(
                            game,
                            {agent.id: agent_speed, target.id: target_speed}
                        )

                        if result and 'winner' in result:
                            winner = self._get_agent_by_id(result['winner'])
                            loser = agent if result['winner'] != agent.id else target

                            # Emotional impact
                            if result['winner'] == agent.id:
                                agent.emotions.trigger_emotion(EmotionType.JOY, 0.25)
                                target.emotions.trigger_emotion(EmotionType.SADNESS, 0.1)
                                emotional_impact = 0.25
                            else:
                                agent.emotions.trigger_emotion(EmotionType.SADNESS, 0.1)
                                target.emotions.trigger_emotion(EmotionType.JOY, 0.25)
                                emotional_impact = -0.1

                            # Satisfy needs
                            agent.needs.satisfy_need(NeedType.BELONGING, 0.2)
                            target.needs.satisfy_need(NeedType.BELONGING, 0.2)
                            winner.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.3)
                            winner.status = min(1.0, winner.status + 0.02)  # Small fame boost

                            # Log event
                            current_tick = self.world.time.current_tick
                            self.event_logger.log_event(
                                EventCategory.CULTURAL,
                                EventImportance.MINOR,
                                f"🏃 {agent.name} and {target.name} raced",
                                f"{winner.name} won the race! Times: {agent.name}={result['times'][agent.id]:.1f}s, {target.name}={result['times'][target.id]:.1f}s",
                                current_tick,
                                [agent.id, target.id]
                            )

                            return {'success': True, 'emotional_impact': emotional_impact}
                    else:
                        # Simple game - both have fun
                        agent.emotions.trigger_emotion(EmotionType.JOY, 0.2)
                        target.emotions.trigger_emotion(EmotionType.JOY, 0.2)
                        agent.needs.satisfy_need(NeedType.BELONGING, 0.25)
                        target.needs.satisfy_need(NeedType.BELONGING, 0.25)
                        agent.needs.satisfy_need(NeedType.MEANING, 0.2)
                        target.needs.satisfy_need(NeedType.MEANING, 0.2)

                        current_tick = self.world.time.current_tick
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.TRIVIAL,
                            f"🎮 {agent.name} and {target.name} played together",
                            f"They enjoyed a friendly game together.",
                            current_tick,
                            [agent.id, target.id]
                        )

                        return {'success': True, 'emotional_impact': 0.2}

            return {'success': False, 'emotional_impact': 0.0}

        elif action.action_type == ActionType.CREATE_ART:
            # Agent creates art!
            creativity_skill = agent.personality.creativity
            relevant_skill = agent.skills.get_skill('crafting')

            # Choose art type based on personality
            art_types = ["painting", "sculpture", "song", "story", "dance"]
            if agent.personality.creativity > 0.8:
                art_type = random.choice(art_types)
            else:
                art_type = random.choice(["song", "story"])  # Simpler forms

            # Create the art
            art = self.fun_system.create_art(
                agent.id,
                agent.name,
                art_type,
                creativity_skill,
                relevant_skill
            )

            # Emotional impact based on quality
            emotional_impact = 0.2 + (art.quality * 0.3)
            agent.emotions.trigger_emotion(EmotionType.JOY, emotional_impact)

            # Satisfy creativity need
            agent.needs.satisfy_need(NeedType.CREATIVITY, 0.4)
            agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.3)
            agent.needs.satisfy_need(NeedType.MEANING, 0.2)

            # High quality art increases status
            if art.quality > 0.7:
                agent.status = min(1.0, agent.status + art.fame_generated)

            # Log event
            current_tick = self.world.time.current_tick
            self.event_logger.log_event(
                EventCategory.CULTURAL,
                EventImportance.MODERATE if art.quality > 0.7 else EventImportance.MINOR,
                f"🎨 {agent.name} created art!",
                f"Created '{art.title}' - a {art.art_type} of {art.quality:.0%} quality!",
                current_tick,
                [agent.id]
            )

            return {'success': True, 'emotional_impact': emotional_impact}

        elif action.action_type == ActionType.CELEBRATE:
            # Agent organizes a celebration!
            nearby_agents = [a.id for a in self.world.agents if
                           abs(a.location.x - agent.location.x) < 20 and
                           abs(a.location.y - agent.location.y) < 20 and
                           a.id != agent.id and a.alive]

            celebration = self.fun_system.trigger_celebration(
                CelebrationType.ACHIEVEMENT_PARTY,
                agent.id,
                agent.name,
                "Organized for fun and social bonding",
                (agent.location.x, agent.location.y),
                nearby_agents
            )

            # Immediate mood boost for organizer
            agent.emotions.trigger_emotion(EmotionType.JOY, 0.3)
            agent.needs.satisfy_need(NeedType.BELONGING, 0.3)
            agent.needs.satisfy_need(NeedType.MEANING, 0.25)

            # Log event
            current_tick = self.world.time.current_tick
            self.event_logger.log_event(
                EventCategory.CULTURAL,
                EventImportance.MODERATE,
                f"🎉 {celebration.celebration_name}",
                f"{agent.name} organized a celebration! {len(celebration.participants)} agents are partying!",
                current_tick,
                list(celebration.participants)
            )

            return {'success': True, 'emotional_impact': 0.3}

        elif action.action_type == ActionType.TELL_STORY:
            # Agent tells a story to another agent
            if action.target_agent:
                target = self._get_agent_by_id(action.target_agent)
                if target and target.alive:
                    # Story quality based on agent's experiences and creativity
                    story_quality = agent.personality.creativity * random.uniform(0.7, 1.3)

                    # Both enjoy the interaction
                    agent.emotions.trigger_emotion(EmotionType.JOY, 0.15)
                    target.emotions.trigger_emotion(EmotionType.JOY, 0.15)

                    agent.needs.satisfy_need(NeedType.BELONGING, 0.2)
                    target.needs.satisfy_need(NeedType.BELONGING, 0.2)
                    agent.needs.satisfy_need(NeedType.MEANING, 0.15)
                    target.needs.satisfy_need(NeedType.MEANING, 0.15)

                    # Strengthen relationship
                    self.relationship_manager.update_relationship(
                        agent.id, target.id, 'storytelling', positive=True
                    )

                    # Log event
                    current_tick = self.world.time.current_tick
                    self.event_logger.log_event(
                        EventCategory.CULTURAL,
                        EventImportance.TRIVIAL,
                        f"📖 {agent.name} told {target.name} a story",
                        f"They bonded over storytelling.",
                        current_tick,
                        [agent.id, target.id]
                    )

                    return {'success': True, 'emotional_impact': 0.15}

            return {'success': False, 'emotional_impact': 0.0}

        # BUILDING - Design custom structures based on ACTUAL NEEDS!
        elif action.action_type == ActionType.BUILD:
            # Check if agent is already working on a building
            if agent.active_construction_id:
                # Continue working on existing construction
                building = self.dynamic_building_system.buildings.get(agent.active_construction_id)

                if building and not building.is_complete:
                    # Apply partial labor based on skill and energy
                    skill = agent.skills.get_skill('construction')
                    labor_per_tick = max(5.0, skill * 10.0)  # 5-10 labor per tick

                    completed = self.dynamic_building_system.update_construction(
                        building.id,
                        labor_per_tick
                    )

                    if completed and not building.collapsed:
                        # Building finished! Clear active construction
                        logger.info(f"🏛️ {agent.name} COMPLETED BUILDING: {building.name}")
                        agent.active_construction_id = None
                        agent.skills.learn_skill('construction', 0.05)

                        # Get the purpose from the building design
                        design = self.dynamic_building_system.designs.get(building.design_id)
                        purpose = design.intended_purposes[0] if design and design.intended_purposes else 'general'

                        # CREATE KNOWLEDGE from building completion!
                        materials_list = ", ".join([f"{amt} {mat}" for mat, amt in building.materials_used.items()])

                        # Purpose mapping for better descriptions
                        purpose_descriptions = {
                            'shelter': 'protection from elements and safe resting place',
                            'defense': 'security against threats and territorial control',
                            'storage': 'preserving resources and organizing inventory',
                            'workshop': 'enabling crafting and creative work',
                            'gathering_space': 'fostering community and social bonds'
                        }

                        purpose_desc = purpose_descriptions.get(purpose, 'general utility')
                        skill_level = agent.skills.get_skill('construction')
                        # Calculate labor from construction time (no labor_invested attribute)
                        estimated_labor = design.estimated_build_time if design else 10
                        days_invested = estimated_labor / 24.0

                        knowledge_content = {
                            "building_name": building.name,
                            "purpose": purpose,
                            "purpose_description": purpose_desc,
                            "materials_used": building.materials_used,
                            "materials_list": materials_list,
                            "construction_method": design.construction_method if design else "unknown",
                            "labor_invested": estimated_labor,
                            "days_to_build": round(days_invested, 1),
                            "builder_skill": round(skill_level, 2),
                            "location": {"x": building.location[0], "y": building.location[1]},
                            "lessons": f"{agent.name} constructed {building.name} to provide {purpose_desc}. Using {materials_list}, the structure took {round(days_invested, 1)} days to complete using the {design.construction_method if design else 'basic'} method. This building serves as a vital {purpose} infrastructure for the civilization.",
                            "process": f"1. Gathered materials: {materials_list}\n2. Designed structure for {purpose}\n3. Applied {design.construction_method if design else 'basic'} construction technique\n4. Invested {estimated_labor} labor over {round(days_invested, 1)} days\n5. Completed functional {purpose} building",
                            "outcome": f"Successfully created {building.name} that fulfills {purpose} needs for the settlement"
                        }
                        self.knowledge_system.create_knowledge(
                            agent.id,
                            "building_method",
                            f"How to build {building.name}",
                            knowledge_content
                        )

                        # Satisfy the need that drove the building!
                        if purpose == 'shelter':
                            agent.needs.satisfy_need(NeedType.SHELTER, 0.3)
                        elif purpose == 'defense':
                            agent.needs.satisfy_need(NeedType.SECURITY, 0.3)
                        elif purpose == 'storage':
                            agent.needs.satisfy_need(NeedType.RESOURCES, 0.2)
                        elif purpose == 'workshop':
                            agent.needs.satisfy_need(NeedType.CREATIVITY, 0.3)
                            agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.2)
                        elif purpose == 'gathering_space':
                            agent.needs.satisfy_need(NeedType.BELONGING, 0.3)

                        # Log successful building event
                        title = f"{agent.name} completed {building.name}!"
                        desc = f"After {estimated_labor:.0f} labor invested, {agent.name} has completed a {purpose} structure."
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.MODERATE,
                            title, desc,
                            current_tick,
                            [agent.id]
                        )

                        # 🎉 TRIGGER BUILDING COMPLETION CELEBRATION!
                        nearby_agents = [a.id for a in self.world.agents if
                                       abs(a.location.x - building.location[0]) < 25 and
                                       abs(a.location.y - building.location[1]) < 25 and
                                       a.id != agent.id]

                        celebration = self.fun_system.trigger_celebration(
                            CelebrationType.BUILDING_COMPLETION,
                            agent.id,
                            agent.name,
                            f"Completion of {building.name}",
                            building.location,
                            nearby_agents
                        )

                        # Log the celebration
                        self.event_logger.log_event(
                            EventCategory.CULTURAL,
                            EventImportance.MODERATE,
                            f"🏛️ Grand Opening Celebration",
                            f"{agent.name} celebrates the completion of {building.name}! {len(celebration.participants)} agents attended the grand opening.",
                            current_tick,
                            list(celebration.participants)
                        )

                        # ===== ACHIEVEMENT TRACKING - Building achievements! =====
                        current_day = current_tick // 144
                        self.achievement_tracker.track_agent(agent.id, agent.name)
                        logger.info(f"DEBUG: Tracked agent {agent.name}, agent_achievements has {len(self.achievement_tracker.agent_achievements)} agents")

                        # Update buildings built stat
                        if agent.id in self.achievement_tracker.agent_achievements:
                            current_count = self.achievement_tracker.agent_achievements[agent.id].buildings_built
                            logger.info(f"DEBUG: {agent.name} current buildings: {current_count}, updating to {current_count + 1}")
                            self.achievement_tracker.update_agent_stat(agent.id, 'buildings_built', current_count + 1)

                            # Check for building achievements
                            building_achievements = self.achievement_tracker.check_agent_achievements(agent.id, current_day)
                            logger.info(f"DEBUG: Checked achievements for {agent.name}, found {len(building_achievements)} new achievements")
                            for ach in building_achievements:
                                logger.info(f"🏆 {agent.name} unlocked: {ach.name}")

                                # Generate achievement story
                                achievement_story = self.story_generator.generate_achievement_story(
                                    agent.name,
                                    ach.achievement_type.value,
                                    current_day,
                                    {
                                        'agent_id': agent.id,
                                        'building_count': current_count + 1
                                    }
                                )
                                self.story_feed.add_story(achievement_story)

                        return {'success': True, 'emotional_impact': 0.3}
                    elif building.collapsed:
                        # Building collapsed!
                        agent.active_construction_id = None
                        return {'success': False, 'emotional_impact': -0.2}
                    else:
                        # Still working...
                        return {'success': True, 'emotional_impact': 0.05, 'message': 'Working on construction'}
                else:
                    # Building no longer exists or is complete
                    agent.active_construction_id = None

            # Start new construction
            available_materials = agent.inventory.items
            if len(available_materials) >= 2:
                # NEED-BASED BUILDING - Choose purpose based on agent's urgent needs!
                purpose = self._determine_building_purpose(agent)

                if not purpose:
                    # No urgent building need right now
                    return {'success': False, 'emotional_impact': 0.0, 'message': 'No building need'}

                skill = agent.skills.get_skill('construction')
                # Pass civilization era for proper resource scaling!
                # CRITICAL FIX: Pass agent's actual inventory for realistic building design!
                agent_inventory_items = agent.inventory.items if hasattr(agent.inventory, 'items') else {}
                design = self.dynamic_building_system.agent_designs_building(
                    agent.id,
                    agent.name,
                    [purpose],
                    available_materials,
                    skill,
                    self.civilization.current_era.value,
                    agent_inventory_items  # NEW: Agent's actual inventory
                )

                if design:
                    # Try to build it!
                    building = self.dynamic_building_system.start_construction(
                        design.id,
                        (agent.location.x, agent.location.y),
                        {agent.id},
                        available_materials,
                        builder_agent=agent  # CRITICAL FIX: Pass agent to consume materials!
                    )

                    if building:
                        # Set this as the active construction project
                        agent.active_construction_id = building.id

                        # Apply first tick of labor
                        labor_per_tick = max(5.0, skill * 10.0)
                        completed = self.dynamic_building_system.update_construction(
                            building.id,
                            labor_per_tick  # Partial labor, not full!
                        )

                        if completed and not building.collapsed:
                            # Simple building completed in one tick!
                            agent.active_construction_id = None
                            agent.skills.learn_skill('construction', 0.05)

                            # CREATE KNOWLEDGE from building completion!
                            materials_list = ", ".join([f"{amt} {mat}" for mat, amt in building.materials_used.items()])

                            # Purpose mapping for better descriptions
                            purpose_descriptions = {
                                'shelter': 'protection from elements and safe resting place',
                                'defense': 'security against threats and territorial control',
                                'storage': 'preserving resources and organizing inventory',
                                'workshop': 'enabling crafting and creative work',
                                'gathering_space': 'fostering community and social bonds'
                            }

                            purpose_desc = purpose_descriptions.get(purpose, 'general utility')
                            skill_level = agent.skills.get_skill('construction')
                            # Calculate labor from construction time (no labor_invested attribute)
                            estimated_labor = design.estimated_build_time if design else 10
                            days_invested = estimated_labor / 24.0

                            knowledge_content = {
                                "building_name": building.name,
                                "purpose": purpose,
                                "purpose_description": purpose_desc,
                                "materials_used": building.materials_used,
                                "materials_list": materials_list,
                                "construction_method": design.construction_method if design else "unknown",
                                "labor_invested": estimated_labor,
                                "days_to_build": round(days_invested, 1),
                                "builder_skill": round(skill_level, 2),
                                "location": {"x": building.location[0], "y": building.location[1]},
                                "lessons": f"{agent.name} constructed {building.name} to provide {purpose_desc}. Using {materials_list}, the structure took {round(days_invested, 1)} days to complete using the {design.construction_method if design else 'basic'} method. This building serves as a vital {purpose} infrastructure for the civilization.",
                                "process": f"1. Gathered materials: {materials_list}\n2. Designed structure for {purpose}\n3. Applied {design.construction_method if design else 'basic'} construction technique\n4. Invested {estimated_labor} labor over {round(days_invested, 1)} days\n5. Completed functional {purpose} building",
                                "outcome": f"Successfully created {building.name} that fulfills {purpose} needs for the settlement"
                            }
                            self.knowledge_system.create_knowledge(
                                agent.id,
                                "building_method",
                                f"How to build {building.name}",
                                knowledge_content
                            )

                            # Satisfy the need that drove the building!
                            if purpose == 'shelter':
                                agent.needs.satisfy_need(NeedType.SHELTER, 0.3)
                            elif purpose == 'defense':
                                agent.needs.satisfy_need(NeedType.SECURITY, 0.3)
                            elif purpose == 'storage':
                                agent.needs.satisfy_need(NeedType.RESOURCES, 0.2)
                            elif purpose == 'workshop':
                                agent.needs.satisfy_need(NeedType.CREATIVITY, 0.3)
                                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.2)
                            elif purpose == 'gathering_space':
                                agent.needs.satisfy_need(NeedType.BELONGING, 0.3)

                            # Log successful building event with PURPOSE REASONING
                            title = f"{agent.name} built {design.name}!"
                            desc = f"A new {purpose} structure has been constructed to satisfy {agent.name}'s {purpose.upper()} need. Materials used: {sum(building.materials_used.values())} total."
                            self.event_logger.log_event(
                                EventCategory.CULTURAL,
                                EventImportance.MODERATE,
                                title, desc,
                                current_tick,
                                [agent.id]
                            )

                            # 🎉 TRIGGER BUILDING COMPLETION CELEBRATION!
                            nearby_agents = [a.id for a in self.world.agents if
                                           abs(a.location.x - building.location[0]) < 25 and
                                           abs(a.location.y - building.location[1]) < 25 and
                                           a.id != agent.id]

                            celebration = self.fun_system.trigger_celebration(
                                CelebrationType.BUILDING_COMPLETION,
                                agent.id,
                                agent.name,
                                f"Completion of {building.name}",
                                building.location,
                                nearby_agents
                            )

                            # Log the celebration
                            self.event_logger.log_event(
                                EventCategory.CULTURAL,
                                EventImportance.MODERATE,
                                f"🏛️ Grand Opening Celebration",
                                f"{agent.name} celebrates the completion of {building.name}! {len(celebration.participants)} agents attended the grand opening.",
                                current_tick,
                                list(celebration.participants)
                            )

                            return {'success': True, 'emotional_impact': 0.3}
                        elif building.collapsed:
                            agent.active_construction_id = None
                            # Building collapsed during construction!
                            # NEW: Pass agent object for memory/learning connection
                            self.consequence_engine.apply_consequence(
                                'building_collapse',
                                {agent.id},
                                'build',
                                0.5,
                                {
                                    'building_name': design.name,
                                    'current_tick': current_tick
                                },
                                agent_objects=[agent]  # Connect to agent memory!
                            )
                            return {'success': False, 'emotional_impact': -0.3}
                        else:
                            # Still under construction - normal for multi-tick building!
                            return {'success': True, 'emotional_impact': 0.05, 'message': 'Started construction'}
                    else:
                        # Building construction failed to start
                        return {'success': False, 'emotional_impact': -0.2}

            return {'success': False, 'emotional_impact': 0.0}

        # ===== WARFARE & COMBAT SYSTEM =====
        elif action.action_type == ActionType.FIGHT:
            if not action.target_agent:
                return {'success': False, 'emotional_impact': 0.0, 'reason': 'No target specified'}

            target = self._get_agent_by_id(action.target_agent)
            if not target or not target.alive:
                return {'success': False, 'emotional_impact': 0.0, 'reason': 'Target not found or dead'}

            # Determine conflict reason (from parameters or context)
            from world.conflict import ConflictReason
            reason = action.parameters.get('reason', ConflictReason.RESOURCES)
            if isinstance(reason, str):
                try:
                    reason = ConflictReason(reason)
                except ValueError:
                    reason = ConflictReason.RESOURCES

            # Initiate duel
            conflict = self.warfare_manager.initiate_duel(
                agent.id,
                target.id,
                reason
            )

            # Log conflict start
            logger.info(f"⚔️ {agent.name} initiated combat with {target.name} (reason: {reason.value})")
            self.event_logger.log_event(
                EventCategory.CONFLICT,
                EventImportance.MAJOR,
                f"⚔️ Combat: {agent.name} vs {target.name}",
                f"{agent.name} challenged {target.name} to combat over {reason.value}!",
                current_tick,
                [agent.id, target.id]
            )

            # Resolve combat immediately (single turn resolution for now)
            # Get all agents dict for combat resolution
            agents_dict = {a.id: a for a in self.world.agents if a.alive}
            combat_result = self.warfare_manager.resolve_combat_turn(
                conflict.id,
                agents_dict
            )

            # Apply emotional impacts
            if combat_result.get('status') == 'ended':
                winner = combat_result.get('winner')

                if winner == 'side_a':
                    # Agent won!
                    agent.emotions.trigger_emotion(EmotionType.PRIDE, 0.7)
                    agent.emotions.trigger_emotion(EmotionType.JOY, 0.5)
                    agent.needs.satisfy_need(NeedType.STATUS, 0.4)
                    agent.skills.learn_skill('combat', 0.1)

                    target.emotions.trigger_emotion(EmotionType.SADNESS, 0.6)
                    target.emotions.trigger_emotion(EmotionType.FEAR, 0.5)
                    target.needs.satisfy_need(NeedType.SECURITY, -0.5)

                    emotional_impact = 0.3

                    logger.info(f"⚔️ {agent.name} defeated {target.name} in combat!")
                    self.event_logger.log_event(
                        EventCategory.CONFLICT,
                        EventImportance.MAJOR,
                        f"🏆 {agent.name} victorious!",
                        f"{agent.name} defeated {target.name} in combat. Victory over {reason.value}!",
                        current_tick,
                        [agent.id, target.id]
                    )

                else:
                    # Agent lost!
                    agent.emotions.trigger_emotion(EmotionType.SADNESS, 0.6)
                    agent.emotions.trigger_emotion(EmotionType.FEAR, 0.5)
                    agent.needs.satisfy_need(NeedType.SECURITY, -0.5)

                    target.emotions.trigger_emotion(EmotionType.PRIDE, 0.7)
                    target.emotions.trigger_emotion(EmotionType.JOY, 0.5)
                    target.needs.satisfy_need(NeedType.STATUS, 0.4)
                    target.skills.learn_skill('combat', 0.1)

                    emotional_impact = -0.4

                    logger.info(f"⚔️ {target.name} defeated {agent.name} in combat!")
                    self.event_logger.log_event(
                        EventCategory.CONFLICT,
                        EventImportance.MAJOR,
                        f"🏆 {target.name} victorious!",
                        f"{target.name} defeated {agent.name} in combat.",
                        current_tick,
                        [agent.id, target.id]
                    )

                # Check for casualties
                casualties = combat_result.get('casualties', [])
                if agent.id in casualties:
                    logger.warning(f"💀 {agent.name} died in combat!")
                if target.id in casualties:
                    logger.warning(f"💀 {target.name} died in combat!")

                return {'success': True, 'emotional_impact': emotional_impact, 'combat_result': combat_result}
            else:
                # Combat ongoing (shouldn't happen with single-turn resolution)
                return {'success': True, 'emotional_impact': 0.1, 'combat_result': combat_result}

        # ===== GOVERNANCE & POLITICS SYSTEM =====
        elif action.action_type == ActionType.GOVERN:
            # Agent attempts to form or lead a government
            from world.governance import GovernmentType

            # Check if agent has the charisma/influence to form government
            charisma = agent.personality.charisma if hasattr(agent.personality, 'charisma') else 0.5
            power = self.governance_manager.political_power.get(agent.id, 0.0)

            if charisma < 0.5 and power < 0.3:
                return {'success': False, 'emotional_impact': -0.2, 'reason': 'Not influential enough'}

            # Determine government type based on personality
            if agent.personality.dominance > 0.7:
                gov_type = GovernmentType.STRONGMAN
            elif agent.personality.conscientiousness > 0.7:
                gov_type = GovernmentType.COUNCIL
            elif agent.personality.openness > 0.7:
                gov_type = GovernmentType.DEMOCRACY
            else:
                gov_type = GovernmentType.OLIGARCHY

            # Get government name from parameters or generate
            gov_name = action.parameters.get('name', f"{agent.name}'s Government")

            # Form government
            government = self.governance_manager.agent_forms_government(
                founder_id=agent.id,
                name=gov_name,
                gov_type=gov_type
            )

            logger.info(f"🏛️ {agent.name} formed {gov_name} ({gov_type.value})")
            self.event_logger.log_event(
                EventCategory.POLITICAL,
                EventImportance.MAJOR,
                f"🏛️ New Government: {gov_name}",
                f"{agent.name} established a new {gov_type.value} government!",
                current_tick,
                [agent.id]
            )

            # Emotional impact
            agent.emotions.trigger_emotion(EmotionType.PRIDE, 0.8)
            agent.emotions.trigger_emotion(EmotionType.JOY, 0.6)
            agent.needs.satisfy_need(NeedType.STATUS, 0.5)

            return {'success': True, 'emotional_impact': 0.7, 'government': government}

        elif action.action_type == ActionType.MAKE_LAW:
            # Agent proposes a new law
            government_id = action.parameters.get('government_id')
            law_name = action.parameters.get('law_name', 'Untitled Law')
            law_description = action.parameters.get('description', '')
            prohibition = action.parameters.get('prohibition')
            requirement = action.parameters.get('requirement')

            if not government_id:
                # Try to find agent's government
                for gov_id, gov in self.governance_manager.governments.items():
                    if agent.id in gov.citizens:
                        government_id = gov_id
                        break

            if not government_id:
                return {'success': False, 'emotional_impact': -0.1, 'reason': 'Not part of any government'}

            # Attempt to create law
            law = self.governance_manager.agent_creates_law(
                creator_id=agent.id,
                government_id=government_id,
                name=law_name,
                description=law_description,
                prohibition=prohibition,
                requirement=requirement
            )

            if not law:
                return {'success': False, 'emotional_impact': -0.2, 'reason': 'Insufficient authority to make laws'}

            logger.info(f"📜 {agent.name} proposed law: {law_name}")
            self.event_logger.log_event(
                EventCategory.POLITICAL,
                EventImportance.MODERATE,
                f"📜 New Law Proposed: {law_name}",
                f"{agent.name} proposed: {law_description}",
                current_tick,
                [agent.id]
            )

            # Emotional impact
            agent.emotions.trigger_emotion(EmotionType.PRIDE, 0.5)
            agent.needs.satisfy_need(NeedType.STATUS, 0.3)

            return {'success': True, 'emotional_impact': 0.4, 'law': law}

        elif action.action_type == ActionType.VOTE:
            # Agent votes on a law or election
            vote_target = action.parameters.get('vote_target')  # law_id or election_id
            vote_choice = action.parameters.get('choice')  # True/False for laws, agent_id for elections

            if not vote_target:
                return {'success': False, 'emotional_impact': 0.0, 'reason': 'No vote target specified'}

            # Try voting on law
            if vote_target in self.governance_manager.laws:
                support = vote_choice if isinstance(vote_choice, bool) else vote_choice == 'yes'
                self.governance_manager.vote_on_law(agent.id, vote_target, support)

                law = self.governance_manager.laws[vote_target]
                vote_str = "supported" if support else "opposed"

                logger.info(f"🗳️ {agent.name} {vote_str} law: {law.name}")

                # Small emotional impact
                agent.needs.satisfy_need(NeedType.AUTONOMY, 0.2)

                return {'success': True, 'emotional_impact': 0.2, 'vote_type': 'law'}

            # Try voting in election
            elif vote_target in self.governance_manager.elections:
                candidate_id = vote_choice if isinstance(vote_choice, str) else action.target_agent

                if not candidate_id:
                    return {'success': False, 'emotional_impact': 0.0, 'reason': 'No candidate specified'}

                success = self.governance_manager.cast_vote(agent.id, vote_target, candidate_id)

                if success:
                    logger.info(f"🗳️ {agent.name} voted in election")
                    agent.needs.satisfy_need(NeedType.AUTONOMY, 0.3)
                    return {'success': True, 'emotional_impact': 0.2, 'vote_type': 'election'}
                else:
                    return {'success': False, 'emotional_impact': -0.1, 'reason': 'Cannot vote in this election'}

            else:
                return {'success': False, 'emotional_impact': 0.0, 'reason': 'Invalid vote target'}

        # ===== AGRICULTURE ACTIONS =====

        elif action.action_type == ActionType.PLANT_CROPS:
            # Agent plants crops
            from world.agriculture import CropType

            # Check if agent has materials to plant
            if not agent.inventory.has_item('seeds'):
                # No seeds? Maybe try using what they have
                # In early game, agents might not have seeds yet
                return {'success': False, 'emotional_impact': -0.05, 'message': 'No seeds to plant'}

            # Choose crop type based on what's available
            # For now, default to wheat (most basic crop)
            crop_type = CropType.WHEAT

            # Plant the crop
            field = self.agriculture.plant_crop(
                agent.id,
                crop_type,
                (agent.location.x, agent.location.y),
                current_tick
            )

            if field:
                # Consume seeds (or materials used for planting)
                if agent.inventory.has_item('seeds'):
                    agent.inventory.remove_item('seeds', 1)

                logger.info(f"🌱 {agent.name} planted {crop_type.value} field")
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.15)
                return {'success': True, 'emotional_impact': 0.2, 'message': f'Planted {crop_type.value}'}
            else:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Could not plant crop'}

        elif action.action_type == ActionType.TEND_CROPS:
            # Agent tends to their crops (improves growth, prevents disease)
            farm = self.agriculture.get_agent_farm(agent.id)

            if farm and len(farm.fields) > 0:
                # Improve irrigation if possible
                if not farm.has_irrigation and agent.inventory.has_item('wood'):
                    farm.has_irrigation = True
                    agent.inventory.remove_item('wood', 1)
                    logger.info(f"💧 {agent.name} added irrigation to farm!")

                agent.needs.satisfy_need(NeedType.RESOURCES, 0.1)
                return {'success': True, 'emotional_impact': 0.1, 'message': 'Tended crops'}
            else:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No crops to tend'}

        elif action.action_type == ActionType.HARVEST:
            # Agent harvests ready crops
            harvestable = self.agriculture.get_harvestable_crops(agent.id)

            if harvestable:
                total_food = 0
                for field in harvestable[:3]:  # Harvest up to 3 fields per action
                    food_yield = self.agriculture.harvest_crop(field.id, agent.id)
                    total_food += food_yield

                    # Remove the field after harvest
                    farm = self.agriculture.get_agent_farm(agent.id)
                    if farm and field.id in farm.fields:
                        farm.fields.remove(field.id)

                # Add food to inventory
                agent.inventory.add_item('food', total_food)

                logger.info(f"🌾 {agent.name} harvested {total_food} food from {len(harvestable[:3])} fields")
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.3)
                agent.needs.satisfy_need(NeedType.RESOURCES, 0.2)

                return {'success': True, 'emotional_impact': 0.3, 'food_gained': total_food}
            else:
                return {'success': False, 'emotional_impact': -0.05, 'message': 'No crops ready to harvest'}

        elif action.action_type == ActionType.RAISE_ANIMALS:
            # Agent domesticates or tends to animals
            from world.agriculture import AnimalType

            farm = self.agriculture.get_agent_farm(agent.id)
            if not farm:
                # Create farm first
                farm = self.agriculture.create_farm(
                    agent.id,
                    agent.name,
                    (agent.location.x, agent.location.y)
                )

            # Check if agent has animals already
            agent_animals = self.agriculture.get_agent_animals(agent.id)

            if len(agent_animals) < 10:  # Limit to 10 animals
                # Try to domesticate a new animal (simplified - in reality would need to hunt/capture first)
                # Choose simple animals first (chickens, then pigs, then cows)
                animal_type = AnimalType.CHICKEN if len(agent_animals) < 3 else AnimalType.PIG

                animal = self.agriculture.domesticate_animal(agent.id, animal_type, current_tick)

                if animal:
                    logger.info(f"🐓 {agent.name} domesticated a {animal_type.value}!")
                    agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.2)
                    return {'success': True, 'emotional_impact': 0.25, 'animal': animal_type.value}
            else:
                # Tend to existing animals (feed them, collect products)
                for animal in agent_animals:
                    if animal.produces_material and current_tick - animal.last_production >= animal.production_rate:
                        # Collect production (eggs, milk, wool, etc.)
                        agent.inventory.add_item(animal.produces_material, 1)
                        animal.last_production = current_tick
                        logger.info(f"🥚 {agent.name} collected {animal.produces_material} from {animal.animal_type.value}")

                return {'success': True, 'emotional_impact': 0.1, 'message': 'Tended animals'}

            return {'success': False, 'emotional_impact': 0.0}

        # ===== HEALTH & MEDICINE ACTIONS =====

        elif action.action_type == ActionType.HEAL:
            # Agent treats another agent's disease
            if not action.target_agent:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No patient specified'}

            target = self._get_agent_by_id(action.target_agent)
            if not target:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Patient not found'}

            # Check if patient is sick
            if not self.health.is_agent_sick(target.id):
                return {'success': False, 'emotional_impact': -0.05, 'message': 'Patient is healthy'}

            # Apply treatment (without medicine for now)
            result = self.health.apply_treatment(target.id, agent.id, medicine_id=None)

            if result['success']:
                logger.info(f"💊 {agent.name} treated {target.name} for {result['disease_type']}")
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.25)
                agent.needs.satisfy_need(NeedType.MEANING, 0.2)
                return {'success': True, 'emotional_impact': 0.3, 'effectiveness': result['effectiveness']}
            else:
                return {'success': False, 'emotional_impact': -0.1, 'message': result.get('reason', 'Treatment failed')}

        elif action.action_type == ActionType.DIAGNOSE:
            # Agent diagnoses another agent's illness
            if not action.target_agent:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No patient specified'}

            target = self._get_agent_by_id(action.target_agent)
            if not target:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Patient not found'}

            diagnosis = self.health.diagnose(target.id, agent.id)

            if diagnosis:
                logger.info(f"🩺 {agent.name} diagnosed {target.name}: {diagnosis['disease_type']}")
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.15)
                return {'success': True, 'emotional_impact': 0.2, 'diagnosis': diagnosis}
            else:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Patient appears healthy'}

        elif action.action_type == ActionType.CURE:
            # Agent tries to cure disease through experimentation (discover medicine)
            if not agent.inventory.items:
                return {'success': False, 'emotional_impact': -0.05, 'message': 'Need ingredients to create medicine'}

            # Try to create medicine from available materials
            ingredients = {}
            for item_name, quantity in list(agent.inventory.items.items())[:3]:  # Use up to 3 items
                if quantity > 0 and item_name not in ['food', 'water']:
                    ingredients[item_name] = 1
                    agent.inventory.remove_item(item_name, 1)

            if ingredients:
                # Choose preparation method
                methods = ['grind', 'boil', 'ferment', 'mix', 'brew']
                method = random.choice(methods)

                medicine = self.health.discover_medicine(
                    agent.id,
                    agent.name,
                    ingredients,
                    method,
                    current_tick
                )

                if medicine:
                    logger.info(f"💊 {agent.name} discovered medicine: {medicine.name}!")
                    agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.4)
                    agent.needs.satisfy_need(NeedType.MEANING, 0.3)

                    # Add medicine to inventory
                    agent.inventory.add_item(f"medicine_{medicine.id[:8]}", 1)

                    return {'success': True, 'emotional_impact': 0.5, 'medicine': medicine.name}

            return {'success': False, 'emotional_impact': 0.0, 'message': 'Medicine creation failed'}

        # ===== RELIGION & SPIRITUALITY ACTIONS =====

        elif action.action_type == ActionType.PRAY:
            # Agent prays (individual spiritual practice)
            agent_religion = self.religion.get_agent_religion(agent.id)

            if not agent_religion:
                # Not religious yet - maybe found a simple belief?
                if random.random() < 0.1:  # 10% chance to spontaneously become spiritual
                    from world.religion import ReligionType, DeityDomain

                    # Found simple animistic belief
                    deity_domain = random.choice(list(DeityDomain))
                    deity = self.religion.create_deity(
                        f"{deity_domain.value.title()} Spirit",
                        deity_domain,
                        agent.id
                    )

                    # Create personal religion
                    religion = self.religion.found_religion(
                        agent.id,
                        agent.name,
                        ReligionType.ANIMISM,
                        current_tick
                    )

                    religion.deities.append(deity.id)

                    logger.info(f"🙏 {agent.name} began worshipping {deity.name}!")
                    agent.needs.satisfy_need(NeedType.MEANING, 0.4)

                    return {'success': True, 'emotional_impact': 0.35, 'message': f'Founded faith in {deity.name}'}

            # Already religious - pray for comfort/guidance
            agent.needs.satisfy_need(NeedType.MEANING, 0.2)
            agent.needs.satisfy_need(NeedType.SECURITY, 0.1)

            return {'success': True, 'emotional_impact': 0.2, 'message': 'Prayed for guidance'}

        elif action.action_type == ActionType.WORSHIP:
            # Agent worships at a temple or sacred site
            from world.religion import RitualType

            agent_religion = self.religion.get_agent_religion(agent.id)

            if not agent_religion:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Not religious'}

            # Find nearby temple
            nearby_temples = self.religion.get_nearby_temples(
                (agent.location.x, agent.location.y),
                radius=30.0
            )

            if nearby_temples:
                # Worship at temple
                temple = nearby_temples[0]
                temple.worshippers.add(agent.id)
                temple.last_ritual = current_tick

                agent.needs.satisfy_need(NeedType.MEANING, 0.3)
                agent.needs.satisfy_need(NeedType.BELONGING, 0.2)

                logger.info(f"🙏 {agent.name} worshipped at {temple.name}")
                return {'success': True, 'emotional_impact': 0.3, 'message': f'Worshipped at {temple.name}'}
            else:
                # Worship at current location (outdoor prayer)
                agent.needs.satisfy_need(NeedType.MEANING, 0.15)
                return {'success': True, 'emotional_impact': 0.15, 'message': 'Worshipped outdoors'}

        elif action.action_type == ActionType.PERFORM_RITUAL:
            # Agent performs/leads a religious ritual
            from world.religion import RitualType

            agent_religion = self.religion.get_agent_religion(agent.id)

            if not agent_religion:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Not religious'}

            # Check if agent is a priest
            is_priest = self.religion.is_priest(agent.id)

            # Choose ritual type
            if agent_religion.regular_rituals:
                ritual_type = random.choice(agent_religion.regular_rituals)
            else:
                ritual_type = RitualType.PRAYER

            # Start ritual
            ritual = self.religion.start_ritual(
                ritual_type,
                agent_religion.id,
                agent.id,
                (agent.location.x, agent.location.y),
                current_tick
            )

            # Add agent as participant
            ritual.participants.add(agent.id)

            # Try to add nearby co-religionists
            for other_agent in self.world.agents:
                if other_agent.id != agent.id and other_agent.alive:
                    if other_agent.id in agent_religion.followers:
                        dist = agent.location.distance_to(other_agent.location)
                        if dist < 20:
                            ritual.participants.add(other_agent.id)

            # Priests get stronger spiritual benefit
            if is_priest:
                agent.needs.satisfy_need(NeedType.MEANING, 0.3)
                agent.needs.satisfy_need(NeedType.LEADERSHIP, 0.2)
            else:
                agent.needs.satisfy_need(NeedType.MEANING, 0.2)

            logger.info(f"🙏 {agent.name} started {ritual_type.value} with {len(ritual.participants)} participants")
            return {'success': True, 'emotional_impact': 0.3, 'participants': len(ritual.participants)}

        elif action.action_type == ActionType.BUILD_TEMPLE:
            # Agent builds a temple
            from world.religion import ReligionType

            agent_religion = self.religion.get_agent_religion(agent.id)

            # If not religious, might found a religion first
            if not agent_religion:
                # High charisma agents might found religions
                charisma = getattr(agent.personality, 'charisma', 0.5) if hasattr(agent, 'personality') else 0.5

                if charisma > 0.7:
                    # Found new religion!
                    religion_type = random.choice(list(ReligionType))
                    agent_religion = self.religion.found_religion(
                        agent.id,
                        agent.name,
                        religion_type,
                        current_tick
                    )

                    logger.info(f"🙏 {agent.name} founded {agent_religion.name}!")
                else:
                    return {'success': False, 'emotional_impact': 0.0, 'message': 'Not religious'}

            # Check if has materials to build temple
            if not (agent.inventory.has_item('stone') and agent.inventory.has_item('wood')):
                return {'success': False, 'emotional_impact': -0.05, 'message': 'Need stone and wood for temple'}

            # Build temple
            agent.inventory.remove_item('stone', 5)
            agent.inventory.remove_item('wood', 5)

            temple = self.religion.build_temple(
                agent_religion.id,
                agent.id,
                (agent.location.x, agent.location.y),
                current_tick,
                size=1
            )

            if temple:
                logger.info(f"🏛️ {agent.name} built {temple.name}!")
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.4)
                agent.needs.satisfy_need(NeedType.MEANING, 0.5)

                # Become priest if not already
                if not self.religion.is_priest(agent.id):
                    self.religion.ordain_priest(agent.id, agent_religion.id)

                return {'success': True, 'emotional_impact': 0.5, 'temple': temple.name}

            return {'success': False, 'emotional_impact': 0.0, 'message': 'Temple construction failed'}

        # ===== TERRITORY & LAND OWNERSHIP ACTIONS =====

        elif action.action_type == ActionType.CLAIM_TERRITORY:
            # Agent claims land as their territory
            from world.territory import TerritoryType

            # Check if agent already has territory at this location
            existing = self.territory.get_territory_at_location((agent.location.x, agent.location.y))

            if existing and existing.owner_id == agent.id:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Already own this territory'}

            if existing:
                return {'success': False, 'emotional_impact': -0.1, 'message': 'Land already claimed by another'}

            # Claim territory around current location
            territory = self.territory.claim_territory(
                agent.id,
                agent.name,
                (agent.location.x, agent.location.y),
                radius=15.0,  # 15m radius
                territory_type=TerritoryType.PERSONAL,
                current_tick=current_tick
            )

            if territory:
                logger.info(f"🗺️  {agent.name} claimed {territory.name}!")
                agent.needs.satisfy_need(NeedType.SECURITY, 0.3)
                agent.needs.satisfy_need(NeedType.ACHIEVEMENT, 0.2)

                return {'success': True, 'emotional_impact': 0.3, 'territory': territory.name}

            return {'success': False, 'emotional_impact': 0.0, 'message': 'Could not claim territory'}

        elif action.action_type == ActionType.PATROL:
            # Agent patrols their territory
            agent_territories = self.territory.get_agent_territories(agent.id)

            if not agent_territories:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No territory to patrol'}

            # Patrol closest territory
            territory = agent_territories[0]
            territory.last_patrol = current_tick

            # Check for trespassers
            trespassers_found = []
            for trespasser_id in territory.trespassers:
                trespasser = next((a for a in self.world.agents if a.id == trespasser_id), None)
                if trespasser and trespasser.alive:
                    # Check if still trespassing
                    dist = ((trespasser.location.x - territory.center[0])**2 +
                           (trespasser.location.y - territory.center[1])**2)**0.5

                    if dist <= territory.radius:
                        trespassers_found.append(trespasser.name)

            if trespassers_found:
                logger.warning(f"⚔️  {agent.name} found trespassers: {', '.join(trespassers_found)}")
                agent.needs.satisfy_need(NeedType.SECURITY, -0.2)  # Threatened
                return {'success': True, 'emotional_impact': -0.1, 'trespassers': len(trespassers_found)}
            else:
                agent.needs.satisfy_need(NeedType.SECURITY, 0.1)  # Territory secure
                return {'success': True, 'emotional_impact': 0.1, 'message': 'Territory secure'}

        elif action.action_type == ActionType.GUARD:
            # Agent guards a location (becomes a guard)
            agent_territories = self.territory.get_agent_territories(agent.id)

            if not agent_territories:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No territory to guard'}

            # Guard closest territory
            territory = agent_territories[0]
            self.territory.add_guard(territory.id, agent.id)

            logger.info(f"🛡️ {agent.name} now guards {territory.name}")
            agent.needs.satisfy_need(NeedType.SECURITY, 0.2)
            agent.needs.satisfy_need(NeedType.MEANING, 0.1)  # Purposeful role

            return {'success': True, 'emotional_impact': 0.2, 'message': f'Guarding {territory.name}'}

        # ===== CHEMISTRY ACTIONS =====

        elif action.action_type == ActionType.PERFORM_CHEMISTRY:
            # Agent performs chemical experiment
            # Try to perform a reaction with available compounds

            # Get available compounds from inventory (simplified)
            # For now, assume agents can attempt basic reactions

            # Simple fire creation: C + O2 → CO2 (combustion)
            if agent.inventory.has_item('wood'):
                # Wood contains carbon
                result = self.chemistry.attempt_reaction(
                    reactants={"CH4": 1, "O2": 2},  # Simplified combustion
                    temperature=600,
                    has_catalyst=False
                )

                if result.get('success'):
                    agent.inventory.remove_item('wood', 1)
                    agent.inventory.add_item('ash', 1)  # Combustion product

                    # Discover compounds
                    for product_formula in result.get('products', {}).keys():
                        compound = self.chemistry.discover_compound(
                            product_formula,
                            agent.id,
                            current_tick
                        )
                        if compound and compound.discoverer_id == agent.id:
                            logger.info(f"⚗️ {agent.name} discovered {compound.name} ({compound.formula})!")

                    agent.needs.satisfy_need(NeedType.LEARNING, 0.3)
                    agent.needs.satisfy_need(NeedType.MASTERY, 0.2)

                    self.total_reactions_performed += 1

                    return {
                        'success': True,
                        'emotional_impact': 0.4,
                        'message': f'Chemical reaction: {result.get("reaction_type")}',
                        'energy_released': result.get('energy_released', 0)
                    }
                else:
                    return {
                        'success': False,
                        'emotional_impact': -0.1,
                        'message': f'Reaction failed: {result.get("reason")}'
                    }
            else:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No materials for chemistry'}

        elif action.action_type == ActionType.SMELT_ORE:
            # Iron smelting: Fe2O3 + 3C → 2Fe + 3CO
            # Agent needs ore and carbon source (wood/coal)

            if agent.inventory.has_item('iron_ore') and agent.inventory.has_item('wood'):
                # Attempt iron smelting reaction
                result = self.chemistry.attempt_reaction(
                    reactants={"Fe2O3": 1, "C": 3},
                    temperature=1200,
                    has_catalyst=False
                )

                if result.get('success'):
                    agent.inventory.remove_item('iron_ore', 1)
                    agent.inventory.remove_item('wood', 3)
                    agent.inventory.add_item('iron', 2)

                    # Discover iron element if not discovered
                    iron_element = self.chemistry.discover_element('Fe', agent.id, current_tick)
                    if iron_element and iron_element.discoverer_id == agent.id:
                        logger.info(f"⚗️ {agent.name} discovered {iron_element.name}!")

                        # MAJOR DISCOVERY - Iron enables Iron Age!
                        self.event_logger.log_event(
                            EventCategory.DISCOVERY,
                            EventImportance.MAJOR,
                            f"⚗️ Iron Discovered!",
                            f"{agent.name} has discovered how to smelt iron from ore! The Iron Age begins.",
                            current_tick,
                            [agent.id]
                        )

                    agent.needs.satisfy_need(NeedType.MASTERY, 0.4)
                    agent.needs.satisfy_need(NeedType.LEARNING, 0.3)

                    logger.info(f"⚗️ {agent.name} smelted iron ore → {result.get('products', {}).get('Fe', 0)} iron")

                    self.total_reactions_performed += 1

                    return {
                        'success': True,
                        'emotional_impact': 0.5,
                        'message': 'Successfully smelted iron!',
                        'products': result.get('products', {})
                    }
                else:
                    return {
                        'success': False,
                        'emotional_impact': -0.2,
                        'message': f'Smelting failed: {result.get("reason")}'
                    }
            else:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Need iron ore and wood'}

        elif action.action_type == ActionType.DISCOVER_ELEMENT:
            # Agent tries to discover a new element through observation/experimentation

            # Pick a random undiscovered element
            undiscovered = [
                e for e in self.chemistry.elements.values()
                if not e.discovered
            ]

            if undiscovered:
                # Discovery chance based on agent's experimentation skill
                discovery_chance = 0.05  # 5% base chance

                if random.random() < discovery_chance:
                    element = random.choice(undiscovered)
                    self.chemistry.discover_element(element.symbol, agent.id, current_tick)

                    logger.info(f"⚗️ {agent.name} discovered element: {element.name} ({element.symbol})!")

                    self.event_logger.log_event(
                        EventCategory.DISCOVERY,
                        EventImportance.MODERATE,
                        f"⚗️ Element Discovered: {element.name}",
                        f"{agent.name} has discovered the element {element.name} ({element.symbol})!",
                        current_tick,
                        [agent.id]
                    )

                    agent.needs.satisfy_need(NeedType.LEARNING, 0.5)
                    agent.needs.satisfy_need(NeedType.MASTERY, 0.4)
                    agent.needs.satisfy_need(NeedType.MEANING, 0.2)

                    return {
                        'success': True,
                        'emotional_impact': 0.6,
                        'message': f'Discovered {element.name}!',
                        'element': element.symbol
                    }
                else:
                    # Experimentation attempt, no discovery
                    agent.needs.satisfy_need(NeedType.LEARNING, 0.1)
                    return {
                        'success': False,
                        'emotional_impact': 0.05,
                        'message': 'Experimentation yielded no new elements'
                    }
            else:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'All elements already discovered'
                }

        # ===== ENERGY ACTIONS =====

        elif action.action_type == ActionType.BUILD_POWER_PLANT:
            # Agent builds a power generation facility
            from world.energy import PowerPlantType, EnergyType

            # Check if agent has materials and knowledge
            if not agent.inventory.has_item('materials'):
                return {'success': False, 'emotional_impact': 0.0, 'message': 'Need materials to build'}

            # Start with basic fire pit
            plant_type = PowerPlantType.FIRE_PIT
            fuel_type = EnergyType.FIRE

            # Upgrade plant type based on discovered energy sources
            if EnergyType.COAL in self.energy.discovered_energy_types:
                plant_type = PowerPlantType.FURNACE
                fuel_type = EnergyType.COAL

            if EnergyType.OIL in self.energy.discovered_energy_types:
                plant_type = PowerPlantType.POWER_PLANT
                fuel_type = EnergyType.OIL

            if EnergyType.NUCLEAR in self.energy.discovered_energy_types:
                plant_type = PowerPlantType.NUCLEAR_REACTOR
                fuel_type = EnergyType.NUCLEAR

            plant = self.energy.build_power_plant(
                plant_type=plant_type,
                fuel_type=fuel_type,
                location=(agent.location.x, agent.location.y),
                owner_id=agent.id,
                builder_id=agent.id,
                current_tick=current_tick
            )

            if plant:
                agent.inventory.remove_item('materials', 5)

                logger.info(f"⚡ {agent.name} built {plant.name} using {fuel_type.value}!")

                self.event_logger.log_event(
                    EventCategory.DISCOVERY,
                    EventImportance.MODERATE,
                    f"⚡ Power Plant Built!",
                    f"{agent.name} has constructed a {plant.name}, harnessing {fuel_type.value} energy!",
                    current_tick,
                    [agent.id]
                )

                agent.needs.satisfy_need(NeedType.MASTERY, 0.5)
                agent.needs.satisfy_need(NeedType.MEANING, 0.3)

                return {
                    'success': True,
                    'emotional_impact': 0.6,
                    'message': f'Built {plant.name}!',
                    'plant_id': plant.id
                }
            else:
                return {'success': False, 'emotional_impact': -0.1, 'message': 'Cannot build power plant'}

        elif action.action_type == ActionType.DISCOVER_ENERGY:
            # Agent tries to discover a new energy source
            from world.energy import EnergyType

            # Pick a random undiscovered energy source
            undiscovered = [
                et for et in EnergyType
                if et not in self.energy.discovered_energy_types
                and et not in [EnergyType.MANUAL, EnergyType.FIRE]  # Already known
            ]

            if undiscovered:
                # Discovery chance based on exploration
                discovery_chance = 0.03  # 3% base chance

                if random.random() < discovery_chance:
                    energy_type = random.choice(undiscovered)
                    source = self.energy.discover_energy_source(
                        energy_type,
                        agent.id,
                        current_tick
                    )

                    if source:
                        logger.info(f"⚡ {agent.name} discovered {source.name}!")

                        # Major discovery!
                        importance = EventImportance.MAJOR if energy_type in [EnergyType.COAL, EnergyType.OIL, EnergyType.NUCLEAR] else EventImportance.MODERATE

                        self.event_logger.log_event(
                            EventCategory.DISCOVERY,
                            importance,
                            f"⚡ Energy Discovery: {source.name}",
                            f"{agent.name} has discovered {source.name}! Energy density: {source.energy_density} kJ/kg",
                            current_tick,
                            [agent.id]
                        )

                        agent.needs.satisfy_need(NeedType.LEARNING, 0.5)
                        agent.needs.satisfy_need(NeedType.MASTERY, 0.4)
                        agent.needs.satisfy_need(NeedType.MEANING, 0.3)

                        return {
                            'success': True,
                            'emotional_impact': 0.7,
                            'message': f'Discovered {source.name}!',
                            'energy_type': energy_type.value
                        }

                # No discovery
                return {
                    'success': False,
                    'emotional_impact': 0.05,
                    'message': 'Exploration yielded no new energy sources'
                }
            else:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'All energy sources discovered'
                }

        elif action.action_type == ActionType.OPERATE_POWER_PLANT:
            # Agent operates a power plant they own
            plants = self.energy.get_plants_by_owner(agent.id)

            if not plants:
                return {'success': False, 'emotional_impact': 0.0, 'message': 'No power plants to operate'}

            plant = plants[0]  # Operate first plant

            # Check for fuel
            fuel_item = f"{plant.fuel_type.value}"
            fuel_amount = 0.0

            # Simplified fuel system
            if agent.inventory.has_item('wood'):
                fuel_amount = agent.inventory.items.get('wood', 0)
                agent.inventory.remove_item('wood', min(5, fuel_amount))
                fuel_amount = min(5, fuel_amount)
            elif agent.inventory.has_item('coal'):
                fuel_amount = agent.inventory.items.get('coal', 0)
                agent.inventory.remove_item('coal', min(3, fuel_amount))
                fuel_amount = min(3, fuel_amount)

            if fuel_amount > 0:
                energy_generated = self.energy.operate_power_plant(plant.id, fuel_amount)

                logger.info(f"⚡ {agent.name} operated {plant.name}, generated {energy_generated:.1f} kW")

                agent.needs.satisfy_need(NeedType.MASTERY, 0.2)

                return {
                    'success': True,
                    'emotional_impact': 0.3,
                    'message': f'Generated {energy_generated:.1f} kW of power',
                    'energy_generated': energy_generated
                }
            else:
                return {'success': False, 'emotional_impact': -0.1, 'message': 'No fuel available'}

        # ===== MATERIALS SCIENCE ACTIONS =====

        elif action.action_type == ActionType.DISCOVER_MATERIAL:
            # Agent tries to discover a new material
            from world.materials import MaterialCategory

            # Try to discover an undiscovered material
            undiscovered = [
                (mat_id, mat) for mat_id, mat in self.materials_science.materials.items()
                if not mat.discovered
            ]

            if undiscovered:
                # Discovery chance
                discovery_chance = 0.04  # 4% base chance

                if random.random() < discovery_chance:
                    material_id, material = random.choice(undiscovered)
                    self.materials_science.discover_material(material_id, agent.id, current_tick)

                    logger.info(f"🔬 {agent.name} discovered {material.name}!")

                    # Check if this unlocked a new era
                    era_unlocked = material.unlocks_era
                    importance = EventImportance.MAJOR if era_unlocked else EventImportance.MODERATE

                    event_desc = f"{agent.name} has discovered {material.name}! "
                    if era_unlocked:
                        event_desc += f"The {era_unlocked.value.replace('_', ' ').title()} has begun!"

                    self.event_logger.log_event(
                        EventCategory.DISCOVERY,
                        importance,
                        f"🔬 Material Discovered: {material.name}",
                        event_desc,
                        current_tick,
                        [agent.id]
                    )

                    agent.needs.satisfy_need(NeedType.LEARNING, 0.5)
                    agent.needs.satisfy_need(NeedType.MASTERY, 0.4)

                    if era_unlocked:
                        agent.needs.satisfy_need(NeedType.MEANING, 0.5)

                    return {
                        'success': True,
                        'emotional_impact': 0.7 if era_unlocked else 0.5,
                        'message': f'Discovered {material.name}!',
                        'material_id': material_id,
                        'era_unlocked': era_unlocked.value if era_unlocked else None
                    }

                # No discovery
                return {
                    'success': False,
                    'emotional_impact': 0.05,
                    'message': 'Material research yielded no discoveries'
                }
            else:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'All materials discovered'
                }

        elif action.action_type == ActionType.CREATE_ALLOY:
            # Agent attempts to create a metal alloy
            from world.materials import Alloy

            # Try to create an undiscovered alloy
            undiscovered_alloys = [
                (alloy_id, alloy) for alloy_id, alloy in self.materials_science.alloys.items()
                if not alloy.discovered
            ]

            if undiscovered_alloys:
                # Check if agent has the right metals
                # Simplified: if agent has iron and carbon, can make steel
                if agent.inventory.has_item('iron') and agent.inventory.has_item('carbon'):
                    # Try to make steel
                    steel_alloy = self.materials_science.alloys.get('steel')
                    if steel_alloy and not steel_alloy.discovered:
                        # Success!
                        self.materials_science.create_alloy('steel', agent.id, current_tick)

                        agent.inventory.remove_item('iron', 1)
                        agent.inventory.remove_item('carbon', 1)
                        agent.inventory.add_item('steel', 2)

                        logger.info(f"🔬 {agent.name} created {steel_alloy.name} alloy!")

                        self.event_logger.log_event(
                            EventCategory.DISCOVERY,
                            EventImportance.MAJOR,
                            f"🔬 Alloy Created: {steel_alloy.name}",
                            f"{agent.name} has created {steel_alloy.name}, a revolutionary new alloy!",
                            current_tick,
                            [agent.id]
                        )

                        agent.needs.satisfy_need(NeedType.MASTERY, 0.6)
                        agent.needs.satisfy_need(NeedType.LEARNING, 0.5)
                        agent.needs.satisfy_need(NeedType.MEANING, 0.4)

                        return {
                            'success': True,
                            'emotional_impact': 0.8,
                            'message': f'Created {steel_alloy.name}!',
                            'alloy': 'steel'
                        }

                # Try bronze (copper + tin)
                if agent.inventory.has_item('copper') and agent.inventory.has_item('tin'):
                    bronze_alloy = self.materials_science.alloys.get('bronze')
                    if bronze_alloy and not bronze_alloy.discovered:
                        self.materials_science.create_alloy('bronze', agent.id, current_tick)

                        agent.inventory.remove_item('copper', 3)
                        agent.inventory.remove_item('tin', 1)
                        agent.inventory.add_item('bronze', 4)

                        logger.info(f"🔬 {agent.name} created {bronze_alloy.name} alloy!")

                        self.event_logger.log_event(
                            EventCategory.DISCOVERY,
                            EventImportance.MAJOR,
                            f"🔬 Bronze Age Begins!",
                            f"{agent.name} has created bronze! The Bronze Age has begun!",
                            current_tick,
                            [agent.id]
                        )

                        agent.needs.satisfy_need(NeedType.MASTERY, 0.7)
                        agent.needs.satisfy_need(NeedType.MEANING, 0.5)

                        return {
                            'success': True,
                            'emotional_impact': 0.9,
                            'message': 'Created Bronze! Bronze Age begins!',
                            'alloy': 'bronze'
                        }

                return {
                    'success': False,
                    'emotional_impact': -0.1,
                    'message': 'Missing materials for alloy creation'
                }
            else:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'All alloys already created'
                }

        elif action.action_type == ActionType.REFINE_MATERIAL:
            # Agent refines a raw material into processed material
            from world.materials import MaterialCategory

            # Check if agent has raw materials
            if agent.inventory.has_item('iron_ore'):
                # Refine iron ore → iron
                result = self.materials_science.process_material(
                    'iron',
                    {'iron_ore': agent.inventory.items.get('iron_ore', 0)},
                    has_heat=True,
                    temperature=1538
                )

                if result and result.get('success'):
                    agent.inventory.remove_item('iron_ore', 1)
                    agent.inventory.add_item('iron', 1)

                    logger.info(f"🔬 {agent.name} refined iron ore → iron")

                    agent.needs.satisfy_need(NeedType.MASTERY, 0.3)

                    return {
                        'success': True,
                        'emotional_impact': 0.4,
                        'message': 'Refined iron ore into iron',
                        'material': 'iron'
                    }
                else:
                    return {
                        'success': False,
                        'emotional_impact': -0.2,
                        'message': f'Refining failed: {result.get("reason") if result else "unknown"}'
                    }

            elif agent.inventory.has_item('sand'):
                # Make glass from sand
                result = self.materials_science.process_material(
                    'glass',
                    {'sand': agent.inventory.items.get('sand', 0)},
                    has_heat=True,
                    temperature=1400
                )

                if result and result.get('success'):
                    agent.inventory.remove_item('sand', 1)
                    agent.inventory.add_item('glass', 1)

                    logger.info(f"🔬 {agent.name} made glass from sand")

                    agent.needs.satisfy_need(NeedType.MASTERY, 0.3)

                    return {
                        'success': True,
                        'emotional_impact': 0.4,
                        'message': 'Created glass from sand',
                        'material': 'glass'
                    }
                else:
                    return {
                        'success': False,
                        'emotional_impact': -0.2,
                        'message': 'Glass making failed'
                    }
            else:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'No raw materials to refine'
                }

        # ===== ADVANCED FINANCIAL SYSTEM ACTIONS =====

        elif action.action_type == ActionType.MINT_COINS:
            # Agent mints coins from metal ore
            from economy.minting import CoinType

            # Check for metal ores
            if agent.inventory.has_item('copper_ore'):
                coin_type = CoinType.COPPER_PENNY
                ore_type = 'copper_ore'
                metal_needed = 0.1
            elif agent.inventory.has_item('silver_ore'):
                coin_type = CoinType.SILVER_SHILLING
                ore_type = 'silver_ore'
                metal_needed = 0.2
            elif agent.inventory.has_item('gold_ore'):
                coin_type = CoinType.GOLD_CROWN
                ore_type = 'gold_ore'
                metal_needed = 0.3
            else:
                return {
                    'success': False,
                    'emotional_impact': -0.1,
                    'message': 'No metal ore to mint coins'
                }

            # Get or create mint
            agent_mints = self.economy.minting.get_mints_by_owner(agent.id)
            if not agent_mints:
                from economy.minting import MintQuality
                mint_location = (agent.location.x, agent.location.y)
                mint = self.economy.minting.build_mint(agent.id, mint_location, MintQuality.BASIC, current_tick)
                logger.info(f"🏦 {agent.name} established a mint!")
            else:
                mint = agent_mints[0]

            # Mint coins!
            metal_available = {ore_type.replace('_ore', ''): agent.inventory.items.get(ore_type, 0) * 10}
            result = self.economy.minting.mint_coins(mint.id, coin_type, quantity=10, metal_available=metal_available)

            if result['success']:
                agent.inventory.remove_item(ore_type, 1)
                agent.wealth += result['coins_minted'] * 1  # Each coin worth 1 wealth

                logger.info(f"🪙 {agent.name} minted {result['coins_minted']} {coin_type.value}!")

                agent.needs.satisfy_need(NeedType.MASTERY, 0.3)

                return {
                    'success': True,
                    'emotional_impact': 0.5,
                    'message': f"Minted {result['coins_minted']} coins!",
                    'coins': result['coins_minted']
                }
            else:
                return {
                    'success': False,
                    'emotional_impact': -0.2,
                    'message': result.get('reason', 'Minting failed')
                }

        elif action.action_type == ActionType.OPEN_BANK:
            # Agent opens a bank
            bank_location = (agent.location.x, agent.location.y)
            initial_capital = max(100, agent.wealth * 0.5)

            if agent.wealth < initial_capital:
                return {
                    'success': False,
                    'emotional_impact': -0.2,
                    'message': 'Not enough wealth to open bank'
                }

            bank = self.economy.banking.found_bank(
                agent.id,
                bank_location,
                initial_capital,
                current_tick
            )

            agent.wealth -= initial_capital

            logger.info(f"🏦 {agent.name} opened a bank with {initial_capital:.0f} capital!")

            agent.needs.satisfy_need(NeedType.MASTERY, 0.5)

            self.event_logger.log_event(
                EventCategory.ECONOMIC,
                EventImportance.MAJOR,
                "Bank Founded",
                f"{agent.name} established a bank!",
                current_tick,
                [agent.id]
            )

            return {
                'success': True,
                'emotional_impact': 0.7,
                'message': 'Opened a bank!',
                'bank_id': bank.id
            }

        elif action.action_type == ActionType.APPLY_FOR_LOAN:
            # Agent applies for a loan from nearest bank
            from economy.banking import LoanType

            # Find nearest bank
            nearest_bank_id = None
            min_distance = float('inf')
            for bank_id, bank in self.economy.banking.banks.items():
                dist = ((agent.location.x - bank.location[0])**2 + (agent.location.y - bank.location[1])**2)**0.5
                if dist < min_distance:
                    min_distance = dist
                    nearest_bank_id = bank_id

            if not nearest_bank_id or min_distance > 30.0:
                return {
                    'success': False,
                    'emotional_impact': -0.2,
                    'message': 'No bank nearby'
                }

            # Apply for loan
            loan_amount = min(agent.wealth * 2, 1000)  # Borrow up to 2x wealth
            result = self.economy.banking.apply_for_loan(
                nearest_bank_id,
                agent.id,
                loan_amount,
                LoanType.PERSONAL,
                term_ticks=100,
                collateral={'wealth': agent.wealth * 0.5},
                current_tick=current_tick
            )

            if result['approved']:
                agent.wealth += loan_amount

                logger.info(f"💰 {agent.name} got a loan of {loan_amount:.0f} at {result['interest_rate']*100:.1f}% interest!")

                agent.needs.satisfy_need(NeedType.SECURITY, 0.3)

                return {
                    'success': True,
                    'emotional_impact': 0.4,
                    'message': f"Loan approved: {loan_amount:.0f} coins!",
                    'loan_amount': loan_amount
                }
            else:
                return {
                    'success': False,
                    'emotional_impact': -0.3,
                    'message': result.get('reason', 'Loan denied')
                }

        elif action.action_type == ActionType.JOIN_TAX_REVOLT:
            # Agent joins an active tax revolt
            active_revolts = [r for r in self.economy.taxation.tax_revolts.values()
                            if not r.succeeded and agent.id not in r.participants]

            if not active_revolts:
                return {
                    'success': False,
                    'emotional_impact': 0.0,
                    'message': 'No tax revolts to join'
                }

            # Join first active revolt
            revolt = active_revolts[0]
            revolt.participants.add(agent.id)

            logger.info(f"✊ {agent.name} joined tax revolt! Demand: {revolt.demands}")

            agent.needs.satisfy_need(NeedType.AUTONOMY, 0.4)
            agent.emotions.trigger_emotion(EmotionType.ANGER, 0.3)

            self.event_logger.log_event(
                EventCategory.SOCIAL,
                EventImportance.MAJOR,
                "Tax Revolt Growing",
                f"{agent.name} joined the tax revolt! {len(revolt.participants)} participants now.",
                current_tick,
                [agent.id, revolt.leader_id]
            )

            return {
                'success': True,
                'emotional_impact': 0.3,
                'message': f"Joined tax revolt with {len(revolt.participants)} others!",
                'revolt_size': len(revolt.participants)
            }

        elif action.action_type == ActionType.SEND_CARAVAN:
            # Agent sends a trading caravan
            if agent.wealth < 50:
                return {
                    'success': False,
                    'emotional_impact': -0.1,
                    'message': 'Not enough wealth to send caravan'
                }

            # Pick random destination
            import random
            dest_x = random.uniform(0, self.world.width)
            dest_y = random.uniform(0, self.world.height)

            # Collect cargo from inventory
            cargo = {}
            for item, quantity in list(agent.inventory.items.items())[:3]:  # Take first 3 item types
                if quantity > 0:
                    take_qty = min(quantity, 10)
                    cargo[item] = take_qty
                    agent.inventory.remove_item(item, take_qty)

            if not cargo:
                return {
                    'success': False,
                    'emotional_impact': -0.1,
                    'message': 'No goods to trade'
                }

            # Create caravan
            origin = (agent.location.x, agent.location.y)
            destination = (dest_x, dest_y)

            caravan_id = self.economy.trade_routes.send_caravan(
                agent.id,
                origin,
                destination,
                cargo,
                current_tick=current_tick
            )

            logger.info(f"🐪 {agent.name} sent a trading caravan with {sum(cargo.values())} goods!")

            agent.needs.satisfy_need(NeedType.MASTERY, 0.3)

            return {
                'success': True,
                'emotional_impact': 0.4,
                'message': 'Sent trading caravan!',
                'caravan_id': caravan_id
            }

        # Default (idle or unhandled)
        return {'success': True, 'emotional_impact': 0.0}

    def _handle_birth(
        self,
        parent_a: Agent,
        parent_b: Agent,
        child_data: Dict,
        current_tick: int
    ):
        """
        Handle birth of new child agent.

        Creates the child, adds to world, inherits traits from parents.
        """
        # Create child agent (starts at age 0)
        child = self.create_agent(
            name=None,  # Will get random name
            age=0,  # Newborn!
            is_player=False
        )

        # Place child near parents
        child.location = Position(
            (parent_a.location.x + parent_b.location.x) / 2,
            (parent_a.location.y + parent_b.location.y) / 2
        )

        # Give child inherited wealth
        child.wealth = child_data.get('inherited_wealth', 0.0)

        # Add minimal starting items (babies don't have much!)
        child.inventory.add_item('food', 2)
        child.inventory.add_item('water', 2)

        # Add to world
        self.world.agents.append(child)

        # Create life profile with parents
        personality_dict = {
            'openness': child.personality.openness,
            'conscientiousness': child.personality.conscientiousness,
            'extraversion': child.personality.extraversion,
            'agreeableness': child.personality.agreeableness,
            'neuroticism': child.personality.neuroticism,
        }
        self.life_system.create_life_profile(
            child.id,
            personality_dict,
            parents=child_data.get('parents', []),
            inherited_wealth=child_data.get('inherited_wealth', 0.0)
        )

        # Log birth event!
        title = f"👶 {child.name} is born!"
        desc = f"{parent_a.name} and {parent_b.name} have a child! Welcome to the world, {child.name}. Generation {child_data.get('generation', 2)}."

        self.event_logger.log_event(
            EventCategory.LIFE,
            EventImportance.MAJOR,
            title, desc,
            current_tick,
            [parent_a.id, parent_b.id, child.id]
        )

        print(f"\n👶 BIRTH! {parent_a.name} & {parent_b.name} → {child.name} (Gen {child_data.get('generation', 2)})")

        self.total_agents_created += 1

        # Track birth for population history
        self.births_this_day += 1

    def _determine_building_purpose(self, agent: Agent) -> Optional[str]:
        """
        Determine what building purpose the agent ACTUALLY NEEDS.

        This ensures buildings are MEANINGFUL, not random spam!
        Agents only build when they have a real need.
        """
        # Get agent's most urgent unsatisfied needs
        needs = agent.needs.needs

        # INTELLIGENT STORAGE LOGIC: Only build storage if you have LOTS of inventory!
        inventory_count = len(agent.inventory.items) if hasattr(agent.inventory, 'items') else 0
        total_items = sum(agent.inventory.items.values()) if hasattr(agent.inventory, 'items') else 0

        # Map needs to building purposes with thresholds AND conditions
        # Collect all eligible purposes with their urgency scores
        eligible_purposes = []

        # SHELTER: Basic survival need
        shelter_need = needs.get(NeedType.SHELTER)
        if shelter_need and shelter_need.level > 0.7:  # High threshold
            eligible_purposes.append(('shelter', shelter_need.level))

        # DEFENSE: Security concerns
        security_need = needs.get(NeedType.SECURITY)
        if security_need and security_need.level > 0.75:  # Very high threshold
            eligible_purposes.append(('defense', security_need.level))

        # STORAGE: Only if agent has LOTS of items (20+ unique materials or 50+ total)
        resources_need = needs.get(NeedType.RESOURCES)
        if resources_need and resources_need.level > 0.6:
            if inventory_count >= 8 or total_items >= 30:  # Actually has stuff to store
                eligible_purposes.append(('storage', resources_need.level))

        # WORKSHOP: For creative/achievement agents
        creativity_need = needs.get(NeedType.CREATIVITY)
        achievement_need = needs.get(NeedType.ACHIEVEMENT)
        workshop_urgency = 0.0
        if creativity_need and creativity_need.level > 0.7:
            workshop_urgency = max(workshop_urgency, creativity_need.level)
        if achievement_need and achievement_need.level > 0.7:
            workshop_urgency = max(workshop_urgency, achievement_need.level)
        if workshop_urgency > 0.7:
            # Only build workshop if agent is actually creative/skilled
            if agent.personality.creativity > 0.5 or agent.personality.openness > 0.5:
                eligible_purposes.append(('workshop', workshop_urgency))

        # GATHERING SPACE: For social agents
        belonging_need = needs.get(NeedType.BELONGING)
        if belonging_need and belonging_need.level > 0.7:
            # Only build if agent is extraverted
            if agent.personality.extraversion > 0.5:
                eligible_purposes.append(('gathering_space', belonging_need.level))

        # If no eligible purposes, don't build
        if not eligible_purposes:
            return None

        # Pick the MOST URGENT purpose
        eligible_purposes.sort(key=lambda x: x[1], reverse=True)
        return eligible_purposes[0][0]

    def _apply_disaster_to_world(self, disaster):
        """Apply disaster effects to buildings and agents in the affected area"""
        from world.disasters import Disaster

        # Get disaster effects
        effects = self.disasters.get_disaster_effects(disaster)
        if not effects:
            return

        casualties = 0
        buildings_destroyed = 0
        buildings_damaged = 0
        agents_injured = 0

        # Apply effects to buildings
        for building in list(self.building_manager.buildings.values()):  # Copy to allow removal
            if self.disasters.is_location_affected(building.location.x, building.location.y, disaster):
                # Destruction check
                if random.random() < effects.building_destroy_chance:
                    # Building is completely destroyed
                    self.building_manager.remove_building(building.id)
                    buildings_destroyed += 1
                    logger.info(f"{effects.emoji} Building {building.building_type.value} destroyed by {disaster.disaster_type.value}!")

                elif random.random() < effects.building_damage_chance:
                    # Building is damaged (reduce health if it exists)
                    if hasattr(building, 'health'):
                        building.health = max(0, building.health - 50)
                        buildings_damaged += 1
                        logger.info(f"{effects.emoji} Building {building.building_type.value} damaged by {disaster.disaster_type.value}!")

        # Apply effects to agents
        for agent in self.world.agents:
            if not agent.alive:
                continue

            if self.disasters.is_location_affected(agent.location.x, agent.location.y, disaster):
                # Death check
                if random.random() < effects.agent_death_chance:
                    agent.alive = False
                    agent.death_tick = self.world.time.current_tick
                    agent.death_cause = f"{disaster.disaster_type.value}"
                    casualties += 1
                    self.deaths_this_day += 1

                    # Track death cause
                    cause_key = f"disaster_{disaster.disaster_type.value}"
                    self.death_causes[cause_key] = self.death_causes.get(cause_key, 0) + 1

                    logger.info(f"💀 {agent.name} killed by {disaster.disaster_type.value}!")

                    # Log death event
                    self.event_logger.log_event(
                        EventCategory.LIFE,
                        EventImportance.MAJOR,
                        f"💀 {agent.name} killed by {disaster.disaster_type.value}",
                        f"{agent.name} perished in a {disaster.disaster_type.value}",
                        self.world.time.current_tick,
                        [agent.id],
                        {'x': agent.location.x, 'y': agent.location.y}
                    )

                else:
                    # Apply damage
                    if effects.agent_damage > 0:
                        if agent.needs.needs.get(NeedType.SAFETY):
                            agent.needs.needs[NeedType.SAFETY].level = min(
                                1.0,
                                agent.needs.needs[NeedType.SAFETY].level + (effects.agent_damage / 100.0)
                            )
                        agents_injured += 1

        # Destroy resources in the affected area
        if effects.resource_destruction > 0:
            for resource_type in ['food', 'water', 'wood', 'stone']:
                current = self.world.resource_pools.get(resource_type, 0)
                destroyed = current * effects.resource_destruction * 0.1  # Scale down resource destruction
                self.world.resource_pools[resource_type] = max(0, current - destroyed)

        # Update disaster statistics
        disaster.casualties = casualties
        disaster.buildings_destroyed = buildings_destroyed
        disaster.buildings_damaged = buildings_damaged
        disaster.agents_injured = agents_injured

        self.disasters.total_casualties += casualties
        self.disasters.total_buildings_destroyed += buildings_destroyed

        # Log disaster event
        self.event_logger.log_event(
            EventCategory.WORLD,
            EventImportance.MAJOR if casualties > 0 else EventImportance.MODERATE,
            f"{effects.emoji} {disaster.disaster_type.value.title()} strikes!",
            f"{effects.description} | Casualties: {casualties}, Buildings destroyed: {buildings_destroyed}, Injured: {agents_injured}",
            self.world.time.current_tick,
            [],
            {'x': disaster.location_x, 'y': disaster.location_y}
        )

    def _apply_resource_sinks(self, agent):
        """
        Apply resource sinks to prevent economic inflation.
        Based on survival game research: food spoilage, tool degradation, wealth decay.
        """
        import random
        from economy.materials import get_material

        # 1. FOOD SPOILAGE (0.5% per tick = ~7% per day)
        if 'food' in agent.inventory.items:
            spoilage_rate = 0.005  # 0.5% per tick
            food_qty = agent.inventory.items['food']
            spoiled = int(food_qty * spoilage_rate)
            if spoiled > 0 or random.random() < (food_qty * spoilage_rate - spoiled):
                agent.inventory.remove_item('food', max(1, spoiled))

        # 2. WATER EVAPORATION (0.3% per tick)
        if 'water' in agent.inventory.items:
            evaporation_rate = 0.003
            water_qty = agent.inventory.items['water']
            evaporated = int(water_qty * evaporation_rate)
            if evaporated > 0 or random.random() < (water_qty * evaporation_rate - evaporated):
                agent.inventory.remove_item('water', max(1, evaporated))

        # 3. TOOL DEGRADATION (small chance per tick)
        tools = ['axe', 'pickaxe', 'sword', 'hammer', 'knife']
        for tool in tools:
            if tool in agent.inventory.items:
                # 0.2% chance per tick that tool breaks
                if random.random() < 0.002:
                    agent.inventory.remove_item(tool, 1)
                    # Log tool breaking (minor event, don't spam)
                    if random.random() < 0.1:  # Only log 10% of breaks
                        self.event_logger.log_event(
                            EventCategory.ECONOMIC,
                            EventImportance.MINOR,
                            f"🔨 {agent.name}'s {tool} broke",
                            f"Wear and tear claimed another tool",
                            self.world.time.current_tick,
                            [agent.id]
                        )

        # 4. WEALTH DECAY (0.1% per tick = ~14% per day)
        # Represents storage costs, theft risk, etc.
        if agent.wealth > 0:
            decay_rate = 0.001  # 0.1% per tick
            wealth_lost = agent.wealth * decay_rate
            agent.wealth = max(0, agent.wealth - wealth_lost)

        # 5. PLANT FIBER DEGRADATION (organic material decays)
        if 'plant_fiber' in agent.inventory.items:
            decay_rate = 0.004  # 0.4% per tick
            fiber_qty = agent.inventory.items['plant_fiber']
            decayed = int(fiber_qty * decay_rate)
            if decayed > 0 or random.random() < (fiber_qty * decay_rate - decayed):
                agent.inventory.remove_item('plant_fiber', max(1, decayed))

    def _get_agent_by_id(self, agent_id: str) -> Optional[Agent]:
        """Get agent by ID"""
        for agent in self.world.agents:
            if agent.id == agent_id:
                return agent
        return None

    def _calculate_success_score(self, action_outcome) -> float:
        """
        Calculate overall success score (0-1) from multi-dimensional outcome.

        This is what determines if an agent is making GOOD decisions!
        """
        # 1. Need satisfaction (40% weight)
        # Did they satisfy their primary need?
        need_satisfaction_score = 0.0
        if action_outcome.need_changes:
            # Average positive need changes (ignore needs that got worse)
            positive_changes = [change for change in action_outcome.need_changes.values() if change > 0]
            if positive_changes:
                need_satisfaction_score = min(1.0, sum(positive_changes) / max(1, len(positive_changes)) * 2.0)

        # 2. Life satisfaction improvement (30% weight)
        life_improvement_score = max(0.0, min(1.0, action_outcome.life_satisfaction_delta * 5.0))

        # 3. Skill growth (10% weight)
        skill_score = action_outcome.skill_growth * 10.0

        # 4. Binary success (20% weight)
        success_score = 1.0 if action_outcome.succeeded else 0.0

        # Weighted combination
        total_score = (
            need_satisfaction_score * 0.4 +
            life_improvement_score * 0.3 +
            skill_score * 0.1 +
            success_score * 0.2
        )

        return min(1.0, max(0.0, total_score))

    def _handle_deaths(self):
        """Handle agent deaths"""
        current_tick = self.world.time.current_tick

        for agent in self.world.agents[:]:  # Copy list
            if not agent.alive and agent.ticks_lived > 100:
                # Determine death cause from agent
                death_cause = getattr(agent, 'death_cause', None) or ("old age" if agent.age > 100 else "health")

                # Track death for population history
                self.deaths_this_day += 1
                self.death_causes[death_cause] = self.death_causes.get(death_cause, 0) + 1

                # Log death if not already logged
                title, desc = EventGenerator.agent_died(
                    agent.name,
                    agent.age,
                    death_cause
                )
                self.event_logger.log_event(
                    EventCategory.LIFE,
                    EventImportance.MODERATE,
                    title, desc,
                    current_tick,
                    [agent.id]
                )

                # ===== DEATH STORY - Create LEGENDARY memorial! =====
                current_day = current_tick // 144

                # Build legacy context for story
                legacy_context = {
                    'agent_id': agent.id,
                    'achievement_count': len(self.achievement_tracker.agent_achievements.get(agent.id, []).achievements) if agent.id in self.achievement_tracker.agent_achievements else 0,
                    'children_count': len(agent.children_ids),
                    'grandchildren_count': 0,  # TODO: Calculate
                    'buildings_built': getattr(agent, 'buildings_constructed', 0),
                    'discoveries': 0,  # TODO: Track
                    'wealth': agent.inventory.items.get('wealth', 0),
                    'birth_day': 0,  # TODO: Track
                    'generation': 1  # TODO: Track
                }

                death_story = self.story_generator.generate_death_story(
                    agent.name, agent.age, death_cause, current_day, legacy_context
                )
                self.story_feed.add_story(death_story)
                logger.info(f"💀 STORY: {death_story.title}")

                # ===== ACHIEVEMENTS - Final check =====
                # Update days survived for elder achievements
                if agent.id in self.achievement_tracker.agent_achievements:
                    self.achievement_tracker.update_agent_stat(agent.id, 'days_survived', agent.ticks_lived)
                    final_achievements = self.achievement_tracker.check_agent_achievements(agent.id, current_day)
                    for ach in final_achievements:
                        logger.info(f"🏆 {agent.name} earned posthumous achievement: {ach.name}")

                # Civilization achievement - FIRST DEATH
                first_death_ach = self.achievement_tracker.unlock_civilization_achievement(
                    AchievementType.FIRST_DEATH, current_day
                )
                if first_death_ach:
                    logger.info(f"🎆 CIVILIZATION: {first_death_ach.name}")

                # Remove from world (after delay)
                # In production, would archive agent data
                # For now, keep in list as dead

        # Check for civilization milestones
        self._check_civilization_milestones(current_tick)

    def _check_civilization_milestones(self, current_tick: int):
        """Check and record civilization milestones"""
        alive_agents = [a for a in self.world.agents if a.alive]
        population = len(alive_agents)
        total_buildings = len(self.dynamic_building_system.buildings)
        total_knowledge = len(self.knowledge_system.knowledge_records)

        # Population milestones
        pop_milestones = [10, 25, 50, 100, 200, 500]
        for milestone in pop_milestones:
            milestone_key = f"pop_{milestone}"
            if population >= milestone and milestone_key not in self.achieved_milestones:
                self.achieved_milestones.add(milestone_key)
                self.milestone_history.append({
                    "type": "population",
                    "milestone": f"{milestone} Synthetics",
                    "tick": current_tick,
                    "day": current_tick // 24,
                    "details": f"Population reached {population} living synthetics"
                })
                print(f"🎉 MILESTONE: Population reached {milestone}!")

        # Building milestones
        building_milestones = [1, 10, 50, 100, 250, 500]
        for milestone in building_milestones:
            milestone_key = f"buildings_{milestone}"
            if total_buildings >= milestone and milestone_key not in self.achieved_milestones:
                self.achieved_milestones.add(milestone_key)
                self.milestone_history.append({
                    "type": "buildings",
                    "milestone": f"{milestone} Buildings",
                    "tick": current_tick,
                    "day": current_tick // 24,
                    "details": f"Civilization has constructed {total_buildings} buildings"
                })
                print(f"🏗️  MILESTONE: {milestone} buildings constructed!")

        # Knowledge milestones
        knowledge_milestones = [10, 50, 100, 250, 500, 1000]
        for milestone in knowledge_milestones:
            milestone_key = f"knowledge_{milestone}"
            if total_knowledge >= milestone and milestone_key not in self.achieved_milestones:
                self.achieved_milestones.add(milestone_key)
                self.milestone_history.append({
                    "type": "knowledge",
                    "milestone": f"{milestone} Knowledge Records",
                    "tick": current_tick,
                    "day": current_tick // 24,
                    "details": f"Civilization has accumulated {total_knowledge} pieces of knowledge"
                })
                print(f"📚 MILESTONE: {milestone} knowledge records created!")

    def _update_population_history(self):
        """
        Track population changes over time for graphing.
        Records data once per day.
        """
        current_tick = self.world.time.current_tick
        current_day = self.world.time.day

        # Only record once per day (when day changes)
        if current_day > self.last_tracked_day:
            alive_count = sum(1 for a in self.world.agents if a.alive)

            # Record population snapshot for this day
            population_snapshot = {
                'day': current_day,
                'tick': current_tick,
                'alive': alive_count,
                'births': self.births_this_day,
                'deaths': self.deaths_this_day,
                'total_created': self.total_agents_created,
                'death_causes': self.death_causes.copy()
            }

            self.population_history.append(population_snapshot)

            # Log daily summary if there were births/deaths
            if self.births_this_day > 0 or self.deaths_this_day > 0:
                logger.info(
                    f"📊 Day {current_day}: Population={alive_count} "
                    f"(+{self.births_this_day} births, -{self.deaths_this_day} deaths)"
                )

            # Reset daily counters
            self.births_this_day = 0
            self.deaths_this_day = 0
            self.death_causes = {}
            self.last_tracked_day = current_day

    def get_population_statistics(self) -> Dict:
        """
        Get comprehensive population statistics for frontend display.
        """
        alive_agents = [a for a in self.world.agents if a.alive]
        alive_count = len(alive_agents)

        # Calculate age distribution
        age_groups = {
            '0-20': 0,
            '21-40': 0,
            '41-60': 0,
            '61-80': 0,
            '81-100': 0,
            '100+': 0
        }

        for agent in alive_agents:
            if agent.age <= 20:
                age_groups['0-20'] += 1
            elif agent.age <= 40:
                age_groups['21-40'] += 1
            elif agent.age <= 60:
                age_groups['41-60'] += 1
            elif agent.age <= 80:
                age_groups['61-80'] += 1
            elif agent.age <= 100:
                age_groups['81-100'] += 1
            else:
                age_groups['100+'] += 1

        # Calculate total deaths and causes
        all_death_causes = {}
        for snapshot in self.population_history:
            for cause, count in snapshot.get('death_causes', {}).items():
                all_death_causes[cause] = all_death_causes.get(cause, 0) + count

        return {
            'current_population': alive_count,
            'total_agents_created': self.total_agents_created,
            'total_deaths': self.total_agents_created - alive_count,
            'births_today': self.births_this_day,
            'deaths_today': self.deaths_this_day,
            'age_distribution': age_groups,
            'death_causes': all_death_causes,
            'history': self.population_history[-100:],  # Last 100 days
        }

    def get_state_snapshot(self) -> Dict:
        """Get complete world state snapshot"""
        # Get comprehensive economic stats (includes wealth, market, banking, taxation, trade, crises, etc.)
        economic_stats = self.economy.get_complete_statistics()

        return {
            'world': self.world.get_statistics(),
            'agents': [agent.to_dict() for agent in self.world.agents if agent.alive],
            # COMPLETE ECONOMIC SYSTEM - All financial subsystems!
            'economy': economic_stats.get('wealth', {}),  # Backward compatibility
            'market': economic_stats.get('market', {}),  # Backward compatibility
            'economic_system': economic_stats,  # NEW: Complete economic data
            'events': self.event_logger.get_statistics(),
            'recent_events': [e.to_dict() for e in self.event_logger.get_recent_events(20)],
            # OLD SYSTEMS DATA (kept for compatibility)
            'buildings': self.building_manager.get_statistics(),
            'innovations': self.innovation_manager.get_statistics(),
            'warfare': self.warfare_manager.get_statistics(),
            'governance': self.governance_manager.get_statistics(),
            'production': self.production_manager.get_statistics(),
            'strategy': self.strategy_manager.get_statistics(),
            # NEW AUTONOMOUS SYSTEMS
            'experimentation': self.experimentation_engine.get_statistics(),
            'dynamic_buildings': self.dynamic_building_system.get_statistics(),
            'knowledge': self.knowledge_system.get_statistics(),
            'consequences': self.consequence_engine.get_statistics(),
            'roles': self.role_emergence.get_statistics(),
            'tech_progression': self.tech_progression.get_statistics(),
            # CIVILIZATION PROGRESSION - Stone Age → Space Age!
            'civilization': self.civilization.get_stats(),
            # STORY ENGINE & ACHIEVEMENTS - Epic narratives and milestones!
            'stories': self.story_feed.to_dict(),
            'achievements': self.achievement_tracker.to_dict(),
            # META-PROGRESSION - AI Self-Improvement!
            'meta_progression': self.meta_progression.to_dict(),
            # POPULATION TRACKING - Births, deaths, demographics over time!
            'population': self.get_population_statistics(),
        }

    def stop(self):
        """Stop simulation"""
        self.running = False
        print("Simulation stopped")
